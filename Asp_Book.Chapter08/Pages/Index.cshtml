            <section class="mb-5">
                <h3>Использование на клиенте (JavaScript)</h3>
                <p>На клиенте нужно: сохранить оба токена, при 401 — автоматически обновить, при неудаче — перенаправить на логин.</p>

                <div class="code-block">
                    <pre><code>// 1. Вход — получаем оба токена
const loginResponse = await fetch('/api/Auth/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ username: 'user', password: 'pass' })
});
const { accessToken, refreshToken } = await loginResponse.json();

// 2. Обычный запрос с Access Token
async function apiRequest(url) {
    let response = await fetch(url, {
        headers: { 'Authorization': `Bearer ${accessToken}` }
    });

    // 3. Если 401 — пробуем обновить токен
    if (response.status === 401) {
        const refreshResponse = await fetch('/api/Auth/refresh', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ refreshToken })
        });

        if (refreshResponse.ok) {
            const tokens = await refreshResponse.json();
            accessToken = tokens.accessToken;
            refreshToken = tokens.refreshToken;

            // 4. Повторяем оригинальный запрос с новым токеном
            response = await fetch(url, {
                headers: { 'Authorization': `Bearer ${accessToken}` }
            });
        } else {
            // Refresh Token тоже невалиден — на логин
            window.location.href = '/login';
        }
    }

    return response;
}</code></pre>

            <section class="mb-5">
                <h3>3. Реализация сервиса</h3>
                <div class="code-block">
                    <pre><code>using System.Text;
using System.Text.Json;

namespace Asp_Book.Chapter03.Services;

public class UsersApiService : IUsersApiService
{
    private readonly IHttpClientFactory _httpClientFactory;
    private readonly ILogger&lt;UsersApiService&gt; _logger;

    public UsersApiService(IHttpClientFactory httpClientFactory, ILogger&lt;UsersApiService&gt; logger)
    {
        _httpClientFactory = httpClientFactory;
        _logger = logger;
    }

    /// &lt;summary&gt;
    /// Получить пользователя по ID
    /// &lt;/summary&gt;
    public async Task&lt;string&gt; GetUserAsync(int id)
    {
        var client = _httpClientFactory.CreateClient("UsersAPI");
        
        try
        {
            _logger.LogInformation("Запрос пользователя с ID: {UserId}", id);
            var response = await client.GetAsync($"users/{id}");
            response.EnsureSuccessStatusCode();
            
            var content = await response.Content.ReadAsStringAsync();
            _logger.LogInformation("Пользователь с ID {UserId} успешно получен", id);
            return content;
        }
        catch (HttpRequestException ex)
        {
            _logger.LogError(ex, "Ошибка при запросе пользователя с ID: {UserId}", id);
            throw;
        }
    }

    /// &lt;summary&gt;
    /// Получить посты пользователя по userId
    /// &lt;/summary&gt;
    public async Task&lt;string&gt; GetUserPostsAsync(int userId)
    {
        var client = _httpClientFactory.CreateClient("UsersAPI");
        
        try
        {
            _logger.LogInformation("Запрос постов пользователя с ID: {UserId}", userId);
            // Используем query параметр для фильтрации постов по userId
            var response = await client.GetAsync($"posts?userId={userId}");
            response.EnsureSuccessStatusCode();
            
            var content = await response.Content.ReadAsStringAsync();
            _logger.LogInformation("Получены посты пользователя с ID {UserId}", userId);
            return content;
        }
        catch (HttpRequestException ex)
        {
            _logger.LogError(ex, "Ошибка при запросе постов пользователя с ID: {UserId}", userId);
            throw;
        }
    }

    /// &lt;summary&gt;
    /// Создать комментарий к посту
    /// &lt;/summary&gt;
    public async Task&lt;string&gt; CreateCommentAsync(int postId, string name, string email, string body)
    {
        var client = _httpClientFactory.CreateClient("UsersAPI");
        
        try
        {
            // Создаем объект комментария
            var comment = new
            {
                postId = postId,
                name = name,
                email = email,
                body = body
            };

            // Сериализуем в JSON
            var json = JsonSerializer.Serialize(comment);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            _logger.LogInformation("Создание комментария для поста с ID: {PostId}", postId);
            var response = await client.PostAsync("comments", content);
            response.EnsureSuccessStatusCode();
            
            var responseContent = await response.Content.ReadAsStringAsync();
            _logger.LogInformation("Комментарий для поста {PostId} успешно создан", postId);
            return responseContent;
        }
        catch (HttpRequestException ex)
        {
            _logger.LogError(ex, "Ошибка при создании комментария для поста с ID: {PostId}", postId);
            throw;
        }
    }
}</code></pre>

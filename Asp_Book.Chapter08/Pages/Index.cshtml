            <section class="mb-5">
                <h3>AuthController — эндпоинты авторизации</h3>
                <p>Контроллер содержит три ключевых эндпоинта: <strong>login</strong>, <strong>refresh</strong> и <strong>revoke</strong>.</p>

                <h4>POST /api/auth/login — вход</h4>
                <div class="code-block">
                    <pre><code>[HttpPost("login")]
public async Task&lt;IActionResult&gt; Login([FromBody] LoginRequest request)
{
    // 1. Ищем пользователя по имени
    var user = await _userService.GetUserByUsernameAsync(request.Username);
    
    // 2. Проверяем пароль
    if (user == null || !_userService.VerifyPassword(request.Password, user.PasswordHash))
        return Unauthorized(new { message = "Неверные учетные данные" });

    // 3. Генерируем ОБА токена
    var accessToken = _tokenService.GenerateAccessToken(user);
    var refreshToken = _tokenService.GenerateRefreshToken();
    var refreshTokenExpires = DateTime.UtcNow.AddDays(7);

    // 4. Сохраняем Refresh Token в БД
    await _tokenService.SaveRefreshTokenAsync(user.Id, refreshToken, refreshTokenExpires);

    // 5. Возвращаем оба токена клиенту
    return Ok(new AuthResponse
    {
        AccessToken = accessToken,
        RefreshToken = refreshToken,
        Username = user.Username,
        Role = user.Role,
        AccessTokenExpires = DateTime.UtcNow.AddMinutes(15),
        RefreshTokenExpires = refreshTokenExpires
    });
}</code></pre>
                </div>

                <h4>POST /api/auth/refresh — обновление токенов</h4>
                <div class="code-block">
                    <pre><code>[HttpPost("refresh")]
public async Task&lt;IActionResult&gt; Refresh([FromBody] RefreshTokenRequest request)
{
    // 1. Проверяем: токен существует, не отозван, не просрочен
    if (!await _tokenService.IsRefreshTokenValidAsync(request.RefreshToken))
        return Unauthorized(new { message = "Недействительный refresh token" });

    // 2. Получаем данные токена (нужен UserId)
    var refreshToken = await _tokenService.GetRefreshTokenAsync(request.RefreshToken);
    var user = await _userService.GetUserByIdAsync(refreshToken!.UserId);
    if (user == null) return Unauthorized();

    // 3. ОТЗЫВАЕМ старый refresh token (ротация!)
    await _tokenService.RevokeRefreshTokenAsync(request.RefreshToken);

    // 4. Генерируем НОВУЮ пару токенов
    var newAccessToken = _tokenService.GenerateAccessToken(user);
    var newRefreshToken = _tokenService.GenerateRefreshToken();
    var newRefreshTokenExpires = DateTime.UtcNow.AddDays(7);

    // 5. Сохраняем новый Refresh Token
    await _tokenService.SaveRefreshTokenAsync(user.Id, newRefreshToken, newRefreshTokenExpires);

    return Ok(new AuthResponse
    {
        AccessToken = newAccessToken,
        RefreshToken = newRefreshToken,
        Username = user.Username,
        Role = user.Role,
        AccessTokenExpires = DateTime.UtcNow.AddMinutes(15),
        RefreshTokenExpires = newRefreshTokenExpires
    });
}</code></pre>
                    <div class="code-explanation">
                        <strong>Ротация токенов:</strong> При каждом обновлении старый Refresh Token отзывается и выдаётся новый. Это предотвращает повторное использование украденного токена.
                    </div>
                </div>

                <h4>POST /api/auth/revoke — отзыв токена</h4>
                <div class="code-block">
                    <pre><code>[HttpPost("revoke")]
public async Task&lt;IActionResult&gt; Revoke([FromBody] RefreshTokenRequest request)
{
    await _tokenService.RevokeRefreshTokenAsync(request.RefreshToken);
    return Ok(new { message = "Refresh token отозван" });
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>Настройка Program.cs</h3>
                <p>Полная настройка включает: In-Memory БД, JWT аутентификацию, регистрацию сервисов и Swagger с поддержкой Bearer.</p>

                <div class="code-block">
                    <pre><code>var builder = WebApplication.CreateBuilder(args);

// 1. Контроллеры и Razor Pages
builder.Services.AddControllers();
builder.Services.AddRazorPages();

// 2. In-Memory Database
builder.Services.AddDbContext&lt;ApplicationDbContext&gt;(options =>
    options.UseInMemoryDatabase("RefreshTokenDb"));

// 3. Регистрация сервисов в DI
builder.Services.AddScoped&lt;IUserService, UserService&gt;();
builder.Services.AddScoped&lt;ITokenService, TokenService&gt;();

// 4. JWT Authentication (как в главе 7)
var secretKey = builder.Configuration["Jwt:SecretKey"] 
    ?? "MySuperSecretKeyThatIsAtLeast32CharactersLong!";

builder.Services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme)
.AddJwtBearer(options =>
{
    options.TokenValidationParameters = new TokenValidationParameters
    {
        ValidateIssuerSigningKey = true,
        IssuerSigningKey = new SymmetricSecurityKey(
            Encoding.UTF8.GetBytes(secretKey)),
        ValidateIssuer = true,
        ValidIssuer = builder.Configuration["Jwt:Issuer"] ?? "AspBook",
        ValidateAudience = true,
        ValidAudience = builder.Configuration["Jwt:Audience"] ?? "AspBookUsers",
        ValidateLifetime = true,
        ClockSkew = TimeSpan.Zero
    };
});

builder.Services.AddAuthorization();

// 5. Swagger с JWT
builder.Services.AddSwaggerGen(c => { /* как в главе 7 */ });

var app = builder.Build();

app.UseAuthentication();  // Сначала аутентификация
app.UseAuthorization();   // Потом авторизация

app.MapControllers();
app.MapRazorPages();
app.Run();</code></pre>

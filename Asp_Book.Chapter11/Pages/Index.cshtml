            <h2>Теория</h2>

            <section class="mb-5">
                <h3>Зачем нужна авторизация в приложениях реального времени?</h3>
                <p>В предыдущих главах мы создали WebSocket (глава 9) и SignalR (глава 10) чаты, но они были <strong>полностью открытыми</strong> — кто угодно мог подключиться и отправлять сообщения. В реальных приложениях нужно:</p>
                <ul>
                    <li><strong>Знать, кто подключился</strong> — чтобы показывать имена, а не ID</li>
                    <li><strong>Ограничивать доступ</strong> — не все пользователи должны видеть все каналы</li>
                    <li><strong>Разграничивать права</strong> — администраторы имеют больше возможностей</li>
                    <li><strong>Защищать данные</strong> — конфиденциальные уведомления только для нужных пользователей</li>
                </ul>

                <div class="alert alert-info mt-3">
                    <strong>Основная идея:</strong> мы используем <strong>JWT токены</strong> (из главы 7) для авторизации подключений к SignalR Hub и WebSocket.
                </div>
            </section>

            <section class="mb-5">
                <h3>Проблема: как передать JWT в SignalR?</h3>
                <p>В обычных HTTP-запросах токен передаётся в заголовке <code>Authorization: Bearer {token}</code>. Но у SignalR и WebSocket есть <strong>проблема</strong>:</p>

                <div class="alert alert-danger">
                    <strong>Проблема:</strong> WebSocket API в браузере <strong>не позволяет</strong> устанавливать пользовательские заголовки (Authorization) при создании соединения!
                </div>

                <h4>Решение: передача токена через Query String</h4>
                <p>Токен передаётся как параметр URL:</p>
                <div class="code-block">
                    <pre><code>// Вместо заголовка Authorization:
// GET /chathub HTTP/1.1
// Authorization: Bearer eyJhbG...

// Передаём через query string:
// GET /chathub?access_token=eyJhbG...

// На клиенте (JavaScript):
const connection = new signalR.HubConnectionBuilder()
    .withUrl("/authorizedchathub", {
        accessTokenFactory: () => token  // SignalR автоматически добавит ?access_token=...
    })
    .build();</code></pre>
                    <div class="code-explanation">
                        <strong>accessTokenFactory</strong> — функция, которая возвращает токен. SignalR вызывает её перед каждым подключением и автоматически добавляет <code>?access_token=...</code> к URL.
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Настройка JWT для SignalR в Program.cs</h3>
                <p>Чтобы сервер мог прочитать токен из query string, нужно настроить <strong>событие</strong> <code>OnMessageReceived</code> в конфигурации JWT.</p>

                <div class="code-block">
                    <pre><code>// Program.cs
var secretKey = builder.Configuration["Jwt:SecretKey"] 
    ?? "MySuperSecretKeyThatIsAtLeast32CharactersLong!";
var issuer = builder.Configuration["Jwt:Issuer"] ?? "AspBook";
var audience = builder.Configuration["Jwt:Audience"] ?? "AspBookUsers";

builder.Services.AddAuthentication(options =>
{
    options.DefaultAuthenticateScheme = JwtBearerDefaults.AuthenticationScheme;
    options.DefaultChallengeScheme = JwtBearerDefaults.AuthenticationScheme;
})
.AddJwtBearer(options =>
{
    // Стандартная валидация токена (как в главе 7)
    options.TokenValidationParameters = new TokenValidationParameters
    {
        ValidateIssuerSigningKey = true,
        IssuerSigningKey = new SymmetricSecurityKey(
            Encoding.UTF8.GetBytes(secretKey)),
        ValidateIssuer = true,
        ValidIssuer = issuer,
        ValidateAudience = true,
        ValidAudience = audience,
        ValidateLifetime = true,
        ClockSkew = TimeSpan.Zero
    };

    // НОВОЕ: обработка токена из query string для SignalR
    options.Events = new JwtBearerEvents
    {
        OnMessageReceived = context =>
        {
            // 1. Читаем токен из query параметра
            var accessToken = context.Request.Query["access_token"];
            
            // 2. Проверяем, что запрос идёт к Hub
            var path = context.HttpContext.Request.Path;
            if (!string.IsNullOrEmpty(accessToken) 
                &amp;&amp; path.StartsWithSegments("/authorizedchathub"))
            {
                // 3. Устанавливаем токен — ASP.NET Core обработает его как обычный Bearer
                context.Token = accessToken;
            }
            return Task.CompletedTask;
        }
    };
});</code></pre>
                    <div class="code-explanation">
                        <strong>Что происходит по шагам:</strong>
                        <ol>
                            <li>Клиент подключается к <code>/authorizedchathub?access_token=eyJhbG...</code></li>
                            <li>ASP.NET Core вызывает событие <code>OnMessageReceived</code></li>
                            <li>Мы извлекаем токен из query string и устанавливаем <code>context.Token</code></li>
                            <li>ASP.NET Core валидирует токен как обычный Bearer token</li>
                            <li>Если токен валидный — <code>Context.User</code> в Hub заполняется данными из claims</li>
                        </ol>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Атрибут [Authorize] на SignalR Hub</h3>
                <p>Атрибут <code>[Authorize]</code> работает так же, как в контроллерах, но применяется к Hub.</p>

                <h4>1. Авторизация на уровне всего Hub</h4>
                <div class="code-block">
                    <pre><code>using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.SignalR;

[Authorize]  // ← Все методы Hub требуют авторизации
public class AuthorizedChatHub : Hub
{
    public async Task SendToAll(string message)
    {
        // Если пользователь не авторизован — сюда не попадёт
        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.All.SendAsync("ReceiveMessage", username, message);
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Что произойдет без токена:</strong> Клиент получит ошибку при попытке подключения — SignalR вернёт <strong>401 Unauthorized</strong> и соединение не будет установлено.
                    </div>
                </div>

                <h4>2. Авторизация на уровне метода</h4>
                <div class="code-block">
                    <pre><code>[Authorize]
public class ChatHub : Hub
{
    // Доступно всем авторизованным пользователям
    public async Task SendToAll(string message) { ... }

    // Доступно ТОЛЬКО пользователям с ролью "Admin"
    [Authorize(Roles = "Admin")]
    public async Task SendToAdmins(string message)
    {
        await Clients.Group("Admins").SendAsync("ReceiveAdminMessage", 
            Context.User?.Identity?.Name, message);
    }

    // Переопределение: разрешить без авторизации
    // (не работает, если [Authorize] на классе — Hub всё равно требует подключение с токеном)
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>Извлечение данных пользователя в Hub (Context.User)</h3>
                <p>После успешной авторизации, <strong>все claims из JWT</strong> доступны через <code>Context.User</code>.</p>

                <div class="code-block">
                    <pre><code>[Authorize]
public class AuthorizedChatHub : Hub
{
    public async Task SendToAll(string message)
    {
        // Извлекаем данные из JWT токена
        var username = Context.User?.Identity?.Name ?? "Unknown";
        var userId = Context.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var email = Context.User?.FindFirst(ClaimTypes.Email)?.Value;
        var role = Context.User?.FindFirst(ClaimTypes.Role)?.Value;
        var connectionId = Context.ConnectionId;

        await Clients.All.SendAsync("ReceiveMessage", username, message);
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Доступные свойства Context:</strong>
                        <table class="table table-striped table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Свойство</th>
                                    <th>Описание</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>Context.User</code></td>
                                    <td>Объект <code>ClaimsPrincipal</code> с данными из JWT</td>
                                </tr>
                                <tr>
                                    <td><code>Context.User?.Identity?.Name</code></td>
                                    <td>Имя пользователя (из <code>ClaimTypes.Name</code>)</td>
                                </tr>
                                <tr>
                                    <td><code>Context.User?.IsInRole("Admin")</code></td>
                                    <td>Проверка роли (из <code>ClaimTypes.Role</code>)</td>
                                </tr>
                                <tr>
                                    <td><code>Context.ConnectionId</code></td>
                                    <td>Уникальный ID SignalR-соединения</td>
                                </tr>
                                <tr>
                                    <td><code>Context.GetHttpContext()</code></td>
                                    <td>Доступ к HTTP-контексту (заголовки, cookies)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Группы и роли с авторизацией</h3>
                <p>С авторизацией мы можем <strong>автоматически</strong> добавлять пользователей в группы по ролям при подключении.</p>

                <div class="code-block">
                    <pre><code>[Authorize]
public class AuthorizedChatHub : Hub
{
    // При подключении — добавляем в группу по роли
    public override async Task OnConnectedAsync()
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";
        var role = Context.User?.FindFirst(ClaimTypes.Role)?.Value;

        // Автоматическое добавление в группу по роли
        if (Context.User?.IsInRole("Admin") == true)
        {
            await Groups.AddToGroupAsync(Context.ConnectionId, "Admins");
        }

        // Уведомляем всех
        await Clients.All.SendAsync("UserConnected", username);
        await base.OnConnectedAsync();
    }

    // При отключении — убираем из группы
    public override async Task OnDisconnectedAsync(Exception? exception)
    {
        if (Context.User?.IsInRole("Admin") == true)
        {
            await Groups.RemoveFromGroupAsync(Context.ConnectionId, "Admins");
        }

        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.All.SendAsync("UserDisconnected", username);
        await base.OnDisconnectedAsync(exception);
    }

    // Метод только для администраторов
    [Authorize(Roles = "Admin")]
    public async Task SendToAdmins(string message)
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.Group("Admins").SendAsync("ReceiveAdminMessage", username, message);
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>Авторизация WebSocket с Middleware</h3>
                <p>Для чистых WebSocket (без SignalR) авторизацию реализуем в <strong>middleware</strong>.</p>

                <div class="code-block">
                    <pre><code>public class AuthorizedWebSocketMiddleware
{
    private readonly RequestDelegate _next;
    private static readonly Dictionary&lt;string, WebSocket&gt; _connections = new();
    private static readonly Dictionary&lt;string, string&gt; _userConnections = new();

    public AuthorizedWebSocketMiddleware(RequestDelegate next)
    {
        _next = next;
    }

    public async Task InvokeAsync(HttpContext context)
    {
        if (context.WebSockets.IsWebSocketRequest)
        {
            // 1. Получаем токен из query string
            var token = context.Request.Query["access_token"].ToString();
            
            // 2. Если токена нет — отказ
            if (string.IsNullOrEmpty(token))
            {
                context.Response.StatusCode = 401;
                return;
            }

            // 3. Проверяем, авторизован ли пользователь
            //    (если JWT middleware уже обработал токен)
            if (context.User?.Identity?.IsAuthenticated != true)
            {
                context.Response.StatusCode = 401;
                return;
            }

            // 4. Принимаем соединение
            var webSocket = await context.WebSockets.AcceptWebSocketAsync();
            var connectionId = Guid.NewGuid().ToString();
            var username = context.User?.Identity?.Name ?? "Unknown";
            
            _connections[connectionId] = webSocket;
            _userConnections[connectionId] = username;

            await HandleWebSocket(webSocket, connectionId, username);
        }
        else
        {
            await _next(context);
        }
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Отличие от обычного WebSocket middleware:</strong>
                        <ul>
                            <li>Проверяем наличие <code>access_token</code> в query string</li>
                            <li>Проверяем, что пользователь авторизован (<code>IsAuthenticated</code>)</li>
                            <li>Если нет — возвращаем <strong>401</strong> и не принимаем соединение</li>
                            <li>Сохраняем имя пользователя из claims</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Клиентский код с передачей токена</h3>

                <h4>SignalR с JWT токеном:</h4>
                <div class="code-block">
                    <pre><code>// Получаем токен (из localStorage, cookie, или после логина)
const token = localStorage.getItem('accessToken');

// Создаём соединение с передачей токена
const connection = new signalR.HubConnectionBuilder()
    .withUrl("/authorizedchathub", {
        accessTokenFactory: () => token
        // SignalR добавит ?access_token=eyJhbG... к URL
    })
    .build();

// Обработка событий
connection.on("ReceiveMessage", (user, message) => {
    console.log(`${user}: ${message}`);
});

// Подключение
connection.start()
    .then(() => console.log('Авторизованное подключение установлено'))
    .catch(err => {
        if (err.message &amp;&amp; err.message.includes('401')) {
            console.error('Токен невалиден или отсутствует');
            // Перенаправить на логин
        }
    });</code></pre>
                </div>

                <h4>WebSocket с JWT токеном:</h4>
                <div class="code-block">
                    <pre><code>const token = localStorage.getItem('accessToken');
const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';

// Передаём токен через query string
const ws = new WebSocket(
    `${protocol}//${window.location.host}/ws?access_token=${token}`
);

ws.onopen = () => console.log('Авторизованный WebSocket подключен');
ws.onerror = () => console.error('Ошибка (возможно, 401)');</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>Регистрация в Program.cs (полная настройка)</h3>
                <p>Полная конфигурация <code>Program.cs</code> для авторизации SignalR и WebSocket:</p>

                <div class="code-block">
                    <pre><code>using Asp_Book.Chapter11.Hubs;
using Asp_Book.Chapter11.Middleware;
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.IdentityModel.Tokens;
using System.Text;

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddControllers();
builder.Services.AddRazorPages();

// 1. SignalR
builder.Services.AddSignalR();

// 2. JWT Authentication
var secretKey = builder.Configuration["Jwt:SecretKey"] 
    ?? "MySuperSecretKeyThatIsAtLeast32CharactersLong!";

builder.Services.AddAuthentication(options =>
{
    options.DefaultAuthenticateScheme = JwtBearerDefaults.AuthenticationScheme;
    options.DefaultChallengeScheme = JwtBearerDefaults.AuthenticationScheme;
})
.AddJwtBearer(options =>
{
    options.TokenValidationParameters = new TokenValidationParameters
    {
        ValidateIssuerSigningKey = true,
        IssuerSigningKey = new SymmetricSecurityKey(
            Encoding.UTF8.GetBytes(secretKey)),
        ValidateIssuer = true,
        ValidIssuer = builder.Configuration["Jwt:Issuer"] ?? "AspBook",
        ValidateAudience = true,
        ValidAudience = builder.Configuration["Jwt:Audience"] ?? "AspBookUsers",
        ValidateLifetime = true,
        ClockSkew = TimeSpan.Zero
    };

    // Чтение токена из query string для SignalR
    options.Events = new JwtBearerEvents
    {
        OnMessageReceived = context =>
        {
            var accessToken = context.Request.Query["access_token"];
            var path = context.HttpContext.Request.Path;
            if (!string.IsNullOrEmpty(accessToken) 
                &amp;&amp; path.StartsWithSegments("/authorizedchathub"))
            {
                context.Token = accessToken;
            }
            return Task.CompletedTask;
        }
    };
});

builder.Services.AddAuthorization();

var app = builder.Build();

app.UseStaticFiles();
app.UseRouting();

app.UseAuthentication();  // Сначала аутентификация
app.UseAuthorization();   // Потом авторизация

// WebSocket с авторизацией
app.UseWebSockets();
app.UseMiddleware&lt;AuthorizedWebSocketMiddleware&gt;();

app.MapRazorPages();
app.MapControllers();

// SignalR Hub с авторизацией
app.MapHub&lt;AuthorizedChatHub&gt;("/authorizedchathub");

app.Run();</code></pre>
                    <div class="code-explanation">
                        <strong>Порядок middleware критически важен:</strong>
                        <ol>
                            <li><code>UseAuthentication()</code> — должен быть <strong>до</strong> <code>UseAuthorization()</code></li>
                            <li><code>UseAuthorization()</code> — должен быть <strong>до</strong> маппинга Hub</li>
                            <li><code>UseWebSockets()</code> — должен быть <strong>до</strong> WebSocket middleware</li>
                            <li><code>MapHub</code> — маппинг после всех middleware</li>
                        </ol>
                    </div>
                </div>
            </section>


@page
@model IndexModel
@{
    ViewData["Title"] = "Глава 9: WebSockets";
}

<div class="container-fluid">
    <h1 class="mb-4">Глава 9: WebSockets</h1>

    <ul class="nav nav-tabs mb-4" id="chapterTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="theory-tab" data-bs-toggle="tab" data-bs-target="#theory" type="button" role="tab">
                Теория и Демонстрация
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="answers-tab" data-bs-toggle="tab" data-bs-target="#answers" type="button" role="tab">
                Ответы
            </button>
        </li>
    </ul>

    <div class="tab-content" id="chapterTabsContent">
        <div class="tab-pane fade show active" id="theory" role="tabpanel">
            <h2>Теория</h2>

            <section class="mb-5">
                <h3>Что такое WebSockets?</h3>
                <p><strong>WebSocket</strong> — протокол связи, обеспечивающий полнодуплексную (двустороннюю) связь между клиентом и сервером через одно TCP-соединение.</p>
                
                <h4>Преимущества WebSockets:</h4>
                <ul>
                    <li><strong>Двусторонняя связь:</strong> Сервер может отправлять данные клиенту без запроса</li>
                    <li><strong>Низкая задержка:</strong> Нет накладных расходов HTTP заголовков</li>
                    <li><strong>Постоянное соединение:</strong> Соединение остается открытым</li>
                    <li><strong>Реальное время:</strong> Идеально для чатов, уведомлений, игр</li>
                </ul>
            </section>

            <section class="mb-5">
                <h3>Демонстрация: WebSocket чат</h3>
                <p>Попробуйте подключиться к WebSocket и обмениваться сообщениями в реальном времени:</p>

                <div class="card mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">WebSocket чат</h5>
                        <span id="connectionStatus" class="badge bg-secondary">Отключен</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <input type="text" id="userNameInput" class="form-control" placeholder="Введите ваше имя" />
                        </div>
                        <div class="mb-3">
                            <button class="btn btn-success" id="connectBtn">Подключиться</button>
                            <button class="btn btn-danger" id="disconnectBtn" disabled>Отключиться</button>
                        </div>
                        <div class="mb-3">
                            <div id="messagesArea" class="border rounded p-3" style="height: 300px; overflow-y: auto; background-color: #f8f9fa;">
                                <p class="text-muted text-center">Сообщения будут отображаться здесь</p>
                            </div>
                        </div>
                        <div class="input-group">
                            <input type="text" id="messageInput" class="form-control" placeholder="Введите сообщение..." disabled />
                            <button class="btn btn-primary" id="sendBtn" disabled>Отправить</button>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-3">
                    <strong>Инструкция:</strong>
                    <ol>
                        <li>Введите ваше имя</li>
                        <li>Нажмите "Подключиться" для установления WebSocket соединения</li>
                        <li>Отправляйте сообщения - они будут видны всем подключенным пользователям</li>
                        <li>Откройте эту страницу в нескольких вкладках для демонстрации работы с несколькими клиентами</li>
                    </ol>
                </div>
            </section>

            <section class="mb-5">
                <h3>Задача: Реализовать WebSocket</h3>
                <div class="alert alert-warning">
                    <h5>Ваша задача:</h5>
                    <p>Изучите реализацию WebSocket в проекте:</p>
                    <ul>
                        <li>Как создать WebSocket middleware?</li>
                        <li>Как отправлять сообщения всем подключенным клиентам?</li>
                        <li>Как отправлять сообщение конкретному клиенту?</li>
                    </ul>
                </div>
            </section>
        </div>

        <div class="tab-pane fade" id="answers" role="tabpanel">
            <h2>Решение: Реализация WebSocket</h2>

            <section class="mb-5">
                <h3>1. WebSocket Middleware</h3>
                <div class="code-block">
                    <pre><code>public class WebSocketMiddleware
{
    private readonly RequestDelegate _next;
    private static readonly Dictionary&lt;string, WebSocket&gt; _connections = new();

    public WebSocketMiddleware(RequestDelegate next)
    {
        _next = next;
    }

    public async Task InvokeAsync(HttpContext context)
    {
        if (context.WebSockets.IsWebSocketRequest)
        {
            var webSocket = await context.WebSockets.AcceptWebSocketAsync();
            var connectionId = Guid.NewGuid().ToString();
            _connections[connectionId] = webSocket;

            await HandleWebSocket(webSocket, connectionId);
        }
        else
        {
            await _next(context);
        }
    }

    private async Task HandleWebSocket(WebSocket webSocket, string connectionId)
    {
        var buffer = new byte[1024 * 4];

        while (webSocket.State == WebSocketState.Open)
        {
            var result = await webSocket.ReceiveAsync(
                new ArraySegment&lt;byte&gt;(buffer), CancellationToken.None);

            if (result.MessageType == WebSocketMessageType.Text)
            {
                var message = Encoding.UTF8.GetString(buffer, 0, result.Count);
                await BroadcastMessageAsync($"{connectionId}: {message}");
            }
        }
    }

    private async Task BroadcastMessageAsync(string message)
    {
        var messageBytes = Encoding.UTF8.GetBytes(message);
        var tasks = _connections.Values
            .Where(ws => ws.State == WebSocketState.Open)
            .Select(ws => ws.SendAsync(
                new ArraySegment&lt;byte&gt;(messageBytes),
                WebSocketMessageType.Text,
                true,
                CancellationToken.None));

        await Task.WhenAll(tasks);
    }

    public static async Task SendToConnectionAsync(string connectionId, string message)
    {
        if (_connections.TryGetValue(connectionId, out var webSocket) 
            && webSocket.State == WebSocketState.Open)
        {
            var messageBytes = Encoding.UTF8.GetBytes(message);
            await webSocket.SendAsync(
                new ArraySegment&lt;byte&gt;(messageBytes),
                WebSocketMessageType.Text,
                true,
                CancellationToken.None);
        }
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>2. Настройка в Program.cs</h3>
                <div class="code-block">
                    <pre><code>var app = builder.Build();

// WebSocket middleware должен быть до UseAuthorization
app.UseWebSockets();
app.UseMiddleware&lt;WebSocketMiddleware&gt;();

app.UseAuthorization();</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>3. Клиентский код (JavaScript)</h3>
                <div class="code-block">
                    <pre><code>// Подключение к WebSocket
const ws = new WebSocket('ws://localhost:5009/ws');

ws.onopen = () => {
    console.log('WebSocket подключен');
    ws.send('Привет, сервер!');
};

ws.onmessage = (event) => {
    console.log('Получено сообщение:', event.data);
    document.getElementById('messages').innerHTML += 
        '&lt;div&gt;' + event.data + '&lt;/div&gt;';
};

ws.onerror = (error) => {
    console.error('WebSocket ошибка:', error);
};

ws.onclose = () => {
    console.log('WebSocket отключен');
};

// Отправка сообщения
function sendMessage() {
    const message = document.getElementById('messageInput').value;
    ws.send(message);
}</code></pre>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var triggerTabList = [].slice.call(document.querySelectorAll('#chapterTabs button'))
        triggerTabList.forEach(function (triggerEl) {
            var tabTrigger = new bootstrap.Tab(triggerEl)
        })

        let ws = null;
        let userName = '';

        // Определение WebSocket URL
        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const wsUrl = `${protocol}//${window.location.host}/ws`;

        // Подключение
        document.getElementById('connectBtn').addEventListener('click', () => {
            userName = document.getElementById('userNameInput').value.trim();
            if (!userName) {
                alert('Введите ваше имя');
                return;
            }

            try {
                ws = new WebSocket(wsUrl);

                ws.onopen = () => {
                    updateConnectionStatus(true);
                    document.getElementById('connectBtn').disabled = true;
                    document.getElementById('disconnectBtn').disabled = false;
                    document.getElementById('messageInput').disabled = false;
                    document.getElementById('sendBtn').disabled = false;
                    document.getElementById('userNameInput').disabled = true;
                    addMessage('Система', 'Подключено к WebSocket', 'success');
                };

                ws.onmessage = (event) => {
                    const data = event.data;
                    // Формат сообщения: "connectionId: message"
                    const parts = data.split(':');
                    if (parts.length >= 2) {
                        const connectionId = parts[0].trim();
                        const message = parts.slice(1).join(':').trim();
                        addMessage(`ID: ${connectionId.substring(0, 8)}`, message, 'info');
                    } else {
                        addMessage('Система', data, 'info');
                    }
                };

                ws.onerror = (error) => {
                    console.error('WebSocket error:', error);
                    addMessage('Система', 'Ошибка WebSocket соединения', 'danger');
                };

                ws.onclose = () => {
                    updateConnectionStatus(false);
                    document.getElementById('connectBtn').disabled = false;
                    document.getElementById('disconnectBtn').disabled = true;
                    document.getElementById('messageInput').disabled = true;
                    document.getElementById('sendBtn').disabled = true;
                    document.getElementById('userNameInput').disabled = false;
                    addMessage('Система', 'Отключено от WebSocket', 'warning');
                };
            } catch (error) {
                alert('Ошибка подключения: ' + error.message);
            }
        });

        // Отключение
        document.getElementById('disconnectBtn').addEventListener('click', () => {
            if (ws) {
                ws.close();
                ws = null;
            }
        });

        // Отправка сообщения
        document.getElementById('sendBtn').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            
            if (!message || !ws || ws.readyState !== WebSocket.OPEN) {
                return;
            }

            ws.send(`${userName}: ${message}`);
            addMessage('Вы', message, 'primary');
            messageInput.value = '';
        }

        function addMessage(sender, message, type) {
            const messagesArea = document.getElementById('messagesArea');
            const messageDiv = document.createElement('div');
            messageDiv.className = `mb-2 p-2 rounded bg-${type === 'success' ? 'success' : type === 'danger' ? 'danger' : type === 'warning' ? 'warning' : type === 'primary' ? 'primary' : 'light'} text-${type === 'success' || type === 'danger' || type === 'warning' || type === 'primary' ? 'white' : 'dark'}`;
            messageDiv.innerHTML = `<strong>${sender}:</strong> ${message}`;
            messagesArea.appendChild(messageDiv);
            messagesArea.scrollTop = messagesArea.scrollHeight;

            // Удаляем начальное сообщение если оно есть
            const initialMsg = messagesArea.querySelector('p.text-muted');
            if (initialMsg) {
                initialMsg.remove();
            }
        }

        function updateConnectionStatus(connected) {
            const statusBadge = document.getElementById('connectionStatus');
            if (connected) {
                statusBadge.textContent = 'Подключен';
                statusBadge.className = 'badge bg-success';
            } else {
                statusBadge.textContent = 'Отключен';
                statusBadge.className = 'badge bg-secondary';
            }
        }
    </script>
}

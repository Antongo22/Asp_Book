            <section class="mb-5">
                <h3>2. Hubs/AuthorizedChatHub.cs</h3>
                <div class="code-block">
                    <pre><code>using System.Security.Claims;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.SignalR;

namespace Asp_Book.Chapter11.Hubs;

[Authorize]  // Требует JWT для подключения
public class AuthorizedChatHub : Hub
{
    // Отправка сообщения ВСЕМ авторизованным пользователям
    public async Task SendToAll(string message)
    {
        // Извлекаем имя пользователя из JWT claims
        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.All.SendAsync("ReceiveMessage", username, message);
    }

    // Отправка сообщения КОНКРЕТНОМУ пользователю
    public async Task SendToUser(string targetUser, string message)
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.User(targetUser).SendAsync("ReceiveMessage", username, message);
    }

    // Отправка ТОЛЬКО администраторам
    [Authorize(Roles = "Admin")]
    public async Task SendToAdmins(string message)
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.Group("Admins").SendAsync("ReceiveAdminMessage", username, message);
    }

    // При подключении — добавляем Admin в группу "Admins"
    public override async Task OnConnectedAsync()
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";

        // Автоматическое добавление в группу по роли
        if (Context.User?.IsInRole("Admin") == true)
        {
            await Groups.AddToGroupAsync(Context.ConnectionId, "Admins");
        }

        // Уведомляем всех о подключении (с именем, а не ID!)
        await Clients.All.SendAsync("UserConnected", username);
        await base.OnConnectedAsync();
    }

    // При отключении — убираем из группы
    public override async Task OnDisconnectedAsync(Exception? exception)
    {
        if (Context.User?.IsInRole("Admin") == true)
        {
            await Groups.RemoveFromGroupAsync(Context.ConnectionId, "Admins");
        }

        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.All.SendAsync("UserDisconnected", username);
        await base.OnDisconnectedAsync(exception);
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Ключевые моменты:</strong>
                        <ul>
                            <li><code>[Authorize]</code> на классе — подключение без JWT невозможно</li>
                            <li><code>[Authorize(Roles = "Admin")]</code> на методе — дополнительная проверка роли</li>
                            <li><code>Context.User?.Identity?.Name</code> — имя из JWT claim <code>ClaimTypes.Name</code></li>
                            <li><code>Context.User?.IsInRole("Admin")</code> — проверка роли из claim <code>ClaimTypes.Role</code></li>
                            <li><code>Groups.AddToGroupAsync</code> — добавление в группу SignalR для массовой рассылки</li>
                        </ul>

        // Assert — проверяем, что сообщение реально в базе
        var savedMessage = await context.Messages.FindAsync(message.Id);
        Assert.NotNull(savedMessage);
        Assert.Equal("Тест БД", savedMessage!.Text);
        Assert.Equal("User1", savedMessage.Sender);
    }


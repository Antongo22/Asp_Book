@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script>
        var triggerTabList = [].slice.call(document.querySelectorAll('#chapterTabs button'))
        triggerTabList.forEach(function (triggerEl) {
            var tabTrigger = new bootstrap.Tab(triggerEl)
        })

        const TOKEN_STORAGE_KEY = 'chapter11_jwt_token';
        let connection = null;
        let currentToken = null;
        let currentUsername = '';

        // Сохранение токена
        document.getElementById('tokenForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const token = document.getElementById('jwtTokenInput').value.trim();
            if (!token) {
                addMessage('Система', 'Вставьте JWT токен', 'warning');
                return;
            }

            const payload = parseJwtPayload(token);
            if (!payload) {
                addMessage('Система', 'Некорректный JWT токен', 'danger');
                return;
            }

            currentToken = token;
            currentUsername = payload.unique_name || payload.name || payload.sub || payload.email || 'Пользователь';
            localStorage.setItem(TOKEN_STORAGE_KEY, currentToken);

            document.getElementById('currentUser').textContent = currentUsername;
            document.getElementById('connectBtn').disabled = false;
            document.getElementById('logoutBtn').disabled = false;
            document.getElementById('tokenForm').querySelector('button').textContent = 'Обновить токен';
            addMessage('Система', 'Токен сохранен. Теперь можно подключиться к чату.', 'success');
        });

        // Выход
        document.getElementById('logoutBtn').addEventListener('click', () => {
            if (connection) {
                connection.stop();
                connection = null;
            }
            currentToken = null;
            currentUsername = '';
            localStorage.removeItem(TOKEN_STORAGE_KEY);
            document.getElementById('currentUser').textContent = '-';
            document.getElementById('connectBtn').disabled = true;
            document.getElementById('disconnectBtn').disabled = true;
            document.getElementById('sendBtn').disabled = true;
            document.getElementById('messageInput').disabled = true;
            document.getElementById('logoutBtn').disabled = true;
            document.getElementById('tokenForm').querySelector('button').textContent = 'Сохранить токен';
            document.getElementById('tokenForm').reset();
            updateConnectionStatus(false);
            addMessage('Система', 'Выход выполнен', 'warning');
        });

        // Проверка сохраненного токена
        const savedToken = localStorage.getItem(TOKEN_STORAGE_KEY);
        if (savedToken) {
            const payload = parseJwtPayload(savedToken);
            if (payload) {
                currentToken = savedToken;
                currentUsername = payload.unique_name || payload.name || payload.sub || payload.email || 'Пользователь';
                document.getElementById('jwtTokenInput').value = savedToken;
                document.getElementById('currentUser').textContent = currentUsername;
                document.getElementById('connectBtn').disabled = false;
                document.getElementById('logoutBtn').disabled = false;
                document.getElementById('tokenForm').querySelector('button').textContent = 'Обновить токен';
            } else {
                localStorage.removeItem(TOKEN_STORAGE_KEY);
            }
        }

        // Подключение к SignalR
        document.getElementById('connectBtn').addEventListener('click', () => {
            if (!currentToken) {
                addMessage('Система', 'Сначала сохраните JWT токен', 'warning');
                return;
            }

            connection = new signalR.HubConnectionBuilder()
                .withUrl("/authorizedchathub", {
                    accessTokenFactory: () => currentToken
                })
                .build();

            // Обработка сообщений
            connection.on("ReceiveMessage", (user, message) => {
                addMessage(user, message, 'info');
            });

            connection.on("ReceiveAdminMessage", (user, message) => {
                addMessage(`[ADMIN] ${user}`, message, 'danger');
            });

            connection.on("UserConnected", (username) => {
                addMessage('Система', `${username} подключился`, 'success');
            });

            connection.on("UserDisconnected", (username) => {
                addMessage('Система', `${username} отключился`, 'warning');
            });

            // Подключение
            connection.start()
                .then(() => {
                    const connectionId = connection.connectionId;
                    document.getElementById('connectionId').textContent = connectionId ? connectionId.substring(0, 8) + '...' : '-';
                    updateConnectionStatus(true);
                    document.getElementById('connectBtn').disabled = true;
                    document.getElementById('disconnectBtn').disabled = false;
                    document.getElementById('messageInput').disabled = false;
                    document.getElementById('sendBtn').disabled = false;
                    addMessage('Система', 'Подключено к авторизованному чату', 'success');
                })
                .catch(err => {
                    console.error('SignalR connection error:', err);
                    if (err.message && err.message.includes('401')) {
                        addMessage('Система', 'Ошибка авторизации. Токен недействителен. Войдите снова.', 'danger');
                        document.getElementById('logoutBtn').click();
                    } else {
                        addMessage('Система', 'Ошибка подключения: ' + err, 'danger');
                    }
                });
        });

        // Отключение
        document.getElementById('disconnectBtn').addEventListener('click', () => {
            if (connection) {
                connection.stop();
                connection = null;
                updateConnectionStatus(false);
                document.getElementById('connectBtn').disabled = false;
                document.getElementById('disconnectBtn').disabled = true;
                document.getElementById('sendBtn').disabled = true;
                document.getElementById('messageInput').disabled = true;
                document.getElementById('connectionId').textContent = '-';
                addMessage('Система', 'Отключено от чата', 'warning');
            }
        });

        // Отправка сообщения
        document.getElementById('sendBtn').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            
            if (!message || !connection) {
                return;
            }

            connection.invoke("SendToAll", message)
                .catch(err => {
                    console.error('SendToAll error:', err);
                    addMessage('Система', 'Ошибка отправки: ' + err, 'danger');
                });
            
            messageInput.value = '';
        }

        function addMessage(sender, message, type) {
            const messagesArea = document.getElementById('messagesArea');
            const messageDiv = document.createElement('div');
            messageDiv.className = `mb-2 p-2 rounded bg-${type === 'success' ? 'success' : type === 'danger' ? 'danger' : type === 'warning' ? 'warning' : type === 'info' ? 'info' : 'light'} text-${type === 'success' || type === 'danger' || type === 'warning' || type === 'info' ? 'white' : 'dark'}`;
            messageDiv.innerHTML = `<strong>${sender}:</strong> ${message}`;
            messagesArea.appendChild(messageDiv);
            messagesArea.scrollTop = messagesArea.scrollHeight;

            // Удаляем начальное сообщение если оно есть
            const initialMsg = messagesArea.querySelector('p.text-muted');
            if (initialMsg) {
                initialMsg.remove();
            }
        }

        function updateConnectionStatus(connected) {
            const statusBadge = document.getElementById('connectionStatus');
            if (connected) {
                statusBadge.textContent = 'Подключен';
                statusBadge.className = 'badge bg-success';
            } else {
                statusBadge.textContent = 'Отключен';
                statusBadge.className = 'badge bg-secondary';
            }
        }

        function parseJwtPayload(token) {
            const parts = token.split('.');
            if (parts.length !== 3) {
                return null;
            }

            try {
                const payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');
                const padded = payload.padEnd(Math.ceil(payload.length / 4) * 4, '=');
                return JSON.parse(atob(padded));
            } catch {
                return null;
            }
        }
    </script>
}

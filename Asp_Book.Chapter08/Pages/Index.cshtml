@page
@model IndexModel
@{
    ViewData["Title"] = "Глава 8: Refresh Token";
}

<div class="container-fluid">
    <h1 class="mb-4">Глава 8: Refresh Token</h1>

    <ul class="nav nav-tabs mb-4" id="chapterTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="theory-tab" data-bs-toggle="tab" data-bs-target="#theory" type="button" role="tab">
                Теория и Демонстрация
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="answers-tab" data-bs-toggle="tab" data-bs-target="#answers" type="button" role="tab">
                Ответы
            </button>
        </li>
    </ul>

    <div class="tab-content" id="chapterTabsContent">
        <div class="tab-pane fade show active" id="theory" role="tabpanel">
            <h2>Теория</h2>

            <section class="mb-5">
                <h3>Что такое Refresh Token?</h3>
                <p><strong>Refresh Token</strong> — это долгоживущий токен, который используется для получения новых Access Token без повторного ввода учетных данных.</p>
                
                <h4>Проблема без Refresh Token:</h4>
                <ul>
                    <li>Access Token имеет короткий срок жизни (15-30 минут) для безопасности</li>
                    <li>Когда токен истекает, пользователю нужно снова вводить логин и пароль</li>
                    <li>Плохой пользовательский опыт</li>
                </ul>

                <h4>Решение с Refresh Token:</h4>
                <ul>
                    <li>Access Token — короткоживущий (15 минут) для доступа к ресурсам</li>
                    <li>Refresh Token — долгоживущий (7-30 дней) для обновления Access Token</li>
                    <li>При истечении Access Token клиент использует Refresh Token для получения нового</li>
                    <li>Пользователь не вводит пароль повторно</li>
                </ul>
            </section>

            <section class="mb-5">
                <h3>Как работает Refresh Token</h3>
                <ol>
                    <li><strong>Вход:</strong> Пользователь вводит логин и пароль</li>
                    <li><strong>Получение токенов:</strong> Сервер возвращает Access Token и Refresh Token</li>
                    <li><strong>Использование Access Token:</strong> Клиент использует Access Token для запросов</li>
                    <li><strong>Истечение Access Token:</strong> Когда Access Token истекает, сервер возвращает 401</li>
                    <li><strong>Обновление:</strong> Клиент отправляет Refresh Token на эндпоинт /refresh</li>
                    <li><strong>Новые токены:</strong> Сервер проверяет Refresh Token и выдает новые Access и Refresh токены</li>
                    <li><strong>Отзыв старого:</strong> Старый Refresh Token отзывается (revoked)</li>
                </ol>
            </section>

            <section class="mb-5">
                <h3>Безопасность Refresh Token</h3>
                <ul>
                    <li><strong>Хранение в БД:</strong> Refresh Token хранится в базе данных для возможности отзыва</li>
                    <li><strong>Отзыв токенов:</strong> При выходе или подозрительной активности токен можно отозвать</li>
                    <li><strong>Ротация токенов:</strong> При каждом обновлении выдается новый Refresh Token</li>
                    <li><strong>Проверка валидности:</strong> Проверяется срок действия и статус отзыва</li>
                </ul>
            </section>

            <section class="mb-5">
                <h3>Демонстрация: Refresh Token</h3>
                <p>Попробуйте войти, получить токены и обновить Access Token:</p>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Вход</h5>
                            </div>
                            <div class="card-body">
                                <form id="loginForm">
                                    <div class="mb-3">
                                        <input type="text" id="loginUsername" class="form-control" placeholder="Имя пользователя" required />
                                    </div>
                                    <div class="mb-3">
                                        <input type="password" id="loginPassword" class="form-control" placeholder="Пароль" required />
                                    </div>
                                    <button type="submit" class="btn btn-success w-100">Войти</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Токены</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">Access Token:</label>
                                    <textarea id="accessTokenDisplay" class="form-control form-control-sm" rows="2" readonly></textarea>
                                    <div class="mt-1">
                                        <small class="text-muted">Истекает через: <span id="accessTokenTimer" class="fw-bold">--:--</span></small>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Refresh Token:</label>
                                    <textarea id="refreshTokenDisplay" class="form-control form-control-sm" rows="2" readonly></textarea>
                                    <div class="mt-1">
                                        <small class="text-muted">Истекает через: <span id="refreshTokenTimer" class="fw-bold">--:--</span></small>
                                    </div>
                                </div>
                                <button class="btn btn-primary w-100" id="refreshTokenBtn" disabled>Обновить Access Token</button>
                                <div id="tokenStatus" class="mt-2"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="mb-0">Тестирование защищенного API</h5>
                    </div>
                    <div class="card-body">
                        <button class="btn btn-info" id="testApiBtn" disabled>Тестировать защищенный API</button>
                        <div id="apiResult" class="mt-3"></div>
                    </div>
                </div>

                <div class="alert alert-info mt-3">
                    <strong>Инструкция:</strong>
                    <ol>
                        <li>Войдите с учетными данными (username: admin, password: admin123 или зарегистрируйте нового пользователя)</li>
                        <li>После входа вы получите Access Token (действителен 15 минут) и Refresh Token (действителен 7 дней)</li>
                        <li>Наблюдайте за таймером обратного отсчета Access Token</li>
                        <li>Когда Access Token истечет, используйте кнопку "Обновить Access Token" для получения нового токена</li>
                        <li>Попробуйте использовать защищенный API до и после обновления токена</li>
                    </ol>
                </div>
            </section>

            <section class="mb-5">
                <h3>Задача: Реализовать Refresh Token</h3>
                <div class="alert alert-warning">
                    <h5>Ваша задача:</h5>
                    <p>Изучите реализацию Refresh Token в проекте и ответьте на вопросы:</p>
                    <ul>
                        <li>Как генерируется Refresh Token?</li>
                        <li>Как хранятся Refresh Token в БД?</li>
                        <li>Как происходит обновление Access Token?</li>
                        <li>Как отозвать Refresh Token?</li>
                    </ul>
                </div>
            </section>
        </div>

        <div class="tab-pane fade" id="answers" role="tabpanel">
            <h2>Решение: Реализация Refresh Token</h2>

            <section class="mb-5">
                <h3>1. Модель RefreshToken</h3>
                <div class="code-block">
                    <pre><code>public class RefreshToken
{
    public int Id { get; set; }
    public string Token { get; set; } = string.Empty;
    public int UserId { get; set; }
    public DateTime Expires { get; set; }
    public bool IsRevoked { get; set; }
    public DateTime Created { get; set; } = DateTime.UtcNow;
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>2. Генерация Refresh Token</h3>
                <div class="code-block">
                    <pre><code>public string GenerateRefreshToken()
{
    var randomNumber = new byte[64];
    using var rng = RandomNumberGenerator.Create();
    rng.GetBytes(randomNumber);
    return Convert.ToBase64String(randomNumber);
}</code></pre>
                    <div class="code-explanation">
                        <strong>Объяснение:</strong> Refresh Token генерируется как криптографически стойкая случайная строка длиной 64 байта, преобразованная в Base64.
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>3. Сохранение Refresh Token в БД</h3>
                <div class="code-block">
                    <pre><code>public async Task SaveRefreshTokenAsync(int userId, string refreshToken, DateTime expires)
{
    var token = new RefreshToken
    {
        Token = refreshToken,
        UserId = userId,
        Expires = expires,
        IsRevoked = false
    };

    _context.RefreshTokens.Add(token);
    await _context.SaveChangesAsync();
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>4. Метод Login с выдачей обоих токенов</h3>
                <div class="code-block">
                    <pre><code>[HttpPost("login")]
public async Task&lt;IActionResult&gt; Login([FromBody] LoginRequest request)
{
    var user = await _userService.GetUserByUsernameAsync(request.Username);
    if (user == null || !_userService.VerifyPassword(request.Password, user.PasswordHash))
    {
        return Unauthorized(new { message = "Неверные учетные данные" });
    }

    // Генерация токенов
    var accessToken = _tokenService.GenerateAccessToken(user);
    var refreshToken = _tokenService.GenerateRefreshToken();
    var refreshTokenExpires = DateTime.UtcNow.AddDays(7);

    // Сохранение refresh token
    await _tokenService.SaveRefreshTokenAsync(
        user.Id, refreshToken, refreshTokenExpires);

    return Ok(new AuthResponse
    {
        AccessToken = accessToken,
        RefreshToken = refreshToken,
        Username = user.Username,
        Role = user.Role,
        AccessTokenExpires = DateTime.UtcNow.AddMinutes(15),
        RefreshTokenExpires = refreshTokenExpires
    });
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>5. Метод Refresh для обновления токенов</h3>
                <div class="code-block">
                    <pre><code>[HttpPost("refresh")]
public async Task&lt;IActionResult&gt; Refresh([FromBody] RefreshTokenRequest request)
{
    // Проверка валидности refresh token
    if (!await _tokenService.IsRefreshTokenValidAsync(request.RefreshToken))
    {
        return Unauthorized(new { message = "Недействительный refresh token" });
    }

    var refreshToken = await _tokenService.GetRefreshTokenAsync(request.RefreshToken);
    if (refreshToken == null)
    {
        return Unauthorized(new { message = "Refresh token не найден" });
    }

    // Получение пользователя
    var user = await GetUserByIdAsync(refreshToken.UserId);

    // Отзыв старого refresh token
    await _tokenService.RevokeRefreshTokenAsync(request.RefreshToken);

    // Генерация новых токенов
    var newAccessToken = _tokenService.GenerateAccessToken(user);
    var newRefreshToken = _tokenService.GenerateRefreshToken();
    var newRefreshTokenExpires = DateTime.UtcNow.AddDays(7);

    // Сохранение нового refresh token
    await _tokenService.SaveRefreshTokenAsync(
        user.Id, newRefreshToken, newRefreshTokenExpires);

    return Ok(new AuthResponse
    {
        AccessToken = newAccessToken,
        RefreshToken = newRefreshToken,
        Username = user.Username,
        Role = user.Role,
        AccessTokenExpires = DateTime.UtcNow.AddMinutes(15),
        RefreshTokenExpires = newRefreshTokenExpires
    });
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>6. Проверка валидности Refresh Token</h3>
                <div class="code-block">
                    <pre><code>public async Task&lt;bool&gt; IsRefreshTokenValidAsync(string token)
{
    var refreshToken = await _context.RefreshTokens
        .FirstOrDefaultAsync(rt => rt.Token == token);
    
    return refreshToken != null 
        && !refreshToken.IsRevoked 
        && refreshToken.Expires > DateTime.UtcNow;
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>7. Отзыв Refresh Token</h3>
                <div class="code-block">
                    <pre><code>[HttpPost("revoke")]
public async Task&lt;IActionResult&gt; Revoke([FromBody] RefreshTokenRequest request)
{
    await _tokenService.RevokeRefreshTokenAsync(request.RefreshToken);
    return Ok(new { message = "Refresh token отозван" });
}

// В сервисе:
public async Task RevokeRefreshTokenAsync(string token)
{
    var refreshToken = await GetRefreshTokenAsync(token);
    if (refreshToken != null)
    {
        refreshToken.IsRevoked = true;
        await _context.SaveChangesAsync();
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>8. Использование на клиенте</h3>
                <div class="code-block">
                    <pre><code>// 1. Вход и получение токенов
const loginResponse = await fetch('/api/Auth/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ username: 'user', password: 'pass' })
});
const { accessToken, refreshToken } = await loginResponse.json();

// Сохранение токенов
localStorage.setItem('accessToken', accessToken);
localStorage.setItem('refreshToken', refreshToken);

// 2. При истечении Access Token (401)
async function refreshAccessToken() {
    const refreshToken = localStorage.getItem('refreshToken');
    const response = await fetch('/api/Auth/refresh', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ refreshToken })
    });
    
    if (response.ok) {
        const { accessToken, refreshToken: newRefreshToken } = await response.json();
        localStorage.setItem('accessToken', accessToken);
        localStorage.setItem('refreshToken', newRefreshToken);
        return accessToken;
    }
    
    // Если refresh token невалиден - перенаправить на логин
    window.location.href = '/login';
}</code></pre>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var triggerTabList = [].slice.call(document.querySelectorAll('#chapterTabs button'))
        triggerTabList.forEach(function (triggerEl) {
            var tabTrigger = new bootstrap.Tab(triggerEl)
        })

        const API_URL = '/api/Auth';
        let accessToken = null;
        let refreshToken = null;
        let accessTokenExpires = null;
        let refreshTokenExpires = null;
        let accessTokenTimer = null;
        let refreshTokenTimer = null;

        // Вход
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = {
                username: document.getElementById('loginUsername').value,
                password: document.getElementById('loginPassword').value
            };

            try {
                const response = await fetch(`${API_URL}/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                if (response.ok) {
                    accessToken = result.accessToken;
                    refreshToken = result.refreshToken;
                    accessTokenExpires = new Date(result.accessTokenExpires);
                    refreshTokenExpires = new Date(result.refreshTokenExpires);

                    document.getElementById('accessTokenDisplay').value = accessToken;
                    document.getElementById('refreshTokenDisplay').value = refreshToken;
                    document.getElementById('refreshTokenBtn').disabled = false;
                    document.getElementById('testApiBtn').disabled = false;

                    startTimers();
                    showStatus('Токены получены успешно!', 'success');
                } else {
                    showStatus('Ошибка: ' + (result.message || 'Неверные учетные данные'), 'danger');
                }
            } catch (error) {
                showStatus('Ошибка: ' + error.message, 'danger');
            }
        });

        // Обновление токена
        document.getElementById('refreshTokenBtn').addEventListener('click', async () => {
            if (!refreshToken) {
                showStatus('Сначала войдите в систему', 'warning');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/refresh`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ refreshToken: refreshToken })
                });

                const result = await response.json();
                if (response.ok) {
                    accessToken = result.accessToken;
                    refreshToken = result.refreshToken; // Новый refresh token
                    accessTokenExpires = new Date(result.accessTokenExpires);
                    refreshTokenExpires = new Date(result.refreshTokenExpires);

                    document.getElementById('accessTokenDisplay').value = accessToken;
                    document.getElementById('refreshTokenDisplay').value = refreshToken;

                    startTimers();
                    showStatus('Access Token успешно обновлен!', 'success');
                } else {
                    showStatus('Ошибка обновления: ' + (result.message || 'Неизвестная ошибка'), 'danger');
                }
            } catch (error) {
                showStatus('Ошибка: ' + error.message, 'danger');
            }
        });

        // Тестирование API
        document.getElementById('testApiBtn').addEventListener('click', async () => {
            if (!accessToken) {
                showStatus('Сначала войдите в систему', 'warning');
                return;
            }

            try {
                const response = await fetch('/api/Protected/data', {
                    headers: {
                        'Authorization': `Bearer ${accessToken}`
                    }
                });

                const result = await response.json();
                const resultDiv = document.getElementById('apiResult');
                
                if (response.ok) {
                    resultDiv.innerHTML = `<div class="alert alert-success"><strong>Успешно!</strong><br>Данные: ${JSON.stringify(result, null, 2)}</div>`;
                } else if (response.status === 401) {
                    resultDiv.innerHTML = `<div class="alert alert-warning"><strong>Access Token истек!</strong><br>Используйте кнопку "Обновить Access Token" для получения нового токена.</div>`;
                } else {
                    resultDiv.innerHTML = `<div class="alert alert-danger"><strong>Ошибка:</strong> ${result.message || 'Неизвестная ошибка'}</div>`;
                }
            } catch (error) {
                document.getElementById('apiResult').innerHTML = `<div class="alert alert-danger"><strong>Ошибка:</strong> ${error.message}</div>`;
            }
        });

        // Запуск таймеров
        function startTimers() {
            if (accessTokenTimer) clearInterval(accessTokenTimer);
            if (refreshTokenTimer) clearInterval(refreshTokenTimer);

            accessTokenTimer = setInterval(() => {
                if (accessTokenExpires) {
                    const now = new Date();
                    const diff = accessTokenExpires - now;
                    if (diff > 0) {
                        const minutes = Math.floor(diff / 60000);
                        const seconds = Math.floor((diff % 60000) / 1000);
                        document.getElementById('accessTokenTimer').textContent = 
                            `${minutes}:${seconds.toString().padStart(2, '0')}`;
                        
                        if (diff < 60000) { // Меньше минуты
                            document.getElementById('accessTokenTimer').className = 'fw-bold text-danger';
                        }
                    } else {
                        document.getElementById('accessTokenTimer').textContent = 'Истек';
                        document.getElementById('accessTokenTimer').className = 'fw-bold text-danger';
                    }
                }
            }, 1000);

            refreshTokenTimer = setInterval(() => {
                if (refreshTokenExpires) {
                    const now = new Date();
                    const diff = refreshTokenExpires - now;
                    if (diff > 0) {
                        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        document.getElementById('refreshTokenTimer').textContent = 
                            `${days}д ${hours}ч`;
                    } else {
                        document.getElementById('refreshTokenTimer').textContent = 'Истек';
                        document.getElementById('refreshTokenTimer').className = 'fw-bold text-danger';
                    }
                }
            }, 1000);
        }

        function showStatus(text, type) {
            const statusDiv = document.getElementById('tokenStatus');
            statusDiv.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${text}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;
            setTimeout(() => {
                statusDiv.innerHTML = '';
            }, 5000);
        }
    </script>
}

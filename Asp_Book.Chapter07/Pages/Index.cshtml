            <section class="mb-5">
                <h3>5. Services/UserService.cs</h3>
                <p>Сервис для работы с пользователями (хранение в памяти для простоты):</p>
                <div class="code-block">
                    <pre><code>using System.Security.Cryptography;
using System.Text;
using Asp_Book.Chapter07.Models;

namespace Asp_Book.Chapter07.Services;

public interface IUserService
{
    User? GetUserByUsername(string username);
    User CreateUser(string username, string email, string password);
    bool VerifyPassword(string password, string passwordHash);
}

public class UserService : IUserService
{
    // Для простоты храним пользователей в памяти
    // В реальном проекте — используйте базу данных
    private readonly List&lt;User&gt; _users = new();
    private int _nextId = 1;

    public User? GetUserByUsername(string username)
    {
        return _users.FirstOrDefault(
            u => u.Username.Equals(username, StringComparison.OrdinalIgnoreCase));
    }

    public User CreateUser(string username, string email, string password)
    {
        var user = new User
        {
            Id = _nextId++,
            Username = username,
            Email = email,
            PasswordHash = HashPassword(password),
            Role = "User"
        };

        _users.Add(user);
        return user;
    }

    public bool VerifyPassword(string password, string passwordHash)
    {
        return HashPassword(password) == passwordHash;
    }

    private string HashPassword(string password)
    {
        using var sha256 = SHA256.Create();
        var bytes = sha256.ComputeHash(Encoding.UTF8.GetBytes(password));
        return Convert.ToBase64String(bytes);
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Примечание:</strong> В реальном проекте используйте базу данных и <code>BCrypt</code> для хеширования паролей. Хранение в памяти — только для демонстрации.

            <section class="mb-5">
                <h3>5. Параметризованные тесты [Theory] + [InlineData]</h3>
                <p>Один метод — множество наборов данных. Каждый <code>[InlineData]</code> запускает тест отдельно:</p>
                <div class="code-block">
                    <pre><code>using Asp_Book.Chapter01.Controllers;
using Microsoft.AspNetCore.Mvc;
using System.Text.Json;
using Xunit;

namespace Asp_Book.Chapter01.Tests;

public class CalculatorParameterizedTests
{
    private readonly CalculatorController _controller = new();

    private double GetResult(IActionResult actionResult)
    {
        var okResult = Assert.IsType&lt;OkObjectResult&gt;(actionResult);
        var json = JsonSerializer.Serialize(okResult.Value);
        var doc = JsonDocument.Parse(json);
        return doc.RootElement.GetProperty("result").GetDouble();
    }

    // ========== Сложение: множество комбинаций ==========

    [Theory]
    [InlineData(2, 3, 5)]         // Обычное сложение
    [InlineData(0, 0, 0)]         // Ноль + ноль
    [InlineData(-1, 1, 0)]        // Отрицательное + положительное
    [InlineData(-5, -3, -8)]      // Два отрицательных
    [InlineData(100, 200, 300)]   // Большие числа
    [InlineData(0.1, 0.2, 0.3)]  // Дробные числа
    [InlineData(999999, 1, 1000000)] // Граничные значения
    public void Add_VariousInputs_ReturnsCorrectSum(
        double a, double b, double expected)
    {
        // Arrange
        var request = new CalculationRequest { A = a, B = b };

        // Act
        var result = _controller.Add(request);

        // Assert
        var sum = GetResult(result);
        Assert.Equal(expected, sum, precision: 10);
        // precision: 10 — точность до 10 знаков после запятой
        // (нужно для дробных чисел, т.к. 0.1 + 0.2 ≈ 0.30000000000000004)
    }

    // ========== Вычитание: множество комбинаций ==========

    [Theory]
    [InlineData(10, 3, 7)]        // Обычное
    [InlineData(5, 5, 0)]         // Одинаковые → 0
    [InlineData(3, 10, -7)]       // Результат отрицательный
    [InlineData(-5, -3, -2)]      // Оба отрицательных
    [InlineData(0, 7, -7)]        // Ноль минус число
    [InlineData(100.5, 0.5, 100)] // Дробные
    public void Subtract_VariousInputs_ReturnsCorrectDifference(
        double a, double b, double expected)
    {
        var request = new CalculationRequest { A = a, B = b };
        var result = _controller.Subtract(request);
        Assert.Equal(expected, GetResult(result), precision: 10);
    }

    // ========== Умножение: множество комбинаций ==========

    [Theory]
    [InlineData(3, 4, 12)]        // Обычное
    [InlineData(0, 100, 0)]       // Ноль * число = 0
    [InlineData(100, 0, 0)]       // Число * ноль = 0
    [InlineData(-2, 3, -6)]       // Отрицательное * положительное
    [InlineData(-2, -3, 6)]       // Два отрицательных = положительное
    [InlineData(1, 999, 999)]     // Умножение на 1
    [InlineData(0.5, 4, 2)]       // Дробное
    public void Multiply_VariousInputs_ReturnsCorrectProduct(
        double a, double b, double expected)
    {
        var request = new CalculationRequest { A = a, B = b };
        var result = _controller.Multiply(request);
        Assert.Equal(expected, GetResult(result), precision: 10);
    }

    // ========== Деление: множество комбинаций ==========

    [Theory]
    [InlineData(10, 2, 5)]        // Целое деление
    [InlineData(7, 2, 3.5)]       // Дробный результат
    [InlineData(1, 3, 0.3333333333333333)]  // Бесконечная дробь
    [InlineData(0, 5, 0)]         // Ноль делить на число = 0
    [InlineData(-10, 2, -5)]      // Отрицательное делить на положительное
    [InlineData(-10, -2, 5)]      // Два отрицательных = положительное
    [InlineData(100, 100, 1)]     // Число делить на себя = 1
    public void Divide_VariousInputs_ReturnsCorrectQuotient(
        double a, double b, double expected)
    {
        var request = new CalculationRequest { A = a, B = b };
        var result = _controller.Divide(request);
        Assert.Equal(expected, GetResult(result), precision: 10);
    }

    // ========== Деление на ноль — всегда BadRequest ==========

    [Theory]
    [InlineData(1)]       // Положительное / 0
    [InlineData(-1)]      // Отрицательное / 0
    [InlineData(0)]       // 0 / 0
    [InlineData(999999)]  // Большое число / 0
    public void Divide_ByZero_AlwaysReturnsBadRequest(double a)
    {
        // Arrange
        var request = new CalculationRequest { A = a, B = 0 };

        // Act
        var result = _controller.Divide(request);

        // Assert — всегда BadRequest, независимо от числителя
        Assert.IsType&lt;BadRequestObjectResult&gt;(result);
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>[Theory] vs [Fact] — когда что использовать:</strong>
                        <table class="table table-striped table-bordered mt-2">

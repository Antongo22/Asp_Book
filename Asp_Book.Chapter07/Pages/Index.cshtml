@section Scripts {
    <script>
        var triggerTabList = [].slice.call(document.querySelectorAll('#chapterTabs button'))
        triggerTabList.forEach(function (triggerEl) {
            var tabTrigger = new bootstrap.Tab(triggerEl)
        })

        const API_URL = '/api/Auth';
        let currentToken = localStorage.getItem('jwt_token');

        if (currentToken) {
            document.getElementById('tokenDisplay').value = currentToken;
            document.getElementById('testProtectedBtn').disabled = false;
        }

        // Регистрация
        document.getElementById('registerForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = {
                username: document.getElementById('regUsername').value,
                email: document.getElementById('regEmail').value,
                password: document.getElementById('regPassword').value
            };

            try {
                const response = await fetch(`${API_URL}/register`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                if (response.ok) {
                    currentToken = result.token;
                    localStorage.setItem('jwt_token', currentToken);
                    document.getElementById('tokenDisplay').value = currentToken;
                    document.getElementById('testProtectedBtn').disabled = false;
                    showMessage('Регистрация успешна! Токен получен.', 'success');
                    // Переключение на вкладку входа
                    document.getElementById('login-tab').click();
                } else {
                    showMessage('Ошибка: ' + (result.message || 'Неизвестная ошибка'), 'danger');
                }
            } catch (error) {
                showMessage('Ошибка: ' + error.message, 'danger');
            }
        });

        // Вход
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = {
                username: document.getElementById('loginUsername').value,
                password: document.getElementById('loginPassword').value
            };

            try {
                const response = await fetch(`${API_URL}/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                if (response.ok) {
                    currentToken = result.token;
                    localStorage.setItem('jwt_token', currentToken);
                    document.getElementById('tokenDisplay').value = currentToken;
                    document.getElementById('testProtectedBtn').disabled = false;
                    showMessage('Вход выполнен успешно! Токен получен.', 'success');
                } else {
                    showMessage('Ошибка: ' + (result.message || 'Неверные учетные данные'), 'danger');
                }
            } catch (error) {
                showMessage('Ошибка: ' + error.message, 'danger');
            }
        });

        // Тестирование защищенного API
        document.getElementById('testProtectedBtn').addEventListener('click', async () => {
            if (!currentToken) {
                showMessage('Сначала войдите в систему', 'warning');
                return;
            }

            try {
                const response = await fetch('/api/Protected/data', {
                    headers: {
                        'Authorization': `Bearer ${currentToken}`
                    }
                });

                const result = await response.json();
                const resultDiv = document.getElementById('protectedResult');
                
                if (response.ok) {
                    resultDiv.className = 'alert alert-success';
                    resultDiv.innerHTML = `<strong>Успешно!</strong><br>Данные: ${JSON.stringify(result, null, 2)}`;
                    resultDiv.style.display = 'block';
                } else {
                    resultDiv.className = 'alert alert-danger';
                    resultDiv.innerHTML = `<strong>Ошибка:</strong> ${result.message || 'Неизвестная ошибка'}`;
                    resultDiv.style.display = 'block';
                }
            } catch (error) {
                const resultDiv = document.getElementById('protectedResult');
                resultDiv.className = 'alert alert-danger';
                resultDiv.innerHTML = `<strong>Ошибка:</strong> ${error.message}`;
                resultDiv.style.display = 'block';
            }
        });

        function showMessage(text, type) {
            const resultDiv = document.getElementById('protectedResult');
            resultDiv.className = `alert alert-${type}`;
            resultDiv.innerHTML = text;
            resultDiv.style.display = 'block';
            setTimeout(() => {
                if (type !== 'success') {
                    resultDiv.style.display = 'none';
                }
            }, 5000);
        }
    </script>
}

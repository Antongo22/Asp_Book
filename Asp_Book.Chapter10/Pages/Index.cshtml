    <div class="tab-content" id="chapterTabsContent">
        <div class="tab-pane fade show active" id="theory" role="tabpanel">
            <h2>Теория</h2>

            <section class="mb-5">
                <h3>Что такое SignalR?</h3>
                <p><strong>SignalR</strong> — библиотека Microsoft для добавления функциональности <strong>реального времени</strong> в веб-приложения. Это высокоуровневая абстракция над WebSocket (и другими транспортами).</p>
                
                <h4>SignalR vs чистый WebSocket</h4>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Параметр</th>
                                <th>Чистый WebSocket (Глава 9)</th>
                                <th>SignalR</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Уровень абстракции</td>
                                <td>Низкий (байты, буферы)</td>
                                <td>Высокий (методы, объекты)</td>
                            </tr>
                            <tr>
                                <td>Транспорт</td>
                                <td>Только WebSocket</td>
                                <td>WebSocket → SSE → Long Polling (автоматически)</td>
                            </tr>
                            <tr>
                                <td>Переподключение</td>
                                <td>Вручную</td>
                                <td>Автоматическое</td>
                            </tr>
                            <tr>
                                <td>Группы</td>
                                <td>Вручную (словарь)</td>
                                <td>Встроенные (<code>Groups</code>)</td>
                            </tr>
                            <tr>
                                <td>Вызов методов</td>
                                <td>Парсинг строк вручную</td>
                                <td>RPC: <code>connection.invoke("Method")</code></td>
                            </tr>
                            <tr>
                                <td>Сериализация</td>
                                <td>Вручную (JSON/бинарный)</td>
                                <td>Автоматическая (JSON/MessagePack)</td>
                            </tr>
                            <tr>
                                <td>Масштабирование</td>
                                <td>Сложно</td>
                                <td>Redis, Azure SignalR Service</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-info mt-3">
                    <strong>Когда использовать что?</strong>
                    <ul>
                        <li><strong>WebSocket</strong> — когда нужен полный контроль, минимальные зависимости, или работаете не с .NET клиентами</li>
                        <li><strong>SignalR</strong> — для большинства задач реального времени в .NET (чаты, уведомления, дашборды)</li>
                    </ul>
                </div>
            </section>

            <section class="mb-5">
                <h3>Концепция Hub</h3>
                <p><strong>Hub</strong> — это центральный класс в SignalR, через который проходит вся коммуникация. Это как «контроллер» для реального времени.</p>

                <div class="code-block">
                    <pre><code>using Microsoft.AspNetCore.SignalR;

public class ChatHub : Hub
{
    // Метод, который клиент может ВЫЗВАТЬ
    public async Task SendToAll(string user, string message)
    {
        // Отправляем ВСЕМ подключённым клиентам
        await Clients.All.SendAsync("ReceiveMessage", user, message);
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Как это работает:</strong>
                        <ol>
                            <li>Клиент вызывает: <code>connection.invoke("SendToAll", "Иван", "Привет")</code></li>
                            <li>Сервер получает вызов и выполняет метод <code>SendToAll</code></li>
                            <li>Сервер вызывает <code>Clients.All.SendAsync("ReceiveMessage", ...)</code></li>
                            <li>Все клиенты получают событие <code>"ReceiveMessage"</code> с данными</li>
                        </ol>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Способы отправки сообщений</h3>
                <p>SignalR предоставляет несколько способов отправки сообщений:</p>

                <div class="code-block">
                    <pre><code>public class ChatHub : Hub
{
    // 1. Всем подключённым клиентам
    public async Task SendToAll(string user, string message)
    {
        await Clients.All.SendAsync("ReceiveMessage", user, message);
    }

    // 2. Конкретному клиенту по ConnectionId
    public async Task SendToUser(string connectionId, string user, string message)
    {
        await Clients.Client(connectionId).SendAsync("ReceiveMessage", user, message);
    }

    // 3. Всем, КРОМЕ отправителя
    public async Task SendToOthers(string user, string message)
    {
        await Clients.Others.SendAsync("ReceiveMessage", user, message);
    }

    // 4. Группе клиентов
    public async Task SendToGroup(string groupName, string user, string message)
    {
        await Clients.Group(groupName).SendAsync("ReceiveMessage", user, message);
    }

    // 5. Только отправителю (echo)
    public async Task SendToCaller(string message)
    {
        await Clients.Caller.SendAsync("ReceiveMessage", "Сервер", message);
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Варианты <code>Clients</code>:</strong>
                        <table class="table table-striped table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Свойство</th>
                                    <th>Кому отправляет</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>Clients.All</code></td>
                                    <td>Всем подключённым</td>
                                </tr>
                                <tr>
                                    <td><code>Clients.Caller</code></td>
                                    <td>Только отправителю</td>
                                </tr>
                                <tr>
                                    <td><code>Clients.Others</code></td>
                                    <td>Всем, кроме отправителя</td>
                                </tr>
                                <tr>
                                    <td><code>Clients.Client(id)</code></td>
                                    <td>Конкретному клиенту</td>
                                </tr>
                                <tr>
                                    <td><code>Clients.Group(name)</code></td>
                                    <td>Всем в группе</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Группы (Groups)</h3>
                <p>Группы позволяют объединять клиентов для отправки сообщений подмножеству пользователей.</p>

                <div class="code-block">
                    <pre><code>public class ChatHub : Hub
{
    // Добавление клиента в группу
    public async Task JoinGroup(string groupName)
    {
        await Groups.AddToGroupAsync(Context.ConnectionId, groupName);
        await Clients.Group(groupName).SendAsync(
            "ReceiveMessage", "Система", $"Пользователь присоединился к {groupName}");
    }

    // Удаление клиента из группы
    public async Task LeaveGroup(string groupName)
    {
        await Groups.RemoveFromGroupAsync(Context.ConnectionId, groupName);
        await Clients.Group(groupName).SendAsync(
            "ReceiveMessage", "Система", $"Пользователь покинул {groupName}");
    }

    // Отправка сообщения в группу
    public async Task SendToGroup(string groupName, string user, string message)
    {
        await Clients.Group(groupName).SendAsync("ReceiveMessage", user, message);
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>События подключения и отключения</h3>
                <p>Hub имеет виртуальные методы для обработки подключения и отключения клиентов.</p>

                <div class="code-block">
                    <pre><code>public class ChatHub : Hub
{
    // Клиент подключился
    public override async Task OnConnectedAsync()
    {
        // Context.ConnectionId — уникальный ID этого подключения
        await Clients.All.SendAsync("UserConnected", Context.ConnectionId);
        await base.OnConnectedAsync();
    }

    // Клиент отключился
    public override async Task OnDisconnectedAsync(Exception? exception)
    {
        await Clients.All.SendAsync("UserDisconnected", Context.ConnectionId);
        await base.OnDisconnectedAsync(exception);
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Context — информация о текущем подключении:</strong>
                        <ul>
                            <li><code>Context.ConnectionId</code> — уникальный ID соединения</li>
                            <li><code>Context.User</code> — информация о пользователе (если авторизован)</li>
                            <li><code>Context.GetHttpContext()</code> — доступ к HTTP контексту</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Регистрация Hub в Program.cs</h3>
                <div class="code-block">
                    <pre><code>var builder = WebApplication.CreateBuilder(args);

builder.Services.AddControllers();
builder.Services.AddRazorPages();

// 1. Регистрация SignalR
builder.Services.AddSignalR();

var app = builder.Build();

app.UseStaticFiles();
app.UseRouting();
app.UseAuthorization();

app.MapRazorPages();
app.MapControllers();

// 2. Маппинг Hub на URL
app.MapHub&lt;ChatHub&gt;("/chathub");

app.Run();</code></pre>
                    <div class="code-explanation">
                        <strong>Два шага:</strong>
                        <ol>
                            <li><code>AddSignalR()</code> — регистрация сервисов SignalR в DI</li>
                            <li><code>MapHub&lt;ChatHub&gt;("/chathub")</code> — Hub доступен по URL <code>/chathub</code></li>
                        </ol>
                    </div>
                </div>

                <div class="alert alert-warning mt-3">
                    <strong>Важно: НЕ устанавливайте пакет <code>Microsoft.AspNetCore.SignalR</code>!</strong>
                    <p>В .NET 6+ SignalR <strong>уже встроен</strong> в фреймворк. Методы <code>AddSignalR()</code> и <code>MapHub&lt;T&gt;()</code> доступны «из коробки» в проекте <code>Microsoft.NET.Sdk.Web</code>.</p>
                    <p>Пакет <code>Microsoft.AspNetCore.SignalR</code> (версии 1.x) — это <strong>старая версия</strong> для ASP.NET Core 2.x. Если его установить в .NET 10 проект, произойдёт конфликт протоколов и клиент не сможет подключиться (ошибка парсинга JSON).</p>
                    <p><strong>Что нужно устанавливать:</strong></p>
                    <ul>
                        <li><strong>Сервер (ASP.NET проект)</strong> — ничего, SignalR уже встроен</li>
                        <li><strong>C# клиент (консольное приложение)</strong> — <code>dotnet add package Microsoft.AspNetCore.SignalR.Client</code></li>
                    </ul>
                </div>
            </section>

            <section class="mb-5">
                <h3>Клиент — консольное приложение на C#</h3>
                <p>Для подключения к SignalR Hub из C# используется пакет <code>Microsoft.AspNetCore.SignalR.Client</code>.</p>

                <h4>Шаг 1: Создание проекта и установка пакета</h4>
                <div class="code-block">
                    <pre><code># Создаём консольное приложение
dotnet new console -n SignalRChat.Console

cd SignalRChat.Console

# Устанавливаем SignalR клиент
dotnet add package Microsoft.AspNetCore.SignalR.Client</code></pre>
                    <div class="code-explanation">
                        В отличие от WebSocket (<code>ClientWebSocket</code>), SignalR-клиент <strong>не встроен</strong> в .NET — нужен NuGet пакет <code>Microsoft.AspNetCore.SignalR.Client</code>.
                    </div>
                </div>

                <h4>Шаг 2: Program.cs — полный код клиента</h4>
                <div class="code-block">
                    <pre><code>using Microsoft.AspNetCore.SignalR.Client;

const string hubUrl = "http://localhost:5010/chathub";

Console.WriteLine("=== SignalR Чат (консольный клиент) ===");
Console.Write("Введите ваше имя: ");
var userName = Console.ReadLine()?.Trim() ?? "Аноним";

// 1. Создаём соединение с Hub
var connection = new HubConnectionBuilder()
    .WithUrl(hubUrl)
    .WithAutomaticReconnect()  // Автопереподключение при обрыве
    .Build();

// 2. Подписываемся на события от сервера
connection.On&lt;string, string&gt;("ReceiveMessage", (user, message) =>
{
    Console.WriteLine($"💬 {user}: {message}");
});

connection.On&lt;string&gt;("UserConnected", (connectionId) =>
{
    Console.WriteLine($"🟢 Подключился: {connectionId[..8]}...");
});

connection.On&lt;string&gt;("UserDisconnected", (connectionId) =>
{
    Console.WriteLine($"🔴 Отключился: {connectionId[..8]}...");
});

// Обработка переподключения
connection.Reconnecting += error =>
{
    Console.WriteLine("⏳ Переподключение...");
    return Task.CompletedTask;
};

connection.Reconnected += newConnectionId =>
{
    Console.WriteLine($"✅ Переподключено! Новый ID: {newConnectionId?[..8]}...");
    return Task.CompletedTask;
};

connection.Closed += error =>
{
    Console.WriteLine("🔌 Соединение закрыто.");
    return Task.CompletedTask;
};

// 3. Подключаемся к Hub
try
{
    Console.WriteLine($"\nПодключение к {hubUrl}...");
    await connection.StartAsync();
    Console.WriteLine($"✅ Подключено! Мой ID: {connection.ConnectionId?[..8]}...\n");
}
catch (Exception ex)
{
    Console.WriteLine($"❌ Ошибка подключения: {ex.Message}");
    return;
}

// 4. Основной цикл — отправка сообщений
Console.WriteLine("Команды:");
Console.WriteLine("  [текст]           — отправить всем");
Console.WriteLine("  /pm [id] [текст]  — приватное сообщение");
Console.WriteLine("  /id               — показать свой Connection ID");
Console.WriteLine("  exit              — выход\n");

while (connection.State == HubConnectionState.Connected)
{
    var input = Console.ReadLine();
    if (string.IsNullOrEmpty(input)) continue;

    if (input.ToLower() == "exit")
        break;

    if (input.ToLower() == "/id")
    {
        Console.WriteLine($"📋 Ваш Connection ID: {connection.ConnectionId}");
        continue;
    }

    if (input.StartsWith("/pm "))
    {
        // Формат: /pm connectionId сообщение
        var parts = input.Split(' ', 3);
        if (parts.Length &lt; 3)
        {
            Console.WriteLine("Формат: /pm [connectionId] [сообщение]");
            continue;
        }
        await connection.InvokeAsync("SendToUser", parts[1], userName, parts[2]);
        continue;
    }

    // Отправка всем
    await connection.InvokeAsync("SendToAll", userName, input);
}

// 5. Корректное отключение
await connection.StopAsync();
Console.WriteLine("🔌 Отключено.");</code></pre>
                    <div class="code-explanation">
                        <strong>Ключевые отличия от WebSocket (Глава 9):</strong>
                        <ul>
                            <li><strong>Нет работы с байтами</strong> — SignalR автоматически сериализует/десериализует данные</li>
                            <li><strong>Нет фонового потока</strong> — <code>connection.On()</code> автоматически слушает события</li>
                            <li><strong>Вызов методов по имени</strong> — <code>InvokeAsync("SendToAll", ...)</code> вместо отправки строк</li>
                            <li><strong>Автопереподключение</strong> — <code>WithAutomaticReconnect()</code> всё делает сам</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Разбор ключевых моментов</h3>

                <h4>HubConnectionBuilder — создание соединения</h4>
                <div class="code-block">
                    <pre><code>var connection = new HubConnectionBuilder()
    .WithUrl("http://localhost:5010/chathub")   // URL Hub из Program.cs
    .WithAutomaticReconnect()                    // Переподключение при обрыве
    .Build();</code></pre>
                    <div class="code-explanation">
                        <code>HubConnectionBuilder</code> — паттерн Builder для настройки соединения. Аналог <code>WebApplicationBuilder</code> для сервера.
                    </div>
                </div>

                <h4 class="mt-4">connection.On — подписка на события</h4>
                <div class="code-block">
                    <pre><code>// Сервер вызывает: Clients.All.SendAsync("ReceiveMessage", user, message)
// Клиент получает:
connection.On&lt;string, string&gt;("ReceiveMessage", (user, message) =>
{
    Console.WriteLine($"{user}: {message}");
});

// Типы в On&lt;T1, T2&gt; должны совпадать с типами аргументов SendAsync!</code></pre>
                    <div class="code-explanation">
                        <ul>
                            <li><code>On&lt;string, string&gt;("ReceiveMessage", ...)</code> — подписка на событие с двумя строковыми аргументами</li>
                            <li>Имя события (<code>"ReceiveMessage"</code>) должно точно совпадать с тем, что отправляет сервер</li>
                            <li>Количество и типы аргументов в <code>On&lt;...&gt;</code> должны совпадать с <code>SendAsync</code></li>
                        </ul>
                    </div>
                </div>

                <h4 class="mt-4">connection.InvokeAsync — вызов метода на сервере</h4>
                <div class="code-block">
                    <pre><code>// Вызываем метод SendToAll на сервере (в ChatHub)
await connection.InvokeAsync("SendToAll", userName, message);

// Это эквивалентно вызову метода:
// public async Task SendToAll(string user, string message) { ... }</code></pre>
                    <div class="code-explanation">
                        <code>InvokeAsync</code> — удалённый вызов метода (RPC). Первый аргумент — <strong>имя метода</strong> в Hub, остальные — его параметры. SignalR сам сериализует данные в JSON и передаёт на сервер.
                    </div>
                </div>

                <h4 class="mt-4">Сравнение: SignalR C# клиент vs WebSocket C# клиент</h4>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Действие</th>
                                <th>WebSocket (Глава 9)</th>
                                <th>SignalR</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Пакет</td>
                                <td>Встроен (<code>System.Net.WebSockets</code>)</td>
                                <td><code>Microsoft.AspNetCore.SignalR.Client</code></td>
                            </tr>
                            <tr>
                                <td>Подключение</td>
                                <td><code>ws.ConnectAsync(uri, ct)</code></td>
                                <td><code>connection.StartAsync()</code></td>
                            </tr>
                            <tr>
                                <td>Отправка</td>
                                <td><code>ws.SendAsync(bytes, ...)</code></td>
                                <td><code>connection.InvokeAsync("Method", args)</code></td>
                            </tr>
                            <tr>
                                <td>Получение</td>
                                <td>Цикл <code>ReceiveAsync</code> + декодирование байтов</td>
                                <td><code>connection.On("Event", callback)</code></td>
                            </tr>
                            <tr>
                                <td>Переподключение</td>
                                <td>Вручную</td>
                                <td><code>WithAutomaticReconnect()</code></td>
                            </tr>
                            <tr>
                                <td>Сериализация</td>
                                <td>Вручную (<code>Encoding.UTF8</code>)</td>
                                <td>Автоматическая (JSON)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="mb-5">
                <h3>Демонстрация: SignalR чат</h3>
                <p>Попробуйте подключиться к SignalR Hub и обмениваться сообщениями в реальном времени:</p>

                <div class="card mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">SignalR чат</h5>
                        <span id="connectionStatus" class="badge bg-secondary">Отключен</span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <input type="text" id="userNameInput" class="form-control" placeholder="Введите ваше имя" />
                                </div>
                                <div class="mb-3">
                                    <button class="btn btn-success" id="connectBtn">Подключиться</button>
                                    <button class="btn btn-danger" id="disconnectBtn" disabled>Отключиться</button>
                                </div>
                                <div class="mb-3">
                                    <div id="messagesArea" class="border rounded p-3" style="height: 300px; overflow-y: auto; background-color: #f8f9fa;">
                                        <p class="text-muted text-center">Сообщения будут отображаться здесь</p>
                                    </div>
                                </div>
                                <div class="input-group">
                                    <input type="text" id="messageInput" class="form-control" placeholder="Введите сообщение..." disabled />
                                    <button class="btn btn-primary" id="sendBtn" disabled>Отправить всем</button>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">Ваш Connection ID: <span id="connectionId">-</span></small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <h6>Подключенные пользователи</h6>
                                <div id="usersList" class="border rounded p-2" style="height: 200px; overflow-y: auto;">
                                    <p class="text-muted text-center small">Список пользователей</p>
                                </div>
                                <div class="mt-3">
                                    <h6>Отправить конкретному пользователю</h6>
                                    <input type="text" id="targetConnectionId" class="form-control form-control-sm mb-2" placeholder="Connection ID" disabled />
                                    <input type="text" id="privateMessageInput" class="form-control form-control-sm mb-2" placeholder="Приватное сообщение" disabled />
                                    <button class="btn btn-warning btn-sm w-100" id="sendPrivateBtn" disabled>Отправить</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-3">
                    <strong>Инструкция:</strong>
                    <ol>

            <section class="mb-5">
                <h3>4. Клиентский код (JavaScript)</h3>
                <div class="code-block">
                    <pre><code>// Определяем протокол (ws:// или wss://)
const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
const wsUrl = `${protocol}//${window.location.host}/ws`;

let ws = null;
let userName = 'Пользователь';

// Подключение к WebSocket
function connect() {
    ws = new WebSocket(wsUrl);

    ws.onopen = () => {
        console.log('WebSocket подключен');
        addMessage('Система', 'Подключено', 'success');
    };

    ws.onmessage = (event) => {
        const data = event.data;
        // Формат: "connectionId: userName: message"
        addMessage('Сервер', data, 'info');
    };

    ws.onerror = (error) => {
        console.error('WebSocket ошибка:', error);
        addMessage('Система', 'Ошибка соединения', 'danger');
    };

    ws.onclose = () => {
        console.log('WebSocket отключен');
        addMessage('Система', 'Отключено', 'warning');
    };
}

// Отправка сообщения
function sendMessage(text) {
    if (ws &amp;&amp; ws.readyState === WebSocket.OPEN) {
        ws.send(`${userName}: ${text}`);
    }
}

// Отключение
function disconnect() {
    if (ws) {
        ws.close();
        ws = null;
    }
}</code></pre>

    <div class="tab-content" id="chapterTabsContent">
        <div class="tab-pane fade show active" id="theory" role="tabpanel">
            <h2>Теория</h2>

            <section class="mb-5">
                <h3>Что такое Dependency Injection (DI)?</h3>
                <p><strong>Dependency Injection</strong> — это паттерн проектирования, при котором зависимости объекта предоставляются извне, а не создаются внутри самого объекта.</p>
                
                <h4>Преимущества DI:</h4>
                <ul>
                    <li><strong>Слабая связанность</strong> — классы не зависят от конкретных реализаций</li>
                    <li><strong>Тестируемость</strong> — легко подменять зависимости в тестах</li>
                    <li><strong>Гибкость</strong> — можно менять реализации без изменения кода</li>
                    <li><strong>Управление жизненным циклом</strong> — фреймворк управляет созданием и уничтожением объектов</li>
                </ul>
            </section>

            <section class="mb-5">
                <h3>Жизненные циклы сервисов</h3>
                <p>В ASP.NET Core есть три типа регистрации сервисов:</p>

                <h4>1. Transient (Временный)</h4>
                <p>Создается новый экземпляр каждый раз, когда запрашивается сервис.</p>
                <div class="code-block">
                    <pre><code>builder.Services.AddTransient&lt;IMyService, MyService&gt;();</code></pre>
                    <div class="code-explanation">
                        <strong>Использование:</strong> Для легковесных, stateless сервисов. Каждый запрос получает новый экземпляр.
                    </div>
                </div>

                <h4>2. Scoped (Область действия)</h4>
                <p>Один экземпляр на HTTP запрос. Создается в начале запроса и уничтожается в конце.</p>
                <div class="code-block">
                    <pre><code>builder.Services.AddScoped&lt;IMyService, MyService&gt;();</code></pre>
                    <div class="code-explanation">
                        <strong>Использование:</strong> Для сервисов, которые должны быть одинаковыми в рамках одного запроса (например, DbContext).
                    </div>
                </div>

                <h4>3. Singleton (Одиночка)</h4>
                <p>Один экземпляр на все приложение. Создается при первом запросе и живет до остановки приложения.</p>
                <div class="code-block">
                    <pre><code>builder.Services.AddSingleton&lt;IMyService, MyService&gt;();</code></pre>
                    <div class="code-explanation">
                        <strong>Использование:</strong> Для сервисов, которые должны быть единственными (например, кэш, конфигурация).
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Демонстрация: Использование ILogger через DI</h3>
                <p>ILogger автоматически доступен через DI в ASP.NET Core:</p>

                <div class="code-block">
                    <pre><code>public class MyController : ControllerBase
{
    private readonly ILogger&lt;MyController&gt; _logger;

    // ILogger автоматически внедряется через конструктор
    public MyController(ILogger&lt;MyController&gt; logger)
    {
        _logger = logger;
    }

    [HttpGet]
    public IActionResult Get()
    {
        _logger.LogInformation("Обработка запроса");
        return Ok();
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Объяснение:</strong> ASP.NET Core автоматически регистрирует ILogger в DI контейнере. 
                        Просто объявите его в конструкторе, и он будет внедрен автоматически.
                    </div>
                </div>

                <div class="alert alert-info mt-3">
                    <strong>Попробуйте:</strong> Откройте <a href="/swagger">Swagger UI</a> и вызовите 
                    <code>GET /api/DependencyInjection/logger-demo</code> чтобы увидеть логирование в действии.
                </div>
            </section>

            <section class="mb-5">
                <h3>Демонстрация: Жизненные циклы сервисов</h3>
                <p>Посмотрите, как работают разные жизненные циклы:</p>

                <div class="alert alert-success mt-3">
                    <strong>Попробуйте:</strong> Вызовите <code>GET /api/DependencyInjection/lifetimes</code> несколько раз. 
                    Обратите внимание на ID сервисов:
                    <ul>
                        <li><strong>Scoped:</strong> ID одинаковые в рамках одного запроса</li>
                        <li><strong>Singleton:</strong> ID одинаковые во всех запросах</li>
                        <li><strong>Transient:</strong> ID разные каждый раз</li>
                    </ul>
                </div>
            </section>

            <section class="mb-5">
                <h3>Задача: Создать сервис и внедрить его</h3>
                <div class="alert alert-warning">
                    <h5>Ваша задача:</h5>
                    <p>Создайте сервис <code>IMessageService</code> и его реализацию <code>MessageService</code> со следующими методами:</p>
                    <ul>
                        <li><strong>GetMessage(string name)</strong> — возвращает приветственное сообщение</li>
                        <li><strong>LogMessage(string message)</strong> — логирует сообщение</li>
                    </ul>
                    <p><strong>Требования:</strong></p>
                    <ul>
                        <li>Создайте интерфейс <code>IMessageService</code></li>
                        <li>Создайте класс <code>MessageService</code>, реализующий интерфейс</li>
                        <li>Используйте <code>ILogger</code> для логирования (внедрите через DI)</li>
                        <li>Зарегистрируйте сервис в <code>Program.cs</code> как <code>Scoped</code></li>
                        <li>Создайте контроллер <code>MessageController</code>, который использует этот сервис</li>
                        <li>Добавьте эндпоинт <code>GET /api/Message/greet/{name}</code></li>
                    </ul>
                </div>
            </section>
        </div>

        <div class="tab-pane fade" id="answers" role="tabpanel">
            <h2>Решение задачи</h2>

            <section class="mb-5">
                <h3>1. Интерфейс IMessageService</h3>
                <div class="code-block">
                    <pre><code>namespace Asp_Book.Chapter02.Services;

public interface IMessageService
{
    string GetMessage(string name);
    void LogMessage(string message);
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>2. Реализация MessageService с DI логгера</h3>
                <div class="code-block">
                    <pre><code>namespace Asp_Book.Chapter02.Services;

public class MessageService : IMessageService
{
    private readonly ILogger&lt;MessageService&gt; _logger;
    private readonly List&lt;string&gt; _messages = new();

    // ILogger внедряется через конструктор (DI)
    public MessageService(ILogger&lt;MessageService&gt; logger)
    {
        _logger = logger;
    }

    public string GetMessage(string name)
    {
        var message = $"Привет, {name}! Это сообщение от MessageService.";
        _logger.LogInformation("Сгенерировано сообщение для {Name}", name);
        return message;
    }

    public void LogMessage(string message)
    {
        _messages.Add($"{DateTime.Now:HH:mm:ss} - {message}");
        _logger.LogInformation("Добавлено сообщение: {Message}", message);
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>3. Регистрация в Program.cs</h3>
                <div class="code-block">
                    <pre><code>builder.Services.AddScoped&lt;IMessageService, MessageService&gt;();</code></pre>
                    <div class="code-explanation">
                        <strong>Объяснение:</strong> <code>AddScoped</code> регистрирует сервис с жизненным циклом Scoped. 
                        Один экземпляр будет создан на каждый HTTP запрос.
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>4. Использование в контроллере</h3>
                <div class="code-block">
                    <pre><code>using Asp_Book.Chapter02.Services;
using Microsoft.AspNetCore.Mvc;

[ApiController]
[Route("api/[controller]")]
public class MessageController : ControllerBase
{
    private readonly IMessageService _messageService;
    private readonly ILogger&lt;MessageController&gt; _logger;

    // Оба сервиса внедряются через конструктор
    public MessageController(IMessageService messageService, ILogger&lt;MessageController&gt; logger)
    {
        _messageService = messageService;
        _logger = logger;
    }

    [HttpGet("greet/{name}")]
    public IActionResult Greet(string name)
    {
        var message = _messageService.GetMessage(name);
        return Ok(new { message });
    }
}</code></pre>
                </div>
            </section>
        </div>
    </div>
</div>


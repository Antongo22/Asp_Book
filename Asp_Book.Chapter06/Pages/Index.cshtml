@page
@model IndexModel
@{
    ViewData["Title"] = "Глава 6: Entity Framework";
}

<div class="container-fluid">
    <h1 class="mb-4">Глава 6: Entity Framework</h1>

    <ul class="nav nav-tabs mb-4" id="chapterTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="theory-tab" data-bs-toggle="tab" data-bs-target="#theory" type="button" role="tab">
                Теория и Демонстрация
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="answers-tab" data-bs-toggle="tab" data-bs-target="#answers" type="button" role="tab">
                Ответы
            </button>
        </li>
    </ul>

    <div class="tab-content" id="chapterTabsContent">
        <div class="tab-pane fade show active" id="theory" role="tabpanel">
            <h2>Теория</h2>

            <section class="mb-5">
                <h3>Что такое Entity Framework Core?</h3>
                <p><strong>Entity Framework Core (EF Core)</strong> — это ORM (Object-Relational Mapping) фреймворк от Microsoft для работы с базами данных.</p>
                
                <h4>Основные компоненты:</h4>
                <ul>
                    <li><strong>DbContext</strong> — контекст базы данных</li>
                    <li><strong>DbSet</strong> — набор сущностей</li>
                    <li><strong>Миграции</strong> — управление схемой БД</li>
                    <li><strong>LINQ</strong> — запросы к данным</li>
                </ul>
            </section>

            <section class="mb-5">
                <h3>DTO (Data Transfer Objects)</h3>
                <p>DTO используются для передачи данных между слоями приложения без раскрытия внутренней структуры сущностей.</p>

                <div class="code-block">
                    <pre><code>// Модель (внутренняя структура)
public class Product
{
    public int Id { get; set; }
    public string Name { get; set; }
    public DateTime CreatedAt { get; set; } // Внутреннее поле
}

// DTO (для API)
public class ProductDto
{
    public int Id { get; set; }
    public string Name { get; set; }
    // CreatedAt не включаем в DTO
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>Миграции</h3>
                <p>Миграции позволяют управлять схемой базы данных через код:</p>

                <div class="code-block">
                    <pre><code>// Создание миграции
dotnet ef migrations add InitialCreate

// Применение миграции
dotnet ef database update

// Откат миграции
dotnet ef database update PreviousMigration</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>CRUD операции</h3>
                <p>Базовые операции с данными:</p>
                <ul>
                    <li><strong>Create</strong> — создание (Add, SaveChanges)</li>
                    <li><strong>Read</strong> — чтение (Find, ToList, FirstOrDefault)</li>
                    <li><strong>Update</strong> — обновление (изменение свойств, SaveChanges)</li>
                    <li><strong>Delete</strong> — удаление (Remove, SaveChanges)</li>
                </ul>
            </section>

            <section class="mb-5">
                <h3>Демонстрация: CRUD операции с продуктами</h3>
                <p>Попробуйте создать, просмотреть, обновить и удалить продукты через интерактивный UI:</p>

                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="mb-0">Управление продуктами</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h6>Добавить продукт</h6>
                                <form id="productForm">
                                    <div class="mb-2">
                                        <input type="text" id="productName" class="form-control form-control-sm" placeholder="Название" required />
                                    </div>
                                    <div class="mb-2">
                                        <input type="text" id="productDescription" class="form-control form-control-sm" placeholder="Описание" />
                                    </div>
                                    <div class="mb-2">
                                        <input type="number" id="productPrice" class="form-control form-control-sm" placeholder="Цена" step="0.01" required />
                                    </div>
                                    <div class="mb-2">
                                        <input type="number" id="productStock" class="form-control form-control-sm" placeholder="Количество" required />
                                    </div>
                                    <input type="hidden" id="productId" />
                                    <button type="submit" class="btn btn-primary btn-sm" id="submitBtn">Добавить</button>
                                    <button type="button" class="btn btn-secondary btn-sm" id="cancelBtn" style="display:none;">Отмена</button>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <h6>Список продуктов</h6>
                                <div id="productsList" class="border rounded p-2" style="max-height: 300px; overflow-y: auto;">
                                    <p class="text-muted text-center">Загрузка...</p>
                                </div>
                            </div>
                        </div>
                        <div id="messageArea"></div>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Задача: Создать модель и миграции</h3>
                <div class="alert alert-warning">
                    <h5>Ваша задача:</h5>
                    <p>Создайте модель <code>Order</code> со следующими полями:</p>
                    <ul>
                        <li>Id (int, первичный ключ)</li>
                        <li>CustomerName (string, обязательно)</li>
                        <li>TotalAmount (decimal)</li>
                        <li>OrderDate (DateTime)</li>
                        <li>Status (string)</li>
                    </ul>
                    <p>Создайте миграцию и примените её к базе данных.</p>
                </div>
            </section>
        </div>

        <div class="tab-pane fade" id="answers" role="tabpanel">
            <h2>Решение задачи</h2>

            <section class="mb-5">
                <h3>1. Модель Product</h3>
                <div class="code-block">
                    <pre><code>namespace Asp_Book.Chapter06.Models;

public class Product
{
    public int Id { get; set; }
    public string Name { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public decimal Price { get; set; }
    public int Stock { get; set; }
    public DateTime CreatedAt { get; set; } = DateTime.UtcNow;
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>2. DTO для передачи данных</h3>
                <div class="code-block">
                    <pre><code>namespace Asp_Book.Chapter06.DTOs;

public class ProductDto
{
    public int Id { get; set; }
    public string Name { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public decimal Price { get; set; }
    public int Stock { get; set; }
}

public class CreateProductDto
{
    public string Name { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public decimal Price { get; set; }
    public int Stock { get; set; }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>3. ApplicationDbContext</h3>
                <div class="code-block">
                    <pre><code>using Microsoft.EntityFrameworkCore;
using Asp_Book.Chapter06.Models;

public class ApplicationDbContext : DbContext
{
    public ApplicationDbContext(DbContextOptions&lt;ApplicationDbContext&gt; options)
        : base(options)
    {
    }

    public DbSet&lt;Product&gt; Products { get; set; }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>4. Регистрация в Program.cs</h3>
                <div class="code-block">
                    <pre><code>builder.Services.AddDbContext&lt;ApplicationDbContext&gt;(options =>
    options.UseSqlite("Data Source=products.db"));</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>5. CRUD контроллер</h3>
                <div class="code-block">
                    <pre><code>[ApiController]
[Route("api/[controller]")]
public class ProductsController : ControllerBase
{
    private readonly ApplicationDbContext _context;

    public ProductsController(ApplicationDbContext context)
    {
        _context = context;
    }

    [HttpGet]
    public async Task&lt;ActionResult&lt;IEnumerable&lt;ProductDto&gt;&gt;&gt; GetProducts()
    {
        var products = await _context.Products
            .Select(p => new ProductDto
            {
                Id = p.Id,
                Name = p.Name,
                Price = p.Price,
                Stock = p.Stock
            })
            .ToListAsync();
        return Ok(products);
    }

    [HttpPost]
    public async Task&lt;ActionResult&lt;ProductDto&gt;&gt; CreateProduct(CreateProductDto dto)
    {
        var product = new Product
        {
            Name = dto.Name,
            Description = dto.Description,
            Price = dto.Price,
            Stock = dto.Stock
        };

        _context.Products.Add(product);
        await _context.SaveChangesAsync();

        var productDto = new ProductDto
        {
            Id = product.Id,
            Name = product.Name,
            Price = product.Price,
            Stock = product.Stock
        };

        return CreatedAtAction(nameof(GetProduct), new { id = product.Id }, productDto);
    }

    [HttpDelete("{id}")]
    public async Task&lt;IActionResult&gt; DeleteProduct(int id)
    {
        var product = await _context.Products.FindAsync(id);
        if (product == null) return NotFound();

        _context.Products.Remove(product);
        await _context.SaveChangesAsync();
        return NoContent();
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>6. Миграции</h3>
                <div class="code-block">
                    <pre><code>// Создание миграции
dotnet ef migrations add InitialCreate

// Применение миграции
dotnet ef database update</code></pre>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var triggerTabList = [].slice.call(document.querySelectorAll('#chapterTabs button'))
        triggerTabList.forEach(function (triggerEl) {
            var tabTrigger = new bootstrap.Tab(triggerEl)
        })

        const API_URL = '/api/products';
        let editingId = null;

        // Загрузка продуктов
        async function loadProducts() {
            try {
                const response = await fetch(API_URL);
                const products = await response.json();
                displayProducts(products);
            } catch (error) {
                showMessage('Ошибка загрузки продуктов: ' + error.message, 'danger');
            }
        }

        // Отображение продуктов
        function displayProducts(products) {
            const list = document.getElementById('productsList');
            if (products.length === 0) {
                list.innerHTML = '<p class="text-muted text-center">Нет продуктов</p>';
                return;
            }

            list.innerHTML = products.map(p => `
                <div class="border-bottom p-2 mb-2" id="product-${p.id}">
                    <strong>${p.name}</strong> - ${p.price}₽ (Остаток: ${p.stock})
                    <br><small class="text-muted">${p.description || 'Без описания'}</small>
                    <div class="mt-2">
                        <button class="btn btn-sm btn-warning" onclick="editProduct(${p.id}, '${p.name}', '${(p.description || '').replace(/'/g, "\\'")}', ${p.price}, ${p.stock})">Редактировать</button>
                        <button class="btn btn-sm btn-danger" onclick="deleteProduct(${p.id})">Удалить</button>
                    </div>
                </div>
            `).join('');
        }

        // Добавление/обновление продукта
        document.getElementById('productForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const product = {
                name: document.getElementById('productName').value,
                description: document.getElementById('productDescription').value,
                price: parseFloat(document.getElementById('productPrice').value),
                stock: parseInt(document.getElementById('productStock').value)
            };

            try {
                let response;
                if (editingId) {
                    response = await fetch(`${API_URL}/${editingId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(product)
                    });
                } else {
                    response = await fetch(API_URL, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(product)
                    });
                }

                if (response.ok) {
                    showMessage(editingId ? 'Продукт обновлен' : 'Продукт добавлен', 'success');
                    resetForm();
                    loadProducts();
                } else {
                    const error = await response.json();
                    showMessage('Ошибка: ' + (error.message || 'Неизвестная ошибка'), 'danger');
                }
            } catch (error) {
                showMessage('Ошибка: ' + error.message, 'danger');
            }
        });

        // Редактирование продукта
        async function editProduct(id, name, description, price, stock) {
            editingId = id;
            document.getElementById('productId').value = id;
            document.getElementById('productName').value = name;
            document.getElementById('productDescription').value = description || '';
            document.getElementById('productPrice').value = price;
            document.getElementById('productStock').value = stock;
            document.getElementById('submitBtn').textContent = 'Обновить';
            document.getElementById('cancelBtn').style.display = 'inline-block';
        }

        // Отмена редактирования
        document.getElementById('cancelBtn').addEventListener('click', () => {
            resetForm();
        });

        // Сброс формы
        function resetForm() {
            editingId = null;
            document.getElementById('productForm').reset();
            document.getElementById('productId').value = '';
            document.getElementById('submitBtn').textContent = 'Добавить';
            document.getElementById('cancelBtn').style.display = 'none';
        }

        // Удаление продукта
        async function deleteProduct(id) {
            if (!confirm('Вы уверены, что хотите удалить этот продукт?')) return;

            try {
                const response = await fetch(`${API_URL}/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    showMessage('Продукт удален', 'success');
                    loadProducts();
                } else {
                    showMessage('Ошибка удаления', 'danger');
                }
            } catch (error) {
                showMessage('Ошибка: ' + error.message, 'danger');
            }
        }

        // Показать сообщение
        function showMessage(text, type) {
            const area = document.getElementById('messageArea');
            area.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${text}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;
            setTimeout(() => area.innerHTML = '', 5000);
        }

        // Загрузка при открытии страницы
        loadProducts();
    </script>
}

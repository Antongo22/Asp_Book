            <section class="mb-5">
                <h3>3. Клиентский код (JavaScript)</h3>
                <p>Подключение библиотеки:</p>
                <div class="code-block">
                    <pre><code>&lt;script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"&gt;&lt;/script&gt;</code></pre>
                </div>

                <p>Полный клиентский код:</p>
                <div class="code-block">
                    <pre><code>let connection = null;
let userName = '';

// Подключение
function connect() {
    userName = document.getElementById('userNameInput').value.trim();
    
    // 1. Создаём соединение
    connection = new signalR.HubConnectionBuilder()
        .withUrl("/chathub")
        .build();

    // 2. Подписываемся на события
    connection.on("ReceiveMessage", (user, message) => {
        addMessage(user, message, 'info');
    });

    connection.on("UserConnected", (id) => {
        addMessage('Система', `Подключился: ${id.substring(0, 8)}`, 'success');
    });

    connection.on("UserDisconnected", (id) => {
        addMessage('Система', `Отключился: ${id.substring(0, 8)}`, 'warning');
    });

    // 3. Подключаемся
    connection.start()
        .then(() => {
            console.log('SignalR подключен, ID:', connection.connectionId);
        })
        .catch(err => console.error('Ошибка:', err));
}

// Отправка всем
function sendToAll(message) {
    connection.invoke("SendToAll", userName, message)
        .catch(err => console.error('Ошибка:', err));
}

// Отправка конкретному
function sendToUser(connectionId, message) {
    connection.invoke("SendToUser", connectionId, userName, message)
        .catch(err => console.error('Ошибка:', err));
}

// Отключение
function disconnect() {
    if (connection) {
        connection.stop();
        connection = null;
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>4. Структура проекта</h3>
                <div class="code-block">
                    <pre><code>Asp_Book.Chapter10/
├── Hubs/
│   └── ChatHub.cs                — SignalR Hub (SendToAll, SendToUser, ...)
├── Pages/
│   └── Index.cshtml              — UI с чатом + клиентский JS
├── Program.cs                    — AddSignalR() + MapHub
└── appsettings.json</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>5. Тестирование</h3>
                <p><strong>Шаг 1:</strong> Откройте страницу главы 10 в двух вкладках.</p>
                <p><strong>Шаг 2:</strong> В каждой вкладке введите имя и подключитесь.</p>
                <p><strong>Шаг 3:</strong> Отправьте сообщение — оно появится в обеих вкладках.</p>
                <p><strong>Шаг 4:</strong> Скопируйте Connection ID из одной вкладки и отправьте приватное сообщение из другой.</p>
                <p><strong>Шаг 5:</strong> Отключитесь — во второй вкладке появится уведомление об отключении.</p>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script>
        var triggerTabList = [].slice.call(document.querySelectorAll('#chapterTabs button'))
        triggerTabList.forEach(function (triggerEl) {
            var tabTrigger = new bootstrap.Tab(triggerEl)
        })

        let connection = null;
        let userName = '';
        let connectionId = '';

        document.getElementById('connectBtn').addEventListener('click', () => {
            userName = document.getElementById('userNameInput').value.trim();
            if (!userName) {
                alert('Введите ваше имя');
                return;
            }

            connection = new signalR.HubConnectionBuilder()
                .withUrl("/chathub")
                .build();

            connection.on("ReceiveMessage", (user, message) => {
                addMessage(user, message, 'info');
            });

            connection.on("UserConnected", (id) => {
                addMessage('Система', `Пользователь подключился: ${id.substring(0, 8)}`, 'success');
                updateUsersList();
            });

            connection.on("UserDisconnected", (id) => {
                addMessage('Система', `Пользователь отключился: ${id.substring(0, 8)}`, 'warning');
                updateUsersList();
            });

            connection.start()
                .then(() => {
                    connectionId = connection.connectionId;
                    document.getElementById('connectionId').textContent = connectionId.substring(0, 8) + '...';
                    updateConnectionStatus(true);
                    document.getElementById('connectBtn').disabled = true;
                    document.getElementById('disconnectBtn').disabled = false;
                    document.getElementById('messageInput').disabled = false;
                    document.getElementById('sendBtn').disabled = false;
                    document.getElementById('userNameInput').disabled = true;
                    document.getElementById('targetConnectionId').disabled = false;
                    document.getElementById('privateMessageInput').disabled = false;
                    document.getElementById('sendPrivateBtn').disabled = false;
                    addMessage('Система', 'Подключено к SignalR Hub', 'success');
                })
                .catch(err => {
                    console.error('SignalR connection error:', err);
                    addMessage('Система', 'Ошибка подключения: ' + err, 'danger');
                });
        });

        document.getElementById('disconnectBtn').addEventListener('click', () => {
            if (connection) {
                connection.stop();
                connection = null;
                updateConnectionStatus(false);
                document.getElementById('connectBtn').disabled = false;
                document.getElementById('disconnectBtn').disabled = true;
                document.getElementById('messageInput').disabled = true;
                document.getElementById('sendBtn').disabled = true;
                document.getElementById('userNameInput').disabled = false;
                document.getElementById('targetConnectionId').disabled = true;
                document.getElementById('privateMessageInput').disabled = true;
                document.getElementById('sendPrivateBtn').disabled = true;
                document.getElementById('connectionId').textContent = '-';
            }
        });

        document.getElementById('sendBtn').addEventListener('click', sendToAll);
        document.getElementById('messageInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                sendToAll();
            }
        });

        function sendToAll() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            
            if (!message || !connection) {
                return;
            }

            connection.invoke("SendToAll", userName, message)
                .catch(err => {
                    console.error('SendToAll error:', err);
                    addMessage('Система', 'Ошибка отправки: ' + err, 'danger');
                });
            
            messageInput.value = '';
        }

        document.getElementById('sendPrivateBtn').addEventListener('click', () => {
            const targetId = document.getElementById('targetConnectionId').value.trim();
            const message = document.getElementById('privateMessageInput').value.trim();
            
            if (!targetId || !message || !connection) {
                alert('Заполните Connection ID и сообщение');
                return;
            }

            connection.invoke("SendToUser", targetId, userName, message)
                .then(() => {
                    addMessage(`Вы (приватно для ${targetId.substring(0, 8)})`, message, 'warning');
                    document.getElementById('privateMessageInput').value = '';
                })
                .catch(err => {
                    console.error('SendToUser error:', err);
                    addMessage('Система', 'Ошибка отправки: ' + err, 'danger');
                });
        });

        function addMessage(sender, message, type) {
            const messagesArea = document.getElementById('messagesArea');
            const messageDiv = document.createElement('div');
            messageDiv.className = `mb-2 p-2 rounded bg-${type === 'success' ? 'success' : type === 'danger' ? 'danger' : type === 'warning' ? 'warning' : type === 'info' ? 'info' : 'light'} text-${type === 'success' || type === 'danger' || type === 'warning' || type === 'info' ? 'white' : 'dark'}`;
            messageDiv.innerHTML = `<strong>${sender}:</strong> ${message}`;
            messagesArea.appendChild(messageDiv);
            messagesArea.scrollTop = messagesArea.scrollHeight;

            const initialMsg = messagesArea.querySelector('p.text-muted');
            if (initialMsg) {
                initialMsg.remove();
            }
        }

        function updateConnectionStatus(connected) {
            const statusBadge = document.getElementById('connectionStatus');
            if (connected) {
                statusBadge.textContent = 'Подключен';
                statusBadge.className = 'badge bg-success';
            } else {
                statusBadge.textContent = 'Отключен';
                statusBadge.className = 'badge bg-secondary';
            }
        }

        function updateUsersList() {
            const usersList = document.getElementById('usersList');
            if (connectionId) {
                usersList.innerHTML = `<div class="small">Ваш ID: <code>${connectionId.substring(0, 8)}...</code></div>`;
            }
        }
    </script>
}

            <h2>Решение задачи</h2>

            <section class="mb-5">
                <h3>1. Регистрация HttpClient в Program.cs</h3>
                <div class="code-block">
                    <pre><code>builder.Services.AddHttpClient&lt;IExternalApiService, ExternalApiService&gt;(client =>
{
    client.BaseAddress = new Uri("https://jsonplaceholder.typicode.com/");
    client.Timeout = TimeSpan.FromSeconds(30);
});

builder.Services.AddScoped&lt;IExternalApiService, ExternalApiService&gt;();</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>2. Интерфейс сервиса</h3>
                <div class="code-block">
                    <pre><code>namespace Asp_Book.Chapter03.Services;

public interface IExternalApiService
{
    Task&lt;string&gt; GetPostAsync(int id);
    Task&lt;string&gt; GetAllPostsAsync();
    Task&lt;string&gt; CreatePostAsync(string title, string body, int userId);
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>3. Реализация сервиса</h3>
                <div class="code-block">
                    <pre><code>using System.Text;
using System.Text.Json;

public class ExternalApiService : IExternalApiService
{
    private readonly IHttpClientFactory _httpClientFactory;
    private readonly ILogger&lt;ExternalApiService&gt; _logger;

    public ExternalApiService(IHttpClientFactory httpClientFactory, ILogger&lt;ExternalApiService&gt; logger)
    {
        _httpClientFactory = httpClientFactory;
        _logger = logger;
    }

    public async Task&lt;string&gt; GetPostAsync(int id)
    {
        var client = _httpClientFactory.CreateClient("ExternalAPI");
        
        try
        {
            var response = await client.GetAsync($"posts/{id}");
            response.EnsureSuccessStatusCode();
            return await response.Content.ReadAsStringAsync();
        }
        catch (HttpRequestException ex)
        {
            _logger.LogError(ex, "Ошибка при запросе к внешнему API");
            throw;
        }
    }

    public async Task&lt;string&gt; CreatePostAsync(string title, string body, int userId)
    {
        var client = _httpClientFactory.CreateClient("ExternalAPI");
        
        try
        {
            var post = new { title, body, userId };
            var json = JsonSerializer.Serialize(post);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            var response = await client.PostAsync("posts", content);
            response.EnsureSuccessStatusCode();
            return await response.Content.ReadAsStringAsync();
        }
        catch (HttpRequestException ex)
        {
            _logger.LogError(ex, "Ошибка при создании поста");
            throw;
        }
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>4. Использование в контроллере</h3>
                <div class="code-block">
                    <pre><code>[ApiController]
[Route("api/[controller]")]
public class HttpClientController : ControllerBase
{
    private readonly IExternalApiService _externalApiService;

    public HttpClientController(IExternalApiService externalApiService)
    {
        _externalApiService = externalApiService;
    }

    [HttpGet("post/{id}")]
    public async Task&lt;IActionResult&gt; GetPost(int id)
    {
        try
        {
            var result = await _externalApiService.GetPostAsync(id);
            return Ok(JsonSerializer.Deserialize&lt;object&gt;(result));
        }
        catch (Exception ex)
        {
            return StatusCode(500, new { error = ex.Message });
        }
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>6. Клиентский код — Blazor (компонент)</h3>
                <p><strong>Blazor</strong> — фреймворк от Microsoft для создания интерактивного UI на C# (без JavaScript). WebSocket в Blazor подключается так же через <code>ClientWebSocket</code>, но оборачивается в компонент:</p>

                <h4>Установка пакета (для Blazor WebAssembly)</h4>
                <div class="code-block">
                    <pre><code># Blazor WebAssembly уже содержит System.Net.WebSockets
# Для Blazor Server — ничего устанавливать не нужно, всё встроено</code></pre>
                </div>

                <h4>Компонент WebSocketChat.razor</h4>
                <div class="code-block">
                    <pre><code>@@using System.Net.WebSockets
@@using System.Text
@@implements IAsyncDisposable

&lt;h3&gt;WebSocket чат (Blazor)&lt;/h3&gt;

&lt;div class="mb-3"&gt;
    &lt;input @@bind="userName" placeholder="Ваше имя" class="form-control" /&gt;
&lt;/div&gt;

@@if (!isConnected)
{
    &lt;button class="btn btn-success" @@onclick="Connect"&gt;Подключиться&lt;/button&gt;
}
else
{
    &lt;button class="btn btn-danger" @@onclick="Disconnect"&gt;Отключиться&lt;/button&gt;
    
    &lt;div class="mt-3 border rounded p-3" 
         style="height: 300px; overflow-y: auto; background: #1e1e1e; color: #fff;"&gt;
        @@foreach (var msg in messages)
        {
            &lt;div&gt;@@msg&lt;/div&gt;
        }
    &lt;/div&gt;

    &lt;div class="input-group mt-2"&gt;
        &lt;input @@bind="currentMessage" 
               @@onkeydown="HandleKeyDown"
               placeholder="Сообщение..." 
               class="form-control" /&gt;
        &lt;button class="btn btn-primary" @@onclick="SendMessage"&gt;
            Отправить
        &lt;/button&gt;
    &lt;/div&gt;
}

&lt;div class="mt-2"&gt;
    &lt;span class="badge @@(isConnected ? "bg-success" : "bg-secondary")"&gt;
        @@(isConnected ? "Подключён" : "Отключён")
    &lt;/span&gt;
&lt;/div&gt;

@@code {
    private ClientWebSocket? ws;
    private string userName = "";
    private string currentMessage = "";
    private bool isConnected = false;
    private List&lt;string&gt; messages = new();
    private CancellationTokenSource cts = new();

    private async Task Connect()
    {
        if (string.IsNullOrWhiteSpace(userName)) return;

        ws = new ClientWebSocket();

        // Определяем URL (в Blazor Server используем NavigationManager)
        var uri = new Uri("ws://localhost:5009/ws");

        try
        {
            await ws.ConnectAsync(uri, cts.Token);
            isConnected = true;
            messages.Add("✅ Подключено к серверу");

            // Запускаем фоновое чтение сообщений
            _ = ReceiveLoop();
        }
        catch (Exception ex)
        {
            messages.Add($"❌ Ошибка подключения: {ex.Message}");
        }

        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (ws?.State != WebSocketState.Open || 
            string.IsNullOrWhiteSpace(currentMessage))
            return;

        var text = $"{userName}: {currentMessage}";
        var bytes = Encoding.UTF8.GetBytes(text);

        await ws.SendAsync(
            new ArraySegment&lt;byte&gt;(bytes),
            WebSocketMessageType.Text,
            endOfMessage: true,
            cts.Token);

        currentMessage = "";
        StateHasChanged();
    }

    private async Task ReceiveLoop()
    {
        var buffer = new byte[1024 * 4];

        try
        {
            while (ws?.State == WebSocketState.Open)
            {
                var result = await ws.ReceiveAsync(
                    new ArraySegment&lt;byte&gt;(buffer), 
                    cts.Token);

                if (result.MessageType == WebSocketMessageType.Close)
                {
                    messages.Add("🔌 Сервер закрыл соединение");
                    break;
                }

                var msg = Encoding.UTF8.GetString(
                    buffer, 0, result.Count);
                messages.Add(msg);

                // Обновляем UI из фонового потока
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Отмена — нормальное поведение при Disconnect
        }
        catch (Exception ex)
        {
            messages.Add($"❌ Ошибка: {ex.Message}");
            await InvokeAsync(StateHasChanged);
        }

        isConnected = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendMessage();
    }

    private async Task Disconnect()
    {
        if (ws?.State == WebSocketState.Open)
        {
            await ws.CloseAsync(
                WebSocketCloseStatus.NormalClosure,
                "Выход", cts.Token);
        }

        isConnected = false;
        messages.Add("🔌 Отключено");
        StateHasChanged();
    }

    // IAsyncDisposable — корректная очистка при уничтожении компонента
    public async ValueTask DisposeAsync()
    {
        cts.Cancel();
        if (ws?.State == WebSocketState.Open)
        {
            await ws.CloseAsync(
                WebSocketCloseStatus.NormalClosure,
                "Компонент уничтожен",
                CancellationToken.None);
        }
        ws?.Dispose();
        cts.Dispose();
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Ключевые моменты Blazor + WebSocket:</strong>
                        <table class="table table-striped table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Элемент</th>
                                    <th>Зачем нужен</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>&#64;implements IAsyncDisposable</code></td>
                                    <td>Корректно закрывает WebSocket при уходе со страницы</td>
                                </tr>
                                <tr>
                                    <td><code>CancellationTokenSource</code></td>
                                    <td>Отменяет фоновые операции при отключении</td>
                                </tr>
                                <tr>
                                    <td><code>InvokeAsync(StateHasChanged)</code></td>
                                    <td>Обновляет UI из фонового потока (ReceiveLoop)</td>
                                </tr>
                                <tr>
                                    <td><code>_ = ReceiveLoop()</code></td>
                                    <td>Запускает бесконечный цикл чтения без await (fire-and-forget)</td>
                                </tr>
                                <tr>
                                    <td><code>&#64;bind</code></td>
                                    <td>Двусторонняя привязка данных (вместо document.getElementById)</td>
                                </tr>
                                <tr>
                                    <td><code>&#64;onclick</code></td>
                                    <td>Обработка событий на C# (вместо addEventListener)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

@section Scripts {
    <script>
        var triggerTabList = [].slice.call(document.querySelectorAll('#chapterTabs button'))
        triggerTabList.forEach(function (triggerEl) {
            var tabTrigger = new bootstrap.Tab(triggerEl)
        })

        const API_URL = '/api/Auth';
        let accessToken = null;
        let refreshToken = null;
        let accessTokenExpires = null;
        let refreshTokenExpires = null;
        let accessTokenTimerInterval = null;
        let refreshTokenTimerInterval = null;

        // Обработка токенов после успешного входа/регистрации
        function handleAuthSuccess(result) {
            accessToken = result.accessToken;
            refreshToken = result.refreshToken;
            accessTokenExpires = new Date(result.accessTokenExpires);
            refreshTokenExpires = new Date(result.refreshTokenExpires);

            document.getElementById('accessTokenDisplay').value = accessToken;
            document.getElementById('refreshTokenDisplay').value = refreshToken;
            document.getElementById('currentUser').textContent = result.username;
            document.getElementById('currentRole').textContent = result.role;
            document.getElementById('refreshTokenBtn').disabled = false;
            document.getElementById('revokeTokenBtn').disabled = false;
            document.getElementById('testApiBtn').disabled = false;

            startTimers();
        }

        // Регистрация
        document.getElementById('registerForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = {
                username: document.getElementById('regUsername').value,
                email: document.getElementById('regEmail').value,
                password: document.getElementById('regPassword').value
            };

            try {
                const response = await fetch(`${API_URL}/register`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                if (response.ok) {
                    handleAuthSuccess(result);
                    // Автозаполнение формы входа
                    document.getElementById('loginUsername').value = data.username;
                    document.getElementById('loginPassword').value = data.password;
                    showRegisterStatus('Регистрация успешна! Токены получены.', 'success');
                    showStatus('Вы вошли как ' + result.username, 'success');
                } else {
                    showRegisterStatus('Ошибка: ' + (result.message || 'Ошибка регистрации'), 'danger');
                }
            } catch (error) {
                showRegisterStatus('Ошибка: ' + error.message, 'danger');
            }
        });

        // Вход
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = {
                username: document.getElementById('loginUsername').value,
                password: document.getElementById('loginPassword').value
            };

            try {
                const response = await fetch(`${API_URL}/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                if (response.ok) {
                    handleAuthSuccess(result);
                    showStatus('Вход выполнен! Токены получены.', 'success');
                } else {
                    showStatus('Ошибка: ' + (result.message || 'Неверные учетные данные'), 'danger');
                }
            } catch (error) {
                showStatus('Ошибка: ' + error.message, 'danger');
            }
        });

        // Обновление токена
        document.getElementById('refreshTokenBtn').addEventListener('click', async () => {
            if (!refreshToken) {
                showStatus('Сначала войдите в систему', 'warning');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/refresh`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ refreshToken: refreshToken })
                });

                const result = await response.json();
                if (response.ok) {
                    handleAuthSuccess(result);
                    showStatus('Access Token успешно обновлён!', 'success');
                } else {
                    showStatus('Ошибка обновления: ' + (result.message || 'Refresh Token недействителен'), 'danger');
                }
            } catch (error) {
                showStatus('Ошибка: ' + error.message, 'danger');
            }
        });

        // Отзыв Refresh Token
        document.getElementById('revokeTokenBtn').addEventListener('click', async () => {
            if (!refreshToken) {
                showStatus('Нет Refresh Token для отзыва', 'warning');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/revoke`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ refreshToken: refreshToken })
                });

                const result = await response.json();
                if (response.ok) {
                    refreshToken = null;
                    document.getElementById('refreshTokenDisplay').value = '(отозван)';
                    document.getElementById('refreshTokenBtn').disabled = true;
                    document.getElementById('revokeTokenBtn').disabled = true;
                    document.getElementById('refreshTokenTimer').textContent = 'Отозван';
                    document.getElementById('refreshTokenTimer').className = 'fw-bold text-danger';
                    showStatus('Refresh Token отозван! Обновление токена теперь невозможно.', 'warning');
                } else {
                    showStatus('Ошибка: ' + (result.message || 'Не удалось отозвать'), 'danger');
                }
            } catch (error) {
                showStatus('Ошибка: ' + error.message, 'danger');
            }
        });

        // Тестирование защищённого API
        document.getElementById('testApiBtn').addEventListener('click', async () => {
            if (!accessToken) {
                showStatus('Сначала войдите в систему', 'warning');
                return;
            }

            const resultDiv = document.getElementById('apiResult');

            try {
                const response = await fetch('/api/Protected/data', {
                    headers: {
                        'Authorization': `Bearer ${accessToken}`
                    }
                });

                if (response.ok) {
                    const result = await response.json();
                    resultDiv.innerHTML = `<div class="alert alert-success"><strong>Успешно (200 OK):</strong><pre class="mb-0 mt-1" style="color: inherit; background: transparent; border: none; padding: 0;">${JSON.stringify(result, null, 2)}</pre></div>`;
                } else if (response.status === 401) {
                    resultDiv.innerHTML = `<div class="alert alert-warning"><strong>401 Unauthorized</strong> — Access Token истёк!<br>Нажмите «Обновить Access Token» для получения нового.</div>`;
                } else {
                    const result = await response.json();
                    resultDiv.innerHTML = `<div class="alert alert-danger"><strong>Ошибка ${response.status}:</strong> ${result.message || 'Неизвестная ошибка'}</div>`;
                }
            } catch (error) {
                resultDiv.innerHTML = `<div class="alert alert-danger"><strong>Ошибка:</strong> ${error.message}</div>`;
            }
        });

        // Запуск таймеров
        function startTimers() {
            if (accessTokenTimerInterval) clearInterval(accessTokenTimerInterval);
            if (refreshTokenTimerInterval) clearInterval(refreshTokenTimerInterval);

            accessTokenTimerInterval = setInterval(() => {
                if (accessTokenExpires) {
                    const now = new Date();
                    const diff = accessTokenExpires - now;
                    const el = document.getElementById('accessTokenTimer');
                    if (diff > 0) {
                        const minutes = Math.floor(diff / 60000);
                        const seconds = Math.floor((diff % 60000) / 1000);
                        el.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                        el.className = diff < 60000 ? 'fw-bold text-danger' : 'fw-bold text-success';
                    } else {
                        el.textContent = 'Истёк';
                        el.className = 'fw-bold text-danger';
                    }
                }
            }, 1000);

            refreshTokenTimerInterval = setInterval(() => {
                if (refreshTokenExpires) {
                    const now = new Date();
                    const diff = refreshTokenExpires - now;
                    const el = document.getElementById('refreshTokenTimer');
                    if (diff > 0) {
                        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        el.textContent = `${days}д ${hours}ч`;
                        el.className = 'fw-bold text-success';
                    } else {
                        el.textContent = 'Истёк';
                        el.className = 'fw-bold text-danger';
                    }
                }
            }, 1000);
        }

        function showStatus(text, type) {
            const statusDiv = document.getElementById('tokenStatus');
            statusDiv.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show py-2" role="alert">
                ${text}
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>`;
            setTimeout(() => { statusDiv.innerHTML = ''; }, 5000);
        }

        function showRegisterStatus(text, type) {
            const statusDiv = document.getElementById('registerStatus');
            statusDiv.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show py-2" role="alert">
                ${text}
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>`;
            setTimeout(() => { statusDiv.innerHTML = ''; }, 5000);
        }
    </script>
}

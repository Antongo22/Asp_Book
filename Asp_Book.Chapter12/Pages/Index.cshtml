            <section class="mb-5">
                <h3>4. CalculatorControllerTests.cs — основные тесты [Fact]</h3>
                <p>Тесты каждой операции по отдельности:</p>
                <div class="code-block">
                    <pre><code>using Asp_Book.Chapter01.Controllers;
using Microsoft.AspNetCore.Mvc;
using System.Text.Json;
using Xunit;

namespace Asp_Book.Chapter01.Tests;

public class CalculatorControllerTests
{
    // Создаём контроллер — нет зависимостей, просто new
    private readonly CalculatorController _controller = new();

    // Вспомогательный метод: извлечь значение из анонимного объекта
    // Контроллер возвращает Ok(new { result = ..., operation = "..." })
    // OkObjectResult.Value — это анонимный объект, его удобно читать через JSON
    private T GetPropertyFromResult&lt;T&gt;(IActionResult actionResult, string propertyName)
    {
        var okResult = Assert.IsType&lt;OkObjectResult&gt;(actionResult);
        var json = JsonSerializer.Serialize(okResult.Value);
        var doc = JsonDocument.Parse(json);
        var prop = doc.RootElement.GetProperty(propertyName);
        
        if (typeof(T) == typeof(double))
            return (T)(object)prop.GetDouble();
        if (typeof(T) == typeof(string))
            return (T)(object)prop.GetString()!;
        
        return JsonSerializer.Deserialize&lt;T&gt;(prop.GetRawText())!;
    }

    // ========== Тесты сложения (Add) ==========

    [Fact]
    public void Add_TwoPositiveNumbers_ReturnsCorrectSum()
    {
        // Arrange
        var request = new CalculationRequest { A = 5, B = 3 };

        // Act
        var result = _controller.Add(request);

        // Assert
        Assert.IsType&lt;OkObjectResult&gt;(result);        // HTTP 200
        var sum = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(8, sum);                           // 5 + 3 = 8

        var operation = GetPropertyFromResult&lt;string&gt;(result, "operation");
        Assert.Equal("add", operation);                 // Операция = "add"
    }

    [Fact]
    public void Add_NegativeNumbers_ReturnsCorrectSum()
    {
        // Arrange
        var request = new CalculationRequest { A = -10, B = -5 };

        // Act
        var result = _controller.Add(request);

        // Assert
        var sum = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(-15, sum);  // -10 + (-5) = -15
    }

    [Fact]
    public void Add_ZeroAndNumber_ReturnsNumber()
    {
        // Arrange
        var request = new CalculationRequest { A = 0, B = 42 };

        // Act
        var result = _controller.Add(request);

        // Assert
        var sum = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(42, sum);  // 0 + 42 = 42
    }

    // ========== Тесты вычитания (Subtract) ==========

    [Fact]
    public void Subtract_TwoNumbers_ReturnsCorrectDifference()
    {
        // Arrange
        var request = new CalculationRequest { A = 10, B = 3 };

        // Act
        var result = _controller.Subtract(request);

        // Assert
        Assert.IsType&lt;OkObjectResult&gt;(result);
        var diff = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(7, diff);  // 10 - 3 = 7

        var operation = GetPropertyFromResult&lt;string&gt;(result, "operation");
        Assert.Equal("subtract", operation);
    }

    [Fact]
    public void Subtract_SameNumbers_ReturnsZero()
    {
        // Arrange
        var request = new CalculationRequest { A = 5, B = 5 };

        // Act
        var result = _controller.Subtract(request);

        // Assert
        var diff = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(0, diff);  // 5 - 5 = 0
    }

    // ========== Тесты умножения (Multiply) ==========

    [Fact]
    public void Multiply_TwoNumbers_ReturnsCorrectProduct()
    {
        // Arrange
        var request = new CalculationRequest { A = 4, B = 7 };

        // Act
        var result = _controller.Multiply(request);

        // Assert
        Assert.IsType&lt;OkObjectResult&gt;(result);
        var product = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(28, product);  // 4 * 7 = 28

        var operation = GetPropertyFromResult&lt;string&gt;(result, "operation");
        Assert.Equal("multiply", operation);
    }

    [Fact]
    public void Multiply_ByZero_ReturnsZero()
    {
        // Arrange
        var request = new CalculationRequest { A = 999, B = 0 };

        // Act
        var result = _controller.Multiply(request);

        // Assert
        var product = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(0, product);  // 999 * 0 = 0
    }

    [Fact]
    public void Multiply_NegativeByNegative_ReturnsPositive()
    {
        // Arrange
        var request = new CalculationRequest { A = -3, B = -4 };

        // Act
        var result = _controller.Multiply(request);

        // Assert
        var product = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(12, product);  // (-3) * (-4) = 12
    }

    // ========== Тесты деления (Divide) ==========

    [Fact]
    public void Divide_TwoNumbers_ReturnsCorrectQuotient()
    {
        // Arrange
        var request = new CalculationRequest { A = 10, B = 2 };

        // Act
        var result = _controller.Divide(request);

        // Assert
        Assert.IsType&lt;OkObjectResult&gt;(result);
        var quotient = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(5, quotient);  // 10 / 2 = 5

        var operation = GetPropertyFromResult&lt;string&gt;(result, "operation");
        Assert.Equal("divide", operation);
    }

    [Fact]
    public void Divide_ByZero_ReturnsBadRequest()
    {
        // Arrange
        var request = new CalculationRequest { A = 10, B = 0 };

        // Act
        var result = _controller.Divide(request);

        // Assert — ожидаем BadRequest, а не OkObjectResult!
        var badResult = Assert.IsType&lt;BadRequestObjectResult&gt;(result);
        Assert.NotNull(badResult.Value);  // Есть сообщение об ошибке
    }

    [Fact]
    public void Divide_FractionalResult_ReturnsCorrectValue()
    {
        // Arrange
        var request = new CalculationRequest { A = 7, B = 2 };

        // Act
        var result = _controller.Divide(request);

        // Assert
        var quotient = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(3.5, quotient);  // 7 / 2 = 3.5
    }

    [Fact]
    public void Divide_ZeroByNumber_ReturnsZero()
    {
        // Arrange
        var request = new CalculationRequest { A = 0, B = 5 };

        // Act
        var result = _controller.Divide(request);

        // Assert
        var quotient = GetPropertyFromResult&lt;double&gt;(result, "result");
        Assert.Equal(0, quotient);  // 0 / 5 = 0
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Что покрывают 13 тестов [Fact]:</strong>
                        <table class="table table-striped table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Операция</th>
                                    <th>Тесты</th>
                                    <th>Что проверяем</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>Add</code></td>
                                    <td>3 теста</td>
                                    <td>Положительные числа, отрицательные, ноль</td>
                                </tr>
                                <tr>
                                    <td><code>Subtract</code></td>
                                    <td>2 теста</td>
                                    <td>Обычное вычитание, одинаковые числа</td>
                                </tr>
                                <tr>
                                    <td><code>Multiply</code></td>
                                    <td>3 теста</td>
                                    <td>Обычное умножение, на ноль, два отрицательных</td>
                                </tr>
                                <tr>
                                    <td><code>Divide</code></td>
                                    <td>4 теста</td>
                                    <td>Обычное деление, на ноль (BadRequest), дробный результат, ноль делить на число</td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="mt-2"><strong>Ключевой момент:</strong> Контроллер возвращает <strong>анонимный объект</strong> <code>new { result, operation }</code>. Чтобы проверить его свойства в тестах, мы сериализуем <code>OkObjectResult.Value</code> в JSON и извлекаем нужные значения через <code>JsonDocument</code>.</p>

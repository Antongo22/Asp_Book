            <h2>Теория</h2>

            <section class="mb-5">
                <h3>Глобальный обработчик ошибок</h3>
                <p>Глобальный обработчик ошибок перехватывает все необработанные исключения в приложении и возвращает пользователю понятный ответ.</p>

                <div class="code-block">
                    <pre><code>public class GlobalExceptionHandlerMiddleware
{
    private readonly RequestDelegate _next;
    private readonly ILogger&lt;GlobalExceptionHandlerMiddleware&gt; _logger;

    public async Task InvokeAsync(HttpContext context)
    {
        try
        {
            await _next(context);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Необработанное исключение");
            await HandleExceptionAsync(context, ex);
        }
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Объяснение:</strong> Middleware перехватывает исключения, логирует их и возвращает JSON ответ с информацией об ошибке.
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Кастомный Middleware</h3>
                <p>Middleware позволяет добавить логику обработки запросов и ответов в конвейер ASP.NET Core.</p>

                <div class="code-block">
                    <pre><code>public class RequestLoggingMiddleware
{
    private readonly RequestDelegate _next;
    private readonly ILogger&lt;RequestLoggingMiddleware&gt; _logger;

    public async Task InvokeAsync(HttpContext context)
    {
        var startTime = DateTime.UtcNow;
        _logger.LogInformation("Входящий запрос: {Method} {Path}", 
            context.Request.Method, context.Request.Path);
        
        await _next(context);
        
        var duration = DateTime.UtcNow - startTime;
        _logger.LogInformation("Запрос завершен за {Duration}ms", 
            duration.TotalMilliseconds);
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>Задача: Создать middleware для логирования</h3>
                <div class="alert alert-warning">
                    <h5>Ваша задача:</h5>
                    <p>Создайте middleware, который логирует:</p>
                    <ul>
                        <li>Метод HTTP запроса</li>
                        <li>Путь запроса</li>
                        <li>Время выполнения запроса</li>
                        <li>Статус код ответа</li>
                    </ul>
                </div>
            </section>
        </div>

        <div class="tab-pane fade" id="answers" role="tabpanel">
            <h2>Решение задачи</h2>

            <section class="mb-5">
                <h3>1. RequestLoggingMiddleware</h3>
                <div class="code-block">
                    <pre><code>namespace Asp_Book.Chapter04.Middleware;

public class RequestLoggingMiddleware
{
    private readonly RequestDelegate _next;
    private readonly ILogger&lt;RequestLoggingMiddleware&gt; _logger;

    public RequestLoggingMiddleware(RequestDelegate next, ILogger&lt;RequestLoggingMiddleware&gt; logger)
    {
        _next = next;
        _logger = logger;
    }

    public async Task InvokeAsync(HttpContext context)
    {
        var startTime = DateTime.UtcNow;

        _logger.LogInformation(
            "Входящий запрос: {Method} {Path}",
            context.Request.Method,
            context.Request.Path);

        try
        {
            await _next(context);
        }
        finally
        {
            var duration = DateTime.UtcNow - startTime;
            _logger.LogInformation(
                "Запрос завершен: {Method} {Path} - Статус: {StatusCode} - Время: {Duration}ms",
                context.Request.Method,
                context.Request.Path,
                context.Response.StatusCode,
                duration.TotalMilliseconds);
        }
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>2. GlobalExceptionHandlerMiddleware</h3>
                <div class="code-block">
                    <pre><code>using System.Net;
using System.Text.Json;

public class GlobalExceptionHandlerMiddleware
{
    private readonly RequestDelegate _next;
    private readonly ILogger&lt;GlobalExceptionHandlerMiddleware&gt; _logger;

    public GlobalExceptionHandlerMiddleware(RequestDelegate next, ILogger&lt;GlobalExceptionHandlerMiddleware&gt; logger)
    {
        _next = next;
        _logger = logger;
    }

    public async Task InvokeAsync(HttpContext context)
    {
        try
        {
            await _next(context);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Необработанное исключение: {Message}", ex.Message);
            await HandleExceptionAsync(context, ex);
        }
    }

    private static Task HandleExceptionAsync(HttpContext context, Exception exception)
    {
        context.Response.ContentType = "application/json";
        context.Response.StatusCode = (int)HttpStatusCode.InternalServerError;

        var response = new
        {
            error = new
            {
                message = "Произошла внутренняя ошибка сервера",
                details = exception.Message
            }
        };

        var json = JsonSerializer.Serialize(response);
        return context.Response.WriteAsync(json);
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>3. Регистрация в Program.cs</h3>
                <div class="code-block">
                    <pre><code>using Asp_Book.Chapter04.Middleware;

var app = builder.Build();

// Глобальный обработчик ошибок должен быть первым
app.UseMiddleware&lt;GlobalExceptionHandlerMiddleware&gt;();

// Логирование запросов
app.UseMiddleware&lt;RequestLoggingMiddleware&gt;();

app.UseRouting();
app.UseAuthorization();</code></pre>
                </div>

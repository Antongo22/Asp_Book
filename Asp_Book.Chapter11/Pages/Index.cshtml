@page
@model IndexModel
@{
    ViewData["Title"] = "Глава 11: Авторизация с SignalR и WebSockets";
}

<div class="container-fluid">
    <h1 class="mb-4">Глава 11: Авторизация с SignalR и WebSockets</h1>

    <ul class="nav nav-tabs mb-4" id="chapterTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="theory-tab" data-bs-toggle="tab" data-bs-target="#theory" type="button" role="tab">
                Теория и Демонстрация
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="answers-tab" data-bs-toggle="tab" data-bs-target="#answers" type="button" role="tab">
                Ответы
            </button>
        </li>
    </ul>

    <div class="tab-content" id="chapterTabsContent">
        <div class="tab-pane fade show active" id="theory" role="tabpanel">
            <h2>Теория</h2>

            <section class="mb-5">
                <h3>Авторизация в SignalR</h3>
                <p>SignalR поддерживает авторизацию через атрибут <code>[Authorize]</code> на Hub классе или методах.</p>
                
                <h4>Способы авторизации:</h4>
                <ul>
                    <li><strong>На уровне Hub:</strong> <code>[Authorize]</code> на классе Hub</li>
                    <li><strong>На уровне метода:</strong> <code>[Authorize(Roles = "Admin")]</code> на конкретном методе</li>
                    <li><strong>Передача токена:</strong> Через query параметр <code>access_token</code></li>
                </ul>
            </section>

            <section class="mb-5">
                <h3>Демонстрация: Авторизованный чат</h3>
                <p>Попробуйте войти и использовать авторизованный SignalR чат:</p>

                <div class="row mt-3">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Авторизация</h5>
                            </div>
                            <div class="card-body">
                                <form id="tokenForm">
                                    <div class="mb-3">
                                        <textarea id="jwtTokenInput" class="form-control" rows="4" placeholder="Вставьте JWT access token" required></textarea>
                                        <small class="text-muted">Токен сохраняется локально в браузере.</small>
                                    </div>
                                    <button type="submit" class="btn btn-success w-100">Сохранить токен</button>
                                </form>
                                <div class="mt-3">
                                    <button class="btn btn-danger w-100" id="logoutBtn" disabled>Выйти</button>
                                </div>
                                <div class="mt-3">
                                    <small class="text-muted">Пользователь: <span id="currentUser">-</span></small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Авторизованный SignalR чат</h5>
                                <span id="connectionStatus" class="badge bg-secondary">Отключен</span>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <button class="btn btn-success" id="connectBtn" disabled>Подключиться к чату</button>
                                    <button class="btn btn-danger" id="disconnectBtn" disabled>Отключиться</button>
                                </div>
                                <div class="mb-3">
                                    <div id="messagesArea" class="border rounded p-3" style="height: 300px; overflow-y: auto; background-color: #f8f9fa;">
                                        <p class="text-muted text-center">Сообщения будут отображаться здесь</p>
                                    </div>
                                </div>
                                <div class="input-group">
                                    <input type="text" id="messageInput" class="form-control" placeholder="Введите сообщение..." disabled />
                                    <button class="btn btn-primary" id="sendBtn" disabled>Отправить</button>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">Ваш Connection ID: <span id="connectionId">-</span></small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-3">
                    <strong>Инструкция:</strong>
                    <ol>
                        <li>Получите JWT access token (например, из сервиса авторизации предыдущих глав)</li>
                        <li>Вставьте токен в поле "Авторизация" и нажмите "Сохранить токен"</li>
                        <li>Отправляйте сообщения - они будут видны всем авторизованным пользователям</li>
                        <li>Попробуйте подключиться без авторизации - соединение будет отклонено</li>
                    </ol>
                </div>
            </section>

            <section class="mb-5">
                <h3>Задача: Реализовать авторизацию</h3>
                <div class="alert alert-warning">
                    <h5>Ваша задача:</h5>
                    <p>Изучите реализацию авторизации в SignalR и WebSockets:</p>
                    <ul>
                        <li>Как защитить SignalR Hub авторизацией?</li>
                        <li>Как передать JWT токен в SignalR?</li>
                        <li>Как авторизовать WebSocket соединение?</li>
                    </ul>
                </div>
            </section>
        </div>

        <div class="tab-pane fade" id="answers" role="tabpanel">
            <h2>Решение: Авторизация с SignalR и WebSockets</h2>

            <section class="mb-5">
                <h3>1. SignalR Hub с авторизацией</h3>
                <div class="code-block">
                    <pre><code>using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.SignalR;

[Authorize] // Требует авторизации для подключения
public class AuthorizedChatHub : Hub
{
    public async Task SendToAll(string message)
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.All.SendAsync("ReceiveMessage", username, message);
    }

    [Authorize(Roles = "Admin")] // Только для администраторов
    public async Task SendToAdmins(string message)
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.Group("Admins").SendAsync("ReceiveAdminMessage", username, message);
    }

    public override async Task OnConnectedAsync()
    {
        // Добавление в группу по роли
        if (Context.User?.IsInRole("Admin") == true)
        {
            await Groups.AddToGroupAsync(Context.ConnectionId, "Admins");
        }
        await base.OnConnectedAsync();
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>2. Настройка JWT для SignalR в Program.cs</h3>
                <div class="code-block">
                    <pre><code>.AddJwtBearer(options =>
{
    options.TokenValidationParameters = new TokenValidationParameters
    {
        // ... параметры валидации
    };

    // Настройка для SignalR - получение токена из query
    options.Events = new JwtBearerEvents
    {
        OnMessageReceived = context =>
        {
            var accessToken = context.Request.Query["access_token"];
            var path = context.HttpContext.Request.Path;
            if (!string.IsNullOrEmpty(accessToken) && path.StartsWithSegments("/chathub"))
            {
                context.Token = accessToken;
            }
            return Task.CompletedTask;
        }
    };
});</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>3. Клиентский код с токеном</h3>
                <div class="code-block">
                    <pre><code>const token = localStorage.getItem('accessToken');
const connection = new signalR.HubConnectionBuilder()
    .withUrl("/authorizedchathub", {
        accessTokenFactory: () => token // Передача токена
    })
    .build();

connection.start().then(() => {
    console.log('Подключено с авторизацией');
});</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>4. WebSocket с авторизацией</h3>
                <div class="code-block">
                    <pre><code>public async Task InvokeAsync(HttpContext context)
{
    if (context.WebSockets.IsWebSocketRequest)
    {
        // Получение токена из query
        var token = context.Request.Query["access_token"].ToString();
        if (string.IsNullOrEmpty(token))
        {
            context.Response.StatusCode = 401;
            return;
        }

        // Валидация токена (упрощенно)
        // В реальном приложении используйте JwtSecurityTokenHandler
        
        var webSocket = await context.WebSockets.AcceptWebSocketAsync();
        // ... обработка WebSocket
    }
}</code></pre>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script>
        var triggerTabList = [].slice.call(document.querySelectorAll('#chapterTabs button'))
        triggerTabList.forEach(function (triggerEl) {
            var tabTrigger = new bootstrap.Tab(triggerEl)
        })

        const TOKEN_STORAGE_KEY = 'chapter11_jwt_token';
        let connection = null;
        let currentToken = null;
        let currentUsername = '';

        // Сохранение токена
        document.getElementById('tokenForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const token = document.getElementById('jwtTokenInput').value.trim();
            if (!token) {
                addMessage('Система', 'Вставьте JWT токен', 'warning');
                return;
            }

            const payload = parseJwtPayload(token);
            if (!payload) {
                addMessage('Система', 'Некорректный JWT токен', 'danger');
                return;
            }

            currentToken = token;
            currentUsername = payload.unique_name || payload.name || payload.sub || payload.email || 'Пользователь';
            localStorage.setItem(TOKEN_STORAGE_KEY, currentToken);

            document.getElementById('currentUser').textContent = currentUsername;
            document.getElementById('connectBtn').disabled = false;
            document.getElementById('logoutBtn').disabled = false;
            document.getElementById('tokenForm').querySelector('button').textContent = 'Обновить токен';
            addMessage('Система', 'Токен сохранен. Теперь можно подключиться к чату.', 'success');
        });

        // Выход
        document.getElementById('logoutBtn').addEventListener('click', () => {
            if (connection) {
                connection.stop();
                connection = null;
            }
            currentToken = null;
            currentUsername = '';
            localStorage.removeItem(TOKEN_STORAGE_KEY);
            document.getElementById('currentUser').textContent = '-';
            document.getElementById('connectBtn').disabled = true;
            document.getElementById('disconnectBtn').disabled = true;
            document.getElementById('sendBtn').disabled = true;
            document.getElementById('messageInput').disabled = true;
            document.getElementById('logoutBtn').disabled = true;
            document.getElementById('tokenForm').querySelector('button').textContent = 'Сохранить токен';
            document.getElementById('tokenForm').reset();
            updateConnectionStatus(false);
            addMessage('Система', 'Выход выполнен', 'warning');
        });

        // Проверка сохраненного токена
        const savedToken = localStorage.getItem(TOKEN_STORAGE_KEY);
        if (savedToken) {
            const payload = parseJwtPayload(savedToken);
            if (payload) {
                currentToken = savedToken;
                currentUsername = payload.unique_name || payload.name || payload.sub || payload.email || 'Пользователь';
                document.getElementById('jwtTokenInput').value = savedToken;
                document.getElementById('currentUser').textContent = currentUsername;
                document.getElementById('connectBtn').disabled = false;
                document.getElementById('logoutBtn').disabled = false;
                document.getElementById('tokenForm').querySelector('button').textContent = 'Обновить токен';
            } else {
                localStorage.removeItem(TOKEN_STORAGE_KEY);
            }
        }

        // Подключение к SignalR
        document.getElementById('connectBtn').addEventListener('click', () => {
            if (!currentToken) {
                addMessage('Система', 'Сначала сохраните JWT токен', 'warning');
                return;
            }

            connection = new signalR.HubConnectionBuilder()
                .withUrl("/authorizedchathub", {
                    accessTokenFactory: () => currentToken
                })
                .build();

            // Обработка сообщений
            connection.on("ReceiveMessage", (user, message) => {
                addMessage(user, message, 'info');
            });

            // Подключение
            connection.start()
                .then(() => {
                    const connectionId = connection.connectionId;
                    document.getElementById('connectionId').textContent = connectionId ? connectionId.substring(0, 8) + '...' : '-';
                    updateConnectionStatus(true);
                    document.getElementById('connectBtn').disabled = true;
                    document.getElementById('disconnectBtn').disabled = false;
                    document.getElementById('messageInput').disabled = false;
                    document.getElementById('sendBtn').disabled = false;
                    addMessage('Система', 'Подключено к авторизованному чату', 'success');
                })
                .catch(err => {
                    console.error('SignalR connection error:', err);
                    if (err.message && err.message.includes('401')) {
                        addMessage('Система', 'Ошибка авторизации. Токен недействителен. Войдите снова.', 'danger');
                        document.getElementById('logoutBtn').click();
                    } else {
                        addMessage('Система', 'Ошибка подключения: ' + err, 'danger');
                    }
                });
        });

        // Отключение
        document.getElementById('disconnectBtn').addEventListener('click', () => {
            if (connection) {
                connection.stop();
                connection = null;
                updateConnectionStatus(false);
                document.getElementById('connectBtn').disabled = false;
                document.getElementById('disconnectBtn').disabled = true;
                document.getElementById('sendBtn').disabled = true;
                document.getElementById('messageInput').disabled = true;
                document.getElementById('connectionId').textContent = '-';
                addMessage('Система', 'Отключено от чата', 'warning');
            }
        });

        // Отправка сообщения
        document.getElementById('sendBtn').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            
            if (!message || !connection) {
                return;
            }

            connection.invoke("SendToAll", message)
                .catch(err => {
                    console.error('SendToAll error:', err);
                    addMessage('Система', 'Ошибка отправки: ' + err, 'danger');
                });
            
            messageInput.value = '';
        }

        function addMessage(sender, message, type) {
            const messagesArea = document.getElementById('messagesArea');
            const messageDiv = document.createElement('div');
            messageDiv.className = `mb-2 p-2 rounded bg-${type === 'success' ? 'success' : type === 'danger' ? 'danger' : type === 'warning' ? 'warning' : type === 'info' ? 'info' : 'light'} text-${type === 'success' || type === 'danger' || type === 'warning' || type === 'info' ? 'white' : 'dark'}`;
            messageDiv.innerHTML = `<strong>${sender}:</strong> ${message}`;
            messagesArea.appendChild(messageDiv);
            messagesArea.scrollTop = messagesArea.scrollHeight;

            // Удаляем начальное сообщение если оно есть
            const initialMsg = messagesArea.querySelector('p.text-muted');
            if (initialMsg) {
                initialMsg.remove();
            }
        }

        function updateConnectionStatus(connected) {
            const statusBadge = document.getElementById('connectionStatus');
            if (connected) {
                statusBadge.textContent = 'Подключен';
                statusBadge.className = 'badge bg-success';
            } else {
                statusBadge.textContent = 'Отключен';
                statusBadge.className = 'badge bg-secondary';
            }
        }

        function parseJwtPayload(token) {
            const parts = token.split('.');
            if (parts.length !== 3) {
                return null;
            }

            try {
                const payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');
                const padded = payload.padEnd(Math.ceil(payload.length / 4) * 4, '=');
                return JSON.parse(atob(padded));
            } catch {
                return null;
            }
        }
    </script>
}

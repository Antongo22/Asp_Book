            <section class="mb-5">
                <h3>2. Hubs/AuthorizedChatHub.cs</h3>
                <div class="code-block">
                    <pre><code>using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.SignalR;

namespace Asp_Book.Chapter11.Hubs;

[Authorize]  // Требует JWT для подключения
public class AuthorizedChatHub : Hub
{
    // Отправка сообщения ВСЕМ авторизованным пользователям
    public async Task SendToAll(string message)
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.All.SendAsync("ReceiveMessage", username, message);
    }

    // Отправка сообщения конкретному пользователю по ConnectionId
    public async Task SendToUser(string connectionId, string message)
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.Client(connectionId).SendAsync("ReceiveMessage", username, message);
    }

    // Отправка ТОЛЬКО администраторам
    [Authorize(Roles = "Admin")]
    public async Task SendToAdmins(string message)
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.Group("Admins").SendAsync("ReceiveAdminMessage", username, message);
    }

    // При подключении — добавляем Admin в группу "Admins"
    public override async Task OnConnectedAsync()
    {
        var username = Context.User?.Identity?.Name ?? "Unknown";

        if (Context.User?.IsInRole("Admin") == true)
        {
            await Groups.AddToGroupAsync(Context.ConnectionId, "Admins");
        }

        await Clients.All.SendAsync("UserConnected", username);
        await base.OnConnectedAsync();
    }

    // При отключении — убираем из группы
    public override async Task OnDisconnectedAsync(Exception? exception)
    {
        if (Context.User?.IsInRole("Admin") == true)
        {
            await Groups.RemoveFromGroupAsync(Context.ConnectionId, "Admins");
        }

        var username = Context.User?.Identity?.Name ?? "Unknown";
        await Clients.All.SendAsync("UserDisconnected", username);
        await base.OnDisconnectedAsync(exception);
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Ключевые моменты:</strong>
                        <ul>
                            <li><code>[Authorize]</code> на классе — подключение без JWT невозможно (401)</li>
                            <li><code>[Authorize(Roles = "Admin")]</code> на методе — дополнительная проверка роли</li>
                            <li><code>Context.User?.Identity?.Name</code> — имя из JWT claim <code>ClaimTypes.Name</code></li>
                            <li><code>Clients.Client(connectionId)</code> — отправка конкретному клиенту по его Connection ID</li>
                            <li><code>Groups.AddToGroupAsync</code> — добавление в группу SignalR для массовой рассылки</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>3. Controllers/AuthController.cs</h3>
                <p>Контроллер для регистрации и получения JWT токена:</p>
                <div class="code-block">
                    <pre><code>using System.IdentityModel.Tokens.Jwt;
using System.Security.Claims;
using System.Text;
using Microsoft.AspNetCore.Mvc;
using Microsoft.IdentityModel.Tokens;

namespace Asp_Book.Chapter11.Controllers;

[ApiController]
[Route("api/[controller]")]
public class AuthController : ControllerBase
{
    private readonly IConfiguration _config;
    private static readonly List&lt;UserInfo&gt; _users = new();

    public AuthController(IConfiguration config)
    {
        _config = config;
    }

    // POST /api/auth/register
    [HttpPost("register")]
    public IActionResult Register([FromBody] RegisterRequest request)
    {
        if (string.IsNullOrWhiteSpace(request.Username)
            || string.IsNullOrWhiteSpace(request.Password))
            return BadRequest("Имя пользователя и пароль обязательны");

        if (_users.Any(u =&gt; u.Username == request.Username))
            return BadRequest("Пользователь уже существует");

        _users.Add(new UserInfo
        {
            Username = request.Username,
            Password = request.Password,
            Role = request.Role ?? "User"
        });

        return Ok(new { Message = $"Пользователь {request.Username} " +
            $"зарегистрирован с ролью {request.Role ?? "User"}" });
    }

    // POST /api/auth/login
    [HttpPost("login")]
    public IActionResult Login([FromBody] LoginRequest request)
    {
        var user = _users.FirstOrDefault(u =&gt;
            u.Username == request.Username &amp;&amp; u.Password == request.Password);

        if (user == null)
            return Unauthorized("Неверные учётные данные");

        var token = GenerateJwtToken(user);
        return Ok(new { AccessToken = token, Username = user.Username, Role = user.Role });
    }

    private string GenerateJwtToken(UserInfo user)
    {
        var key = new SymmetricSecurityKey(
            Encoding.UTF8.GetBytes(_config["Jwt:SecretKey"]
                ?? "MySuperSecretKeyThatIsAtLeast32CharactersLong!"));

        var claims = new[]
        {
            new Claim(ClaimTypes.Name, user.Username),
            new Claim(ClaimTypes.Role, user.Role),
            new Claim(ClaimTypes.NameIdentifier, user.Username)
        };

        var token = new JwtSecurityToken(
            issuer: _config["Jwt:Issuer"] ?? "AspBook",
            audience: _config["Jwt:Audience"] ?? "AspBookUsers",
            claims: claims,
            expires: DateTime.UtcNow.AddHours(1),
            signingCredentials: new SigningCredentials(key, SecurityAlgorithms.HmacSha256)
        );

        return new JwtSecurityTokenHandler().WriteToken(token);
    }
}

// Модели запросов
public class RegisterRequest
{
    public string Username { get; set; } = "";
    public string Password { get; set; } = "";
    public string? Role { get; set; }  // "User" или "Admin"
}

public class LoginRequest
{
    public string Username { get; set; } = "";
    public string Password { get; set; } = "";
}

public class UserInfo
{
    public string Username { get; set; } = "";
    public string Password { get; set; } = "";
    public string Role { get; set; } = "User";
}</code></pre>
                    <div class="code-explanation">
                        <strong>Что здесь происходит:</strong>
                        <ul>
                            <li><code>Register</code> — сохраняет пользователя в памяти с указанной ролью (по умолчанию "User")</li>
                            <li><code>Login</code> — проверяет учётные данные и возвращает JWT токен</li>
                            <li>В токен записываются claims: <code>Name</code>, <code>Role</code>, <code>NameIdentifier</code></li>
                            <li>Эти claims потом доступны в Hub через <code>Context.User</code></li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>4. Program.cs (полный файл)</h3>
                <div class="code-block">
                    <pre><code>using System.Text;
using Asp_Book.Chapter11.Hubs;
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.IdentityModel.Tokens;
using Microsoft.OpenApi.Models;

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddControllers();
builder.Services.AddRazorPages().AddRazorRuntimeCompilation();

// 1. SignalR
builder.Services.AddSignalR();

// 2. JWT Authentication
var secretKey = builder.Configuration["Jwt:SecretKey"]
    ?? "MySuperSecretKeyThatIsAtLeast32CharactersLong!";
var issuer = builder.Configuration["Jwt:Issuer"] ?? "AspBook";
var audience = builder.Configuration["Jwt:Audience"] ?? "AspBookUsers";

builder.Services.AddAuthentication(options =>
{
    options.DefaultAuthenticateScheme = JwtBearerDefaults.AuthenticationScheme;
    options.DefaultChallengeScheme = JwtBearerDefaults.AuthenticationScheme;
})
.AddJwtBearer(options =>
{
    options.TokenValidationParameters = new TokenValidationParameters
    {
        ValidateIssuerSigningKey = true,
        IssuerSigningKey = new SymmetricSecurityKey(
            Encoding.UTF8.GetBytes(secretKey)),
        ValidateIssuer = true,
        ValidIssuer = issuer,
        ValidateAudience = true,
        ValidAudience = audience,
        ValidateLifetime = true,
        ClockSkew = TimeSpan.Zero
    };

    // *** КЛЮЧЕВОЙ МОМЕНТ ***
    // Чтение токена из query string для SignalR
    options.Events = new JwtBearerEvents
    {
        OnMessageReceived = context =>
        {
            var accessToken = context.Request.Query["access_token"];
            var path = context.HttpContext.Request.Path;
            if (!string.IsNullOrEmpty(accessToken)
                &amp;&amp; path.StartsWithSegments("/authorizedchathub"))
            {
                context.Token = accessToken;
            }
            return Task.CompletedTask;
        }
    };
});

builder.Services.AddAuthorization();

// 3. Swagger с JWT
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen(c =>
{
    c.SwaggerDoc("v1", new OpenApiInfo
    {
        Title = "Глава 11: Авторизация SignalR",
        Version = "v1"
    });

    c.AddSecurityDefinition("Bearer", new OpenApiSecurityScheme
    {
        Description = "Введите JWT токен (без приставки Bearer)",
        Type = SecuritySchemeType.Http,
        Scheme = "bearer",
        BearerFormat = "JWT"
    });

    c.AddSecurityRequirement(new OpenApiSecurityRequirement
    {
        {
            new OpenApiSecurityScheme
            {
                Reference = new OpenApiReference
                {
                    Type = ReferenceType.SecurityScheme,
                    Id = "Bearer"
                }
            },
            Array.Empty&lt;string&gt;()
        }
    });
});

var app = builder.Build();

app.UseSwagger();
app.UseSwaggerUI();
app.UseStaticFiles();
app.UseRouting();

// Порядок важен!
app.UseAuthentication();   // 1. Аутентификация
app.UseAuthorization();    // 2. Авторизация

app.MapRazorPages();
app.MapControllers();

// SignalR Hub с авторизацией
app.MapHub&lt;AuthorizedChatHub&gt;("/authorizedchathub");

app.Run();</code></pre>
                    <div class="code-explanation">
                        <strong>Ключевые моменты:</strong>
                        <ul>
                            <li><code>OnMessageReceived</code> — извлекает JWT из <code>?access_token=...</code> для SignalR</li>
                            <li><code>UseAuthentication()</code> → <code>UseAuthorization()</code> — строгий порядок!</li>
                            <li><code>MapHub&lt;AuthorizedChatHub&gt;("/authorizedchathub")</code> — Hub после всех middleware</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>5. Консольный клиент (C#)</h3>
                <p>Создаём отдельный консольный проект для тестирования авторизованного Hub.</p>

                <h4>Шаг 1: Создание проекта</h4>
                <div class="code-block">
                    <pre><code># Создаём консольное приложение
dotnet new console -n AuthSignalR.Console

cd AuthSignalR.Console

# Устанавливаем SignalR клиент
dotnet add package Microsoft.AspNetCore.SignalR.Client</code></pre>
                </div>

                <h4>Шаг 2: Program.cs — полный код консольного клиента</h4>
                <div class="code-block">
                    <pre><code>using System.Net.Http.Json;
using Microsoft.AspNetCore.SignalR.Client;

const string baseUrl = "http://localhost:5011";

Console.WriteLine("=== Авторизованный SignalR чат ===\n");

// ─── 1. Регистрация и вход ───────────────────────────────
using var http = new HttpClient { BaseAddress = new Uri(baseUrl) };

Console.Write("Имя пользователя: ");
var username = Console.ReadLine()?.Trim() ?? "User1";

Console.Write("Пароль: ");
var password = Console.ReadLine()?.Trim() ?? "123456";

Console.Write("Роль (User / Admin): ");
var role = Console.ReadLine()?.Trim();
if (string.IsNullOrEmpty(role)) role = "User";

// Регистрация
var regResponse = await http.PostAsJsonAsync("/api/auth/register",
    new { Username = username, Password = password, Role = role });

if (regResponse.IsSuccessStatusCode)
    Console.WriteLine("✅ Зарегистрирован");
else
    Console.WriteLine($"ℹ️  {await regResponse.Content.ReadAsStringAsync()}");

// Логин
var loginResponse = await http.PostAsJsonAsync("/api/auth/login",
    new { Username = username, Password = password });

if (!loginResponse.IsSuccessStatusCode)
{
    Console.WriteLine("❌ Ошибка входа: " +
        await loginResponse.Content.ReadAsStringAsync());
    return;
}

var loginResult = await loginResponse.Content
    .ReadFromJsonAsync&lt;LoginResult&gt;();
var token = loginResult!.AccessToken;
Console.WriteLine($"✅ Вход выполнен. Роль: {loginResult.Role}");
Console.WriteLine($"   Токен: {token[..20]}...\n");

// ─── 2. Подключение к SignalR Hub с JWT ──────────────────
var connection = new HubConnectionBuilder()
    .WithUrl($"{baseUrl}/authorizedchathub", options =&gt;
    {
        // SignalR добавит ?access_token=... к URL автоматически
        options.AccessTokenProvider = () =&gt; Task.FromResult(token)!;
    })
    .WithAutomaticReconnect()
    .Build();

// ─── 3. Подписка на события от сервера ───────────────────
connection.On&lt;string, string&gt;("ReceiveMessage", (user, message) =&gt;
{
    Console.WriteLine($"💬 {user}: {message}");
});

connection.On&lt;string&gt;("UserConnected", (user) =&gt;
{
    Console.WriteLine($"🟢 {user} подключился");
});

connection.On&lt;string&gt;("UserDisconnected", (user) =&gt;
{
    Console.WriteLine($"🔴 {user} отключился");
});

connection.On&lt;string, string&gt;("ReceiveAdminMessage", (user, message) =&gt;
{
    Console.WriteLine($"🔒 [ADMIN] {user}: {message}");
});

connection.Reconnecting += _ =&gt;
{
    Console.WriteLine("⏳ Переподключение...");
    return Task.CompletedTask;
};

connection.Reconnected += id =&gt;
{
    Console.WriteLine($"✅ Переподключено! ID: {id?[..8]}...");
    return Task.CompletedTask;
};

connection.Closed += _ =&gt;
{
    Console.WriteLine("🔌 Соединение закрыто.");
    return Task.CompletedTask;
};

// ─── 4. Подключение к Hub ────────────────────────────────
try
{
    Console.WriteLine(
        $"Подключение к {baseUrl}/authorizedchathub...");
    await connection.StartAsync();
    Console.WriteLine(
        $"✅ Подключено! ID: {connection.ConnectionId?[..8]}...\n");
}
catch (Exception ex)
{
    Console.WriteLine($"❌ Ошибка подключения: {ex.Message}");
    return;
}

// ─── 5. Цикл чата ───────────────────────────────────────
Console.WriteLine("Команды:");
Console.WriteLine("  [текст]              — отправить всем");
Console.WriteLine("  /pm [connId] [текст] — приватное сообщение");
Console.WriteLine("  /admin [текст]       — только для админов");
Console.WriteLine("  /id                  — показать свой ID");
Console.WriteLine("  exit                 — выход\n");

while (connection.State == HubConnectionState.Connected)
{
    var input = Console.ReadLine();
    if (string.IsNullOrEmpty(input)) continue;
    if (input.ToLower() == "exit") break;

    try
    {
        if (input.ToLower() == "/id")
        {
            Console.WriteLine(
                $"📋 Ваш Connection ID: {connection.ConnectionId}");
        }
        else if (input.StartsWith("/pm "))
        {
            var parts = input.Split(' ', 3);
            if (parts.Length &lt; 3)
            {
                Console.WriteLine(
                    "Формат: /pm [connectionId] [сообщение]");
                continue;
            }
            await connection.InvokeAsync(
                "SendToUser", parts[1], parts[2]);
        }
        else if (input.StartsWith("/admin "))
        {
            await connection.InvokeAsync(
                "SendToAdmins", input[7..]);
        }
        else
        {
            await connection.InvokeAsync("SendToAll", input);
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"⚠️  Ошибка: {ex.Message}");
    }
}

await connection.StopAsync();
Console.WriteLine("🔌 Отключено.");

// Модель ответа от /api/auth/login
record LoginResult(string AccessToken, string Username, string Role);</code></pre>
                    <div class="code-explanation">
                        <strong>Что делает консольный клиент:</strong>
                        <ol>
                            <li><strong>Регистрация и логин</strong> — HTTP запросы к <code>/api/auth/register</code> и <code>/api/auth/login</code></li>
                            <li><strong>Подключение к Hub</strong> — <code>AccessTokenProvider</code> передаёт JWT токен автоматически</li>
                            <li><strong>Подписка на события</strong> — <code>connection.On</code> для получения сообщений</li>
                            <li><strong>Цикл чата</strong> — ввод команд для отправки сообщений</li>
                        </ol>
                        <br>
                        <strong>Ключевое отличие от главы 10:</strong>
                        <ul>
                            <li><code>AccessTokenProvider</code> — функция, возвращающая JWT токен</li>
                            <li>SignalR автоматически добавляет <code>?access_token=...</code> к URL при подключении</li>
                            <li>Команда <code>/admin</code> — вызывает <code>SendToAdmins</code> (доступна только с ролью Admin)</li>
                        </ul>
                    </div>
                </div>

            <section class="mb-5">
                <h3>Как генерируется JWT токен?</h3>
                <p>Для генерации JWT токена нужно: создать <strong>claims</strong> (данные о пользователе), подписать их <strong>секретным ключом</strong> и указать <strong>срок действия</strong>.</p>

                <h4>1. Установка пакета</h4>
                <div class="code-block">
                    <pre><code>dotnet add package System.IdentityModel.Tokens.Jwt
dotnet add package Microsoft.AspNetCore.Authentication.JwtBearer</code></pre>
                </div>

                <h4>2. Сервис генерации токена</h4>
                <div class="code-block">
                    <pre><code>using System.IdentityModel.Tokens.Jwt;
using System.Security.Claims;
using System.Text;
using Microsoft.IdentityModel.Tokens;

public class JwtService
{
    private readonly string _secretKey;
    private readonly string _issuer;
    private readonly string _audience;

    public JwtService(IConfiguration configuration)
    {
        _secretKey = configuration["Jwt:SecretKey"] 
            ?? "MySuperSecretKeyThatIsAtLeast32CharactersLong!";
        _issuer = configuration["Jwt:Issuer"] ?? "AspBook";
        _audience = configuration["Jwt:Audience"] ?? "AspBookUsers";
    }

    public string GenerateToken(string username, string email, string role)
    {
        // 1. Claims — информация о пользователе, зашитая в токен
        var claims = new[]
        {
            new Claim(ClaimTypes.Name, username),
            new Claim(ClaimTypes.Email, email),
            new Claim(ClaimTypes.Role, role)
        };

        // 2. Ключ для подписи (из секретной строки)
        var key = new SymmetricSecurityKey(
            Encoding.UTF8.GetBytes(_secretKey));

        // 3. Алгоритм подписи
        var credentials = new SigningCredentials(
            key, SecurityAlgorithms.HmacSha256);

        // 4. Собираем токен
        var token = new JwtSecurityToken(
            issuer: _issuer,       // Кто выдал
            audience: _audience,   // Для кого
            claims: claims,        // Данные
            expires: DateTime.UtcNow.AddHours(1), // Срок жизни
            signingCredentials: credentials         // Подпись
        );

        // 5. Преобразуем в строку
        return new JwtSecurityTokenHandler().WriteToken(token);
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Пошагово:</strong>
                        <ul>
                            <li><code>Claims</code> — пары «ключ-значение», которые хранятся внутри токена (имя, роль, email)</li>
                            <li><code>SymmetricSecurityKey</code> — секретный ключ, которым подписывается токен (минимум 32 символа)</li>
                            <li><code>SigningCredentials</code> — алгоритм HMAC-SHA256 для подписи</li>
                            <li><code>JwtSecurityToken</code> — сборка всех частей: issuer, audience, claims, срок, подпись</li>
                            <li><code>WriteToken()</code> — превращает объект токена в строку вида <code>eyJhbG...</code></li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Как настроена валидация токена?</h3>
                <p>Валидация настраивается в <code>Program.cs</code>. При каждом запросе ASP.NET Core автоматически проверяет токен по заданным параметрам.</p>

                <div class="code-block">
                    <pre><code>// Program.cs
using System.Text;
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.IdentityModel.Tokens;

var builder = WebApplication.CreateBuilder(args);

var secretKey = builder.Configuration["Jwt:SecretKey"]
    ?? "MySuperSecretKeyThatIsAtLeast32CharactersLong!";

// Настройка аутентификации с JWT
builder.Services.AddAuthentication(options =>
{
    // Схема по умолчанию — JWT Bearer
    options.DefaultAuthenticateScheme = JwtBearerDefaults.AuthenticationScheme;
    options.DefaultChallengeScheme = JwtBearerDefaults.AuthenticationScheme;
})
.AddJwtBearer(options =>
{
    // Параметры валидации токена
    options.TokenValidationParameters = new TokenValidationParameters
    {
        ValidateIssuerSigningKey = true,  // Проверять подпись
        IssuerSigningKey = new SymmetricSecurityKey(
            Encoding.UTF8.GetBytes(secretKey)),  // Ключ для проверки

        ValidateIssuer = true,            // Проверять издателя
        ValidIssuer = "AspBook",          // Ожидаемый издатель

        ValidateAudience = true,          // Проверять аудиторию
        ValidAudience = "AspBookUsers",   // Ожидаемая аудитория

        ValidateLifetime = true,          // Проверять срок действия
        ClockSkew = TimeSpan.Zero         // Без допуска по времени
    };
});

builder.Services.AddAuthorization();  // Подключаем авторизацию

var app = builder.Build();

// ВАЖНО: порядок middleware имеет значение!
app.UseAuthentication();  // Сначала аутентификация (кто вы?)
app.UseAuthorization();   // Потом авторизация (что вам разрешено?)

app.MapControllers();
app.Run();</code></pre>
                    <div class="code-explanation">
                        <strong>Что проверяется при каждом запросе:</strong>
                        <table class="table table-striped table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Параметр</th>
                                    <th>Что проверяет</th>
                                    <th>Если не совпадает</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>ValidateIssuerSigningKey</code></td>
                                    <td>Подпись не подделана</td>
                                    <td>401 Unauthorized</td>
                                </tr>
                                <tr>
                                    <td><code>ValidateIssuer</code></td>
                                    <td>Токен выдан нашим сервером</td>
                                    <td>401 Unauthorized</td>
                                </tr>
                                <tr>
                                    <td><code>ValidateAudience</code></td>
                                    <td>Токен предназначен для нас</td>
                                    <td>401 Unauthorized</td>
                                </tr>
                                <tr>
                                    <td><code>ValidateLifetime</code></td>
                                    <td>Токен не просрочен</td>
                                    <td>401 Unauthorized</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <h4>Конфигурация в appsettings.json</h4>
                <div class="code-block">
                    <pre><code>{
  "Jwt": {
    "SecretKey": "MySuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "AspBook",
    "Audience": "AspBookUsers"
  }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Важно:</strong> В продакшене <code>SecretKey</code> должен храниться в безопасном месте (переменные окружения, Azure Key Vault), а не в коде или appsettings.json.
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Как защитить контроллер с помощью [Authorize]?</h3>
                <p>Атрибут <code>[Authorize]</code> указывает, что для доступа к методу (или всему контроллеру) нужен валидный JWT токен.</p>

                <div class="code-block">
                    <pre><code>using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using System.Security.Claims;

[ApiController]
[Route("api/[controller]")]
public class ProtectedController : ControllerBase
{
    // Доступен ВСЕМ (без токена)
    [HttpGet("public")]
    public IActionResult GetPublicData()
    {
        return Ok(new { message = "Это публичные данные" });
    }

    // Доступен только авторизованным (с токеном)
    [Authorize]
    [HttpGet("private")]
    public IActionResult GetPrivateData()
    {
        // Достаём данные из токена
        var username = User.Identity?.Name;
        var email = User.Claims
            .FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;

        return Ok(new { message = "Это приватные данные", username, email });
    }

    // Доступен только пользователям с ролью "Admin"
    [Authorize(Roles = "Admin")]
    [HttpGet("admin")]
    public IActionResult GetAdminData()
    {
        return Ok(new { message = "Только для администраторов" });
    }

    // Доступен пользователям с ролью "Admin" ИЛИ "Manager"
    [Authorize(Roles = "Admin,Manager")]
    [HttpGet("management")]
    public IActionResult GetManagementData()
    {
        return Ok(new { message = "Для администраторов и менеджеров" });
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Варианты использования [Authorize]:</strong>
                        <table class="table table-striped table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Атрибут</th>
                                    <th>Кто имеет доступ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>(без атрибута)</td>
                                    <td>Все — токен не нужен</td>
                                </tr>
                                <tr>
                                    <td><code>[Authorize]</code></td>
                                    <td>Любой авторизованный пользователь (есть валидный токен)</td>
                                </tr>
                                <tr>
                                    <td><code>[Authorize(Roles = "Admin")]</code></td>
                                    <td>Только пользователи с ролью Admin</td>
                                </tr>
                                <tr>
                                    <td><code>[Authorize(Roles = "Admin,Manager")]</code></td>
                                    <td>Пользователи с ролью Admin <strong>или</strong> Manager</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <p><strong>Можно поставить [Authorize] на весь контроллер</strong>, а отдельные методы сделать публичными через <code>[AllowAnonymous]</code>:</p>
                <div class="code-block">
                    <pre><code>[ApiController]
[Route("api/[controller]")]
[Authorize]  // Весь контроллер требует авторизации
public class UsersController : ControllerBase
{
    [AllowAnonymous]  // Этот метод доступен без токена
    [HttpPost("login")]
    public IActionResult Login(LoginRequest request)
    {
        // Логин доступен всем
    }

    [HttpGet("profile")]  // Этот метод требует токен (наследует [Authorize])
    public IActionResult GetProfile()
    {
        var username = User.Identity?.Name;
        return Ok(new { username });
    }
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>Как добавить JWT в Swagger для тестирования?</h3>
                <p>По умолчанию Swagger не знает о JWT. Нужно добавить кнопку «Authorize» для ввода токена.</p>

                <div class="code-block">
                    <pre><code>// Program.cs
using Microsoft.OpenApi.Models;

builder.Services.AddSwaggerGen(c =>
{
    c.SwaggerDoc("v1", new OpenApiInfo
    {
        Title = "JWT API",
        Version = "v1"
    });

    // 1. Определяем схему безопасности (тип Http + bearer)
    c.AddSecurityDefinition("Bearer", new OpenApiSecurityScheme
    {
        Description = "Введите JWT токен (без приставки Bearer — она подставится автоматически)",
        Type = SecuritySchemeType.Http,    // ← Http, а не ApiKey!
        Scheme = "bearer",                 // ← схема bearer (в нижнем регистре)
        BearerFormat = "JWT"               // ← подсказка формата для Swagger UI
    });

    // 2. Применяем схему ко всем эндпоинтам
    c.AddSecurityRequirement(new OpenApiSecurityRequirement
    {
        {
            new OpenApiSecurityScheme
            {
                Reference = new OpenApiReference
                {
                    Type = ReferenceType.SecurityScheme,
                    Id = "Bearer"
                }
            },
            Array.Empty&lt;string&gt;()
        }
    });
});</code></pre>
                    <div class="code-explanation">
                        <strong>Как пользоваться:</strong>
                        <ol>
                            <li>Открываете Swagger UI (<code>/swagger</code>)</li>
                            <li>Вызываете <code>POST /api/auth/login</code> — получаете токен</li>
                            <li>Нажимаете кнопку <strong>Authorize</strong> 🔓 (вверху справа)</li>
                            <li>Вставляете <strong>только сам токен</strong> (например: <code>eyJhbGciOiJIUzI1NiIs...</code>)</li>
                            <li>Swagger <strong>сам</strong> добавит приставку <code>Bearer </code> к заголовку</li>
                            <li>Теперь все запросы в Swagger автоматически отправляются с токеном</li>
                        </ol>
                    </div>
                </div>

                <h4 class="mt-4">Почему <code>SecuritySchemeType.Http</code>, а не <code>SecuritySchemeType.ApiKey</code>?</h4>
                <div class="alert alert-info">
                    <p>В OpenAPI (стандарт Swagger) есть несколько типов схем безопасности:</p>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Тип</th>
                                <th>Что делает</th>
                                <th>Что вводит пользователь</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>SecuritySchemeType.ApiKey</code></td>
                                <td>Просто передаёт значение в заголовок <strong>как есть</strong></td>
                                <td><code>Bearer eyJhbG...</code> (нужно вручную писать "Bearer ")</td>
                            </tr>
                            <tr>
                                <td><code>SecuritySchemeType.Http</code></td>
                                <td>Использует HTTP-схему аутентификации (RFC 7235). Swagger <strong>сам формирует заголовок</strong></td>
                                <td><code>eyJhbG...</code> (только токен, "Bearer " подставится автоматически)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="code-block mt-3">
                    <pre><code>// ❌ Старый способ — SecuritySchemeType.ApiKey
// Пользователь должен ввести: "Bearer eyJhbGciOiJIUzI1NiIs..."
// Если забудет "Bearer " — получит 401 Unauthorized
c.AddSecurityDefinition("Bearer", new OpenApiSecurityScheme
{
    Name = "Authorization",
    In = ParameterLocation.Header,
    Type = SecuritySchemeType.ApiKey,    // Просто ApiKey в заголовке
    Scheme = "Bearer"
});

// ✅ Правильный способ — SecuritySchemeType.Http
// Пользователь вводит только: "eyJhbGciOiJIUzI1NiIs..."
// Swagger сам отправит: "Authorization: Bearer eyJhbGciOiJIUzI1NiIs..."
c.AddSecurityDefinition("Bearer", new OpenApiSecurityScheme
{
    Type = SecuritySchemeType.Http,      // HTTP-аутентификация по стандарту
    Scheme = "bearer",                   // Схема "bearer" (RFC 6750)
    BearerFormat = "JWT"                 // Подсказка: формат токена — JWT
});</code></pre>
                    <div class="code-explanation">
                        <strong>Как это работает под капотом:</strong>
                        <p>Когда вы указываете <code>Type = SecuritySchemeType.Http</code> и <code>Scheme = "bearer"</code>, Swagger UI понимает, что это стандартная HTTP Bearer аутентификация (по <strong>RFC 6750</strong>). Swagger знает, что заголовок <code>Authorization</code> должен выглядеть как <code>Bearer {токен}</code>, и формирует его автоматически.</p>
                        <p><code>BearerFormat = "JWT"</code> — это просто подсказка для Swagger UI, что токен в формате JWT. На логику не влияет, но помогает разработчикам.</p>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>Безопасное хранение секретных ключей</h3>
                <p>В примерах выше секретный ключ хранится в <code>appsettings.json</code>. Это удобно для разработки, но <strong>опасно для продакшена</strong>.</p>

                <h4>Почему appsettings.json — небезопасно?</h4>
                <div class="alert alert-danger">
                    <ul>
                        <li><strong>Попадает в Git</strong> — если вы случайно закоммитите <code>appsettings.json</code> с секретным ключом, он будет виден всем, у кого есть доступ к репозиторию</li>
                        <li><strong>Виден на сервере</strong> — файл лежит рядом с приложением и может быть прочитан при утечке</li>
                        <li><strong>Один файл на всех</strong> — разработчики, тестировщики и продакшен используют одинаковые ключи</li>
                        <li><strong>Нет разделения</strong> — секреты смешаны с обычной конфигурацией (логирование, строки подключения)</li>
                    </ul>
                </div>

                <h4>Решение: переменные окружения и .env файл</h4>
                <p><strong>.env файл</strong> — это текстовый файл с переменными окружения, который <strong>не добавляется в Git</strong>.</p>

                <p><strong>Шаг 1:</strong> Создайте файл <code>.env</code> в корне проекта:</p>
                <div class="code-block">
                    <pre><code># .env — этот файл НЕ добавляется в Git!
JWT_SECRET_KEY=ваш_сгенерированный_секретный_ключ_минимум_32_символа
JWT_ISSUER=AspBook
JWT_AUDIENCE=AspBookUsers</code></pre>
                </div>

                <p><strong>Шаг 2:</strong> Добавьте <code>.env</code> в <code>.gitignore</code>:</p>
                <div class="code-block">
                    <pre><code># .gitignore
.env
*.env</code></pre>
                </div>

                <p><strong>Шаг 3:</strong> Считывайте переменные окружения в <code>Program.cs</code>:</p>
                <div class="code-block">
                    <pre><code>// Program.cs
var builder = WebApplication.CreateBuilder(args);

// Переменные окружения имеют приоритет над appsettings.json
var secretKey = Environment.GetEnvironmentVariable("JWT_SECRET_KEY")
    ?? builder.Configuration["Jwt:SecretKey"]
    ?? throw new Exception("JWT SecretKey не настроен!");

var issuer = Environment.GetEnvironmentVariable("JWT_ISSUER")
    ?? builder.Configuration["Jwt:Issuer"]
    ?? "AspBook";

var audience = Environment.GetEnvironmentVariable("JWT_AUDIENCE")
    ?? builder.Configuration["Jwt:Audience"]
    ?? "AspBookUsers";</code></pre>
                    <div class="code-explanation">
                        <strong>Порядок приоритетов:</strong>
                        <ol>
                            <li>Переменная окружения (<code>JWT_SECRET_KEY</code>) — если задана, используется она</li>
                            <li><code>appsettings.json</code> — если переменной окружения нет</li>
                            <li>Значение по умолчанию или ошибка — если ничего не задано</li>
                        </ol>
                    </div>
                </div>

                <p><strong>Шаг 4:</strong> Для Docker — передавайте переменные через <code>docker-compose.yml</code>:</p>
                <div class="code-block">
                    <pre><code># docker-compose.yml
services:
  chapter07:
    build: ./Asp_Book.Chapter07
    environment:
      - JWT_SECRET_KEY=your_production_secret_key_here_min_32_chars
      - JWT_ISSUER=AspBook
      - JWT_AUDIENCE=AspBookUsers

# Или через .env файл:
services:
  chapter07:
    build: ./Asp_Book.Chapter07
    env_file:
      - .env</code></pre>
                </div>

                <h4>Генерация случайных секретных ключей</h4>
                <p>Никогда не придумывайте ключи вручную — генерируйте случайные:</p>

                <p><strong>PowerShell (Windows):</strong></p>
                <div class="code-block">
                    <pre><code># Генерация случайного ключа 64 символа
[Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])</code></pre>
                </div>

                <p><strong>Bash (Linux/Mac):</strong></p>
                <div class="code-block">
                    <pre><code># Генерация случайного ключа 64 символа
openssl rand -base64 48</code></pre>
                </div>

                <p><strong>Через .NET CLI (любая ОС):</strong></p>
                <div class="code-block">
                    <pre><code># Генерация через dotnet-script или C# Interactive
dotnet script -e "Console.WriteLine(Convert.ToBase64String(System.Security.Cryptography.RandomNumberGenerator.GetBytes(48)))"</code></pre>
                </div>

                <p><strong>Или просто в C# коде (для одноразовой генерации):</strong></p>
                <div class="code-block">
                    <pre><code>using System.Security.Cryptography;

// Генерация безопасного случайного ключа
var key = Convert.ToBase64String(RandomNumberGenerator.GetBytes(48));
Console.WriteLine(key);
// Пример: "x7Kp2mN+Qf3vR8tY1wZ0aB4cD6eF9gH2jK5lM8nO3pQ7rS0uV4wX"</code></pre>
                </div>

                <h4>Сравнение способов хранения секретов</h4>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Способ</th>
                                <th>Безопасность</th>
                                <th>Удобство</th>
                                <th>Когда использовать</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>appsettings.json</code></td>
                                <td>❌ Низкая</td>
                                <td>✅ Удобно</td>
                                <td>Только для разработки</td>
                            </tr>
                            <tr>
                                <td><code>.env</code> файл</td>
                                <td>⚠️ Средняя</td>
                                <td>✅ Удобно</td>
                                <td>Разработка + простой деплой</td>
                            </tr>
                            <tr>
                                <td>Переменные окружения</td>
                                <td>✅ Высокая</td>
                                <td>⚠️ Средне</td>
                                <td>Продакшен, Docker</td>
                            </tr>
                            <tr>
                                <td><code>dotnet user-secrets</code></td>
                                <td>✅ Высокая</td>
                                <td>✅ Удобно</td>
                                <td>Локальная разработка</td>
                            </tr>
                            <tr>
                                <td>Azure Key Vault / AWS Secrets</td>
                                <td>✅✅ Очень высокая</td>
                                <td>⚠️ Сложнее</td>
                                <td>Крупные проекты, облако</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <h4>Бонус: dotnet user-secrets (для локальной разработки)</h4>
                <p>ASP.NET Core имеет встроенный инструмент для безопасного хранения секретов:</p>
                <div class="code-block">
                    <pre><code># Инициализация (один раз для проекта)
dotnet user-secrets init

# Добавление секрета
dotnet user-secrets set "Jwt:SecretKey" "ваш_секретный_ключ"

# Просмотр всех секретов
dotnet user-secrets list

# Удаление секрета
dotnet user-secrets remove "Jwt:SecretKey"</code></pre>
                    <div class="code-explanation">
                        <strong>Как это работает:</strong>
                        <ul>
                            <li>Секреты хранятся в <strong>домашней папке пользователя</strong>, а не в проекте</li>
                            <li>Автоматически подключаются в <code>Development</code> режиме</li>
                            <li>Не попадают в Git</li>
                            <li>Доступны через <code>builder.Configuration["Jwt:SecretKey"]</code> как обычно</li>
                        </ul>
                    </div>
                </div>
            </section>


            <section class="mb-5">
                <h3>5. Клиентский код — C# (консольное приложение / сервис)</h3>
                <p>WebSocket можно использовать не только в браузере, но и из C#-кода — например, из консольного приложения, другого сервиса или бота. Для этого используется класс <code>ClientWebSocket</code> из пространства имён <code>System.Net.WebSockets</code>:</p>
                <div class="code-block">
                    <pre><code>using System.Net.WebSockets;
using System.Text;

// Создаём клиент
var ws = new ClientWebSocket();

// Подключаемся к серверу
await ws.ConnectAsync(
    new Uri("ws://localhost:5009/ws"), 
    CancellationToken.None);

Console.WriteLine("Подключено к WebSocket серверу!");

// === Отправка сообщения ===
var message = "Привет от C# клиента!";
var bytes = Encoding.UTF8.GetBytes(message);
await ws.SendAsync(
    new ArraySegment&lt;byte&gt;(bytes),
    WebSocketMessageType.Text,
    endOfMessage: true,
    CancellationToken.None);

Console.WriteLine($"Отправлено: {message}");

// === Получение сообщений в цикле ===
var buffer = new byte[1024 * 4];

while (ws.State == WebSocketState.Open)
{
    var result = await ws.ReceiveAsync(
        new ArraySegment&lt;byte&gt;(buffer),
        CancellationToken.None);

    if (result.MessageType == WebSocketMessageType.Close)
    {
        // Сервер запросил закрытие
        await ws.CloseAsync(
            WebSocketCloseStatus.NormalClosure,
            "Закрытие",
            CancellationToken.None);
        Console.WriteLine("Соединение закрыто сервером");
        break;
    }

    var received = Encoding.UTF8.GetString(buffer, 0, result.Count);
    Console.WriteLine($"Получено: {received}");
}

// === Корректное закрытие ===
if (ws.State == WebSocketState.Open)
{
    await ws.CloseAsync(
        WebSocketCloseStatus.NormalClosure,
        "Выход",
        CancellationToken.None);
}</code></pre>
                    <div class="code-explanation">
                        <strong>Ключевые классы:</strong>
                        <table class="table table-striped table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Класс / Метод</th>
                                    <th>Описание</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>ClientWebSocket</code></td>
                                    <td>Клиент WebSocket для .NET (System.Net.WebSockets)</td>
                                </tr>
                                <tr>
                                    <td><code>ConnectAsync(uri)</code></td>
                                    <td>Устанавливает соединение с сервером</td>
                                </tr>
                                <tr>
                                    <td><code>SendAsync(buffer)</code></td>
                                    <td>Отправляет данные серверу</td>
                                </tr>
                                <tr>
                                    <td><code>ReceiveAsync(buffer)</code></td>
                                    <td>Читает входящее сообщение</td>
                                </tr>
                                <tr>
                                    <td><code>CloseAsync()</code></td>
                                    <td>Корректно закрывает соединение</td>
                                </tr>
                                <tr>
                                    <td><code>ws.State</code></td>
                                    <td>Текущее состояние (Open, Closed, и т.д.)</td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="mt-2"><strong>Когда использовать C#-клиент?</strong> Когда WebSocket нужен не в браузере, а в микросервисе, боте, фоновом сервисе, десктопном приложении и т.д.</p>

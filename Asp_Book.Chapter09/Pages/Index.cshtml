            <section class="mb-5">
                <h3>6. Services/WebSocketService.cs — сервис для WebSocket</h3>
                <p>Создадим <strong>сервис</strong>, который инкапсулирует всю работу с WebSocket. Это правильный подход — логика отделена от UI.</p>

                <div class="code-block">
                    <pre><code>using System.Net.WebSockets;
using System.Text;

namespace WebSocketChat.Client.Services;

// Интерфейс сервиса — для DI и тестирования
public interface IWebSocketService : IAsyncDisposable
{
    bool IsConnected { get; }
    
    // События для уведомления UI
    event Action&lt;string&gt;? OnMessageReceived;
    event Action&lt;bool&gt;? OnConnectionChanged;
    event Action&lt;string&gt;? OnError;
    
    Task ConnectAsync(string serverUrl, CancellationToken ct = default);
    Task SendAsync(string message, CancellationToken ct = default);
    Task DisconnectAsync();
}

public class WebSocketService : IWebSocketService
{
    private ClientWebSocket? _ws;
    private CancellationTokenSource? _receiveCts;
    
    public bool IsConnected => _ws?.State == WebSocketState.Open;
    
    // События — UI подписывается на них для обновления
    public event Action&lt;string&gt;? OnMessageReceived;
    public event Action&lt;bool&gt;? OnConnectionChanged;
    public event Action&lt;string&gt;? OnError;

    public async Task ConnectAsync(string serverUrl, CancellationToken ct = default)
    {
        // Создаём новый WebSocket клиент
        _ws = new ClientWebSocket();
        _receiveCts = new CancellationTokenSource();

        try
        {
            // Устанавливаем соединение
            await _ws.ConnectAsync(new Uri(serverUrl), ct);
            
            // Уведомляем UI: подключено
            OnConnectionChanged?.Invoke(true);
            
            // Запускаем фоновое чтение сообщений
            _ = ReceiveLoopAsync(_receiveCts.Token);
        }
        catch (Exception ex)
        {
            OnError?.Invoke($"Ошибка подключения: {ex.Message}");
            OnConnectionChanged?.Invoke(false);
        }
    }

    public async Task SendAsync(string message, CancellationToken ct = default)
    {
        if (_ws?.State != WebSocketState.Open)
        {
            OnError?.Invoke("WebSocket не подключен");
            return;
        }

        // Кодируем строку в байты (UTF-8)
        var bytes = Encoding.UTF8.GetBytes(message);
        
        // Отправляем байты через WebSocket
        await _ws.SendAsync(
            new ArraySegment&lt;byte&gt;(bytes),
            WebSocketMessageType.Text,
            endOfMessage: true,
            ct);
    }

    // Бесконечный цикл чтения входящих сообщений
    private async Task ReceiveLoopAsync(CancellationToken ct)
    {
        var buffer = new byte[1024 * 4];  // Буфер 4 КБ

        try
        {
            while (_ws?.State == WebSocketState.Open &amp;&amp; !ct.IsCancellationRequested)
            {
                // Ждём сообщение от сервера
                var result = await _ws.ReceiveAsync(
                    new ArraySegment&lt;byte&gt;(buffer), ct);

                if (result.MessageType == WebSocketMessageType.Close)
                {
                    // Сервер закрыл соединение
                    OnConnectionChanged?.Invoke(false);
                    break;
                }

                // Декодируем байты → строка
                var message = Encoding.UTF8.GetString(
                    buffer, 0, result.Count);
                
                // Уведомляем UI: пришло сообщение
                OnMessageReceived?.Invoke(message);
            }
        }
        catch (OperationCanceledException)
        {
            // Нормальное завершение при отключении
        }
        catch (Exception ex)
        {
            OnError?.Invoke($"Ошибка чтения: {ex.Message}");
        }
        finally
        {
            OnConnectionChanged?.Invoke(false);
        }
    }

    public async Task DisconnectAsync()
    {
        // Отменяем фоновое чтение
        _receiveCts?.Cancel();

        if (_ws?.State == WebSocketState.Open)
        {
            // Корректно закрываем WebSocket (отправляем Close frame)
            await _ws.CloseAsync(
                WebSocketCloseStatus.NormalClosure,
                "Пользователь отключился",
                CancellationToken.None);
        }
        
        OnConnectionChanged?.Invoke(false);
    }

    // IAsyncDisposable — вызывается при удалении сервиса
    public async ValueTask DisposeAsync()
    {
        await DisconnectAsync();
        _ws?.Dispose();
        _receiveCts?.Dispose();
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Зачем сервис, а не всё в компоненте?</strong>
                        <ul>
                            <li><strong>Разделение ответственности</strong> — сервис занимается WebSocket, компонент — UI</li>
                            <li><strong>Переиспользование</strong> — сервис можно использовать в разных компонентах</li>
                            <li><strong>DI (Dependency Injection)</strong> — сервис регистрируется в контейнере и внедряется</li>
                            <li><strong>Тестирование</strong> — интерфейс <code>IWebSocketService</code> можно замокать</li>
                        </ul>
                        <br>
                        <strong>Ключевые моменты:</strong>
                        <table class="table table-striped table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Элемент</th>
                                    <th>Зачем</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>event Action&lt;string&gt; OnMessageReceived</code></td>
                                    <td>UI подписывается, чтобы получать сообщения</td>
                                </tr>
                                <tr>
                                    <td><code>event Action&lt;bool&gt; OnConnectionChanged</code></td>
                                    <td>UI узнаёт, когда состояние соединения меняется</td>
                                </tr>
                                <tr>
                                    <td><code>CancellationTokenSource</code></td>
                                    <td>Позволяет прервать фоновый цикл чтения</td>
                                </tr>
                                <tr>
                                    <td><code>IAsyncDisposable</code></td>
                                    <td>Гарантирует корректное закрытие при уничтожении</td>
                                </tr>
                                <tr>
                                    <td><code>_ = ReceiveLoopAsync()</code></td>
                                    <td>Fire-and-forget — запускает цикл без ожидания</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>7. Регистрация сервиса в Program.cs</h3>
                <p>Сервис нужно зарегистрировать в DI-контейнере:</p>

                <div class="code-block">
                    <pre><code>// Program.cs (Blazor Web App)
var builder = WebApplication.CreateBuilder(args);

builder.Services.AddRazorComponents()
    .AddInteractiveServerComponents();

// Регистрируем WebSocket сервис как Scoped
// (один экземпляр на одно соединение/пользователя)
builder.Services.AddScoped&lt;IWebSocketService, WebSocketService&gt;();

var app = builder.Build();

app.UseStaticFiles();
app.UseAntiforgery();

app.MapRazorComponents&lt;App&gt;()
    .AddInteractiveServerRenderMode();

app.Run();</code></pre>
                    <div class="code-explanation">
                        <strong>Почему <code>Scoped</code>?</strong>
                        <ul>
                            <li><code>Scoped</code> — один экземпляр на одно соединение (в Blazor Server — на одну SignalR-сессию)</li>
                            <li><code>Singleton</code> — один на всех — <strong>нельзя</strong>, т.к. у каждого пользователя свой WebSocket</li>
                            <li><code>Transient</code> — новый на каждый запрос — <strong>нельзя</strong>, т.к. потеряем соединение</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>8. Компонент Chat.razor — страница чата</h3>
                <p>Теперь создаём компонент, который использует <code>WebSocketService</code> и отображает чат:</p>

                <div class="code-block">
                    <pre><code>@@page "/chat"
@@using WebSocketChat.Client.Services
@@inject IWebSocketService WsService
@@implements IAsyncDisposable
@@rendermode InteractiveServer

&lt;h3&gt;💬 WebSocket чат&lt;/h3&gt;

&lt;!-- Статус подключения --&gt;
&lt;div class="mb-3"&gt;
    &lt;span class="badge @@(isConnected ? "bg-success" : "bg-secondary") fs-6"&gt;
        @@(isConnected ? "🟢 Подключён" : "🔴 Отключён")
    &lt;/span&gt;
&lt;/div&gt;

&lt;!-- Форма ввода имени + подключение --&gt;
@@if (!isConnected)
{
    &lt;div class="card mb-3"&gt;
        &lt;div class="card-body"&gt;
            &lt;div class="mb-3"&gt;
                &lt;label class="form-label"&gt;Ваше имя:&lt;/label&gt;
                &lt;input @@bind="userName" 
                       placeholder="Введите имя..." 
                       class="form-control" /&gt;
            &lt;/div&gt;
            &lt;div class="mb-3"&gt;
                &lt;label class="form-label"&gt;Адрес сервера:&lt;/label&gt;
                &lt;input @@bind="serverUrl" 
                       class="form-control" /&gt;
            &lt;/div&gt;
            &lt;button class="btn btn-success" 
                    @@onclick="ConnectAsync"
                    disabled="@@isConnecting"&gt;
                @@if (isConnecting)
                {
                    &lt;span class="spinner-border spinner-border-sm"&gt;&lt;/span&gt;
                    &lt;span&gt; Подключение...&lt;/span&gt;
                }
                else
                {
                    &lt;span&gt;🔌 Подключиться&lt;/span&gt;
                }
            &lt;/button&gt;
        &lt;/div&gt;
    &lt;/div&gt;
}
else
{
    &lt;!-- Область сообщений --&gt;
    &lt;div class="border rounded p-3 mb-3" 
         style="height: 400px; overflow-y: auto; background: #1a1a2e; color: #eee;"
         id="chatArea"&gt;
        @@if (messages.Count == 0)
        {
            &lt;p class="text-muted text-center"&gt;Нет сообщений&lt;/p&gt;
        }
        @@foreach (var msg in messages)
        {
            &lt;div class="mb-2 p-2 rounded" 
                 style="background: @@(msg.IsSystem ? "#2d2d44" : "#16213e")"&gt;
                &lt;small class="text-warning"&gt;@@msg.Sender&lt;/small&gt;
                &lt;br /&gt;
                &lt;span&gt;@@msg.Text&lt;/span&gt;
                &lt;small class="text-muted float-end"&gt;@@msg.Time&lt;/small&gt;
            &lt;/div&gt;
        }
    &lt;/div&gt;

    &lt;!-- Ввод сообщения --&gt;
    &lt;div class="input-group mb-3"&gt;
        &lt;input @@bind="currentMessage" 
               @@bind:event="oninput"
               @@onkeydown="HandleKeyDown"
               placeholder="Введите сообщение..." 
               class="form-control" /&gt;
        &lt;button class="btn btn-primary" @@onclick="SendAsync"&gt;
            📤 Отправить
        &lt;/button&gt;
    &lt;/div&gt;

    &lt;button class="btn btn-outline-danger" @@onclick="DisconnectAsync"&gt;
        🔌 Отключиться
    &lt;/button&gt;
}

&lt;!-- Ошибки --&gt;
@@if (!string.IsNullOrEmpty(errorMessage))
{
    &lt;div class="alert alert-danger mt-3"&gt;
        @@errorMessage
    &lt;/div&gt;
}

@@code {
    // === Состояние компонента ===
    private string userName = "";
    private string serverUrl = "ws://localhost:5009/ws";
    private string currentMessage = "";
    private string errorMessage = "";
    private bool isConnected = false;
    private bool isConnecting = false;
    private List&lt;ChatMessage&gt; messages = new();

    // === Жизненный цикл: подписка на события ===
    protected override void OnInitialized()
    {
        // Подписываемся на события сервиса
        WsService.OnMessageReceived += HandleMessageReceived;
        WsService.OnConnectionChanged += HandleConnectionChanged;
        WsService.OnError += HandleError;
    }

    // === Подключение ===
    private async Task ConnectAsync()
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            errorMessage = "Введите имя!";
            return;
        }

        errorMessage = "";
        isConnecting = true;
        StateHasChanged();

        await WsService.ConnectAsync(serverUrl);
        
        isConnecting = false;
        
        if (WsService.IsConnected)
        {
            AddSystemMessage("✅ Подключено к серверу");
        }
    }

    // === Отправка ===
    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(currentMessage)) return;

        var fullMessage = $"{userName}: {currentMessage}";
        await WsService.SendAsync(fullMessage);
        
        currentMessage = "";  // Очищаем поле ввода
    }

    // === Обработчики событий от сервиса ===
    
    // Пришло сообщение
    private void HandleMessageReceived(string message)
    {
        // Парсим "connectionId: userName: текст"
        var parts = message.Split(':', 3);
        var sender = parts.Length >= 2 ? parts[1].Trim() : "Неизвестный";
        var text = parts.Length >= 3 ? parts[2].Trim() : message;

        messages.Add(new ChatMessage(sender, text, false));
        
        // ВАЖНО: InvokeAsync — обновление UI из фонового потока
        InvokeAsync(StateHasChanged);
    }

    // Изменилось состояние соединения
    private void HandleConnectionChanged(bool connected)
    {
        isConnected = connected;
        if (!connected)
        {
            AddSystemMessage("🔌 Отключено от сервера");
        }
        InvokeAsync(StateHasChanged);
    }

    // Произошла ошибка
    private void HandleError(string error)
    {
        errorMessage = error;
        InvokeAsync(StateHasChanged);
    }

    // === Вспомогательные методы ===
    
    private void AddSystemMessage(string text)
    {
        messages.Add(new ChatMessage("Система", text, true));
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendAsync();
    }

    private async Task DisconnectAsync()
    {
        await WsService.DisconnectAsync();
    }

    // === IAsyncDisposable — ОБЯЗАТЕЛЬНО ===
    // Вызывается когда пользователь уходит со страницы
    public async ValueTask DisposeAsync()
    {
        // Отписываемся от событий (предотвращаем утечки памяти)
        WsService.OnMessageReceived -= HandleMessageReceived;
        WsService.OnConnectionChanged -= HandleConnectionChanged;
        WsService.OnError -= HandleError;

        // Закрываем WebSocket
        await WsService.DisposeAsync();
    }

    // === Модель сообщения ===
    private record ChatMessage(
        string Sender, 
        string Text, 
        bool IsSystem)
    {
        public string Time { get; } = DateTime.Now.ToString("HH:mm:ss");
    }
}</code></pre>
                    <div class="code-explanation">
                        <strong>Разбор ключевых концепций Blazor:</strong>
                        <table class="table table-striped table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Директива / Элемент</th>
                                    <th>Что делает</th>

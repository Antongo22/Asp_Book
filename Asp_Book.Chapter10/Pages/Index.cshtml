        Version = "v1",
        Description = "SignalR — реальное время с высокоуровневым API"
    });
});

var app = builder.Build();

app.UseSwagger();
app.UseSwaggerUI();
app.UseStaticFiles();
app.UseRouting();
app.UseAuthorization();

app.MapRazorPages();
app.MapControllers();

// Маппинг SignalR Hub на URL /chathub
app.MapHub&lt;ChatHub&gt;("/chathub");

app.Run();</code></pre>

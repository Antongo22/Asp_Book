@page
@model IndexModel
@{
    ViewData["Title"] = "Глава 12: Тестирование API и EF";
}

<div class="container-fluid">
    <h1 class="mb-4">Глава 12: Тестирование API и EF</h1>

    <ul class="nav nav-tabs mb-4" id="chapterTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="theory-tab" data-bs-toggle="tab" data-bs-target="#theory" type="button" role="tab">
                Теория и Демонстрация
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="answers-tab" data-bs-toggle="tab" data-bs-target="#answers" type="button" role="tab">
                Ответы
            </button>
        </li>
    </ul>

    <div class="tab-content" id="chapterTabsContent">
        <div class="tab-pane fade show active" id="theory" role="tabpanel">
            <h2>Теория</h2>

            <section class="mb-5">
                <h3>Зачем нужно тестирование?</h3>
                <p>Тестирование — важная часть разработки, которая помогает:</p>
                <ul>
                    <li><strong>Находить ошибки</strong> до продакшена</li>
                    <li><strong>Обеспечивать качество</strong> кода</li>
                    <li><strong>Упрощать рефакторинг</strong> — тесты показывают, что ничего не сломалось</li>
                    <li><strong>Документировать</strong> поведение кода</li>
                </ul>
            </section>

            <section class="mb-5">
                <h3>Типы тестов</h3>
                <ul>
                    <li><strong>Unit тесты</strong> — тестирование отдельных компонентов</li>
                    <li><strong>Integration тесты</strong> — тестирование взаимодействия компонентов</li>
                    <li><strong>API тесты</strong> — тестирование HTTP endpoints</li>
                </ul>
            </section>

            <section class="mb-5">
                <h3>In-Memory Database для тестирования</h3>
                <p>Для тестирования EF Core используется In-Memory Database — база данных в памяти, которая не требует реальной БД.</p>
                <ul>
                    <li>Быстрая работа</li>
                    <li>Не требует настройки БД</li>
                    <li>Изолированность тестов</li>
                </ul>
            </section>

            <section class="mb-5">
                <h3>Демонстрация: Чат с тестами</h3>
                <p>Попробуйте использовать чат и посмотрите, как он работает с тестами:</p>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Чат</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <input type="text" id="senderName" class="form-control mb-2" placeholder="Ваше имя" />
                                    <input type="text" id="groupName" class="form-control mb-2" placeholder="Название группы (необязательно)" />
                                    <textarea id="messageText" class="form-control mb-2" rows="3" placeholder="Сообщение"></textarea>
                                    <button class="btn btn-primary" id="sendMessageBtn">Отправить сообщение</button>
                                </div>
                                <div class="mb-3">
                                    <button class="btn btn-success" id="createGroupBtn">Создать группу</button>
                                    <input type="text" id="newGroupName" class="form-control mt-2" placeholder="Название группы" />
                                </div>
                                <div id="chatMessages" class="border rounded p-2" style="height: 200px; overflow-y: auto; background-color: #f8f9fa;">
                                    <p class="text-muted text-center small">Сообщения будут отображаться здесь</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Тестирование</h5>
                            </div>
                            <div class="card-body">
                                <p>В этом проекте реализованы тесты для чата:</p>
                                <ul>
                                    <li><strong>Unit тесты</strong> для ChatService</li>
                                    <li><strong>Integration тесты</strong> для ChatController</li>
                                    <li><strong>In-Memory Database</strong> для изоляции тестов</li>
                                </ul>
                                <div class="alert alert-info">
                                    <strong>Запуск тестов:</strong><br>
                                    <code>dotnet test</code><br>
                                    или в Visual Studio: Test Explorer → Run All Tests
                                </div>
                                <div class="mt-3">
                                    <h6>Примеры тестов:</h6>
                                    <ul class="small">
                                        <li>Отправка сообщения</li>
                                        <li>Получение всех сообщений</li>
                                        <li>Работа с группами</li>
                                        <li>Фильтрация по группе</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-3">
                    <strong>Инструкция:</strong>
                    <ol>
                        <li>Отправьте несколько сообщений через форму</li>
                        <li>Создайте группу и отправьте сообщения в группу</li>
                        <li>Изучите код тестов в папке Tests</li>
                        <li>Запустите тесты командой <code>dotnet test</code></li>
                    </ol>
                </div>
            </section>

            <section class="mb-5">
                <h3>Задача: Написать чат с тестами</h3>
                <div class="alert alert-warning">
                    <h5>Ваша задача:</h5>
                    <p>Изучите реализацию чата с тестами:</p>
                    <ul>
                        <li>Как создать In-Memory базу данных для тестов?</li>
                        <li>Как тестировать контроллеры?</li>
                        <li>Как тестировать сервисы с EF Core?</li>
                    </ul>
                </div>
            </section>
        </div>

        <div class="tab-pane fade" id="answers" role="tabpanel">
            <h2>Решение: Тестирование чата</h2>

            <section class="mb-5">
                <h3>1. Настройка In-Memory Database</h3>
                <div class="code-block">
                    <pre><code>private ChatDbContext GetInMemoryDbContext()
{
    var options = new DbContextOptionsBuilder&lt;ChatDbContext&gt;()
        .UseInMemoryDatabase(databaseName: Guid.NewGuid().ToString())
        .Options;

    return new ChatDbContext(options);
}</code></pre>
                    <div class="code-explanation">
                        <strong>Объяснение:</strong> 
                        <ul>
                            <li><code>UseInMemoryDatabase</code> — создает БД в памяти</li>
                            <li><code>Guid.NewGuid()</code> — уникальное имя для изоляции тестов</li>
                            <li>Каждый тест получает чистую БД</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <h3>2. Тест контроллера</h3>
                <div class="code-block">
                    <pre><code>using Xunit;
using Microsoft.AspNetCore.Mvc;

[Fact]
public async Task SendMessage_ShouldReturnOk()
{
    // Arrange - подготовка
    var context = GetInMemoryDbContext();
    var service = new ChatService(context);
    var controller = new ChatController(service);

    var request = new SendMessageRequest
    {
        Text = "Привет",
        Sender = "User1"
    };

    // Act - выполнение
    var result = await controller.SendMessage(request);

    // Assert - проверка
    var okResult = Assert.IsType&lt;OkObjectResult&gt;(result);
    var message = Assert.IsType&lt;Message&gt;(okResult.Value);
    Assert.Equal("Привет", message.Text);
    Assert.Equal("User1", message.Sender);
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>3. Тест сервиса с EF Core</h3>
                <div class="code-block">
                    <pre><code>[Fact]
public async Task SendMessageAsync_ShouldSaveMessage()
{
    // Arrange
    var context = GetInMemoryDbContext();
    var service = new ChatService(context);

    // Act
    var message = await service.SendMessageAsync("Тест", "User1");

    // Assert
    Assert.NotNull(message);
    Assert.Equal("Тест", message.Text);
    Assert.Equal("User1", message.Sender);
    Assert.True(message.Id > 0);
    
    // Проверка что сообщение сохранено в БД
    var savedMessage = await context.Messages.FindAsync(message.Id);
    Assert.NotNull(savedMessage);
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>4. Тест с несколькими сообщениями</h3>
                <div class="code-block">
                    <pre><code>[Fact]
public async Task GetMessagesAsync_ShouldReturnMessages()
{
    // Arrange
    var context = GetInMemoryDbContext();
    var service = new ChatService(context);

    await service.SendMessageAsync("Сообщение 1", "User1");
    await service.SendMessageAsync("Сообщение 2", "User2");

    // Act
    var messages = await service.GetMessagesAsync();

    // Assert
    Assert.Equal(2, messages.Count);
    Assert.Equal("Сообщение 1", messages[0].Text);
    Assert.Equal("Сообщение 2", messages[1].Text);
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>5. Тест с группами</h3>
                <div class="code-block">
                    <pre><code>[Fact]
public async Task GetMessagesAsync_WithGroupId_ShouldReturnGroupMessages()
{
    // Arrange
    var context = GetInMemoryDbContext();
    var service = new ChatService(context);

    var group = await service.CreateGroupAsync("Группа 1");
    await service.SendMessageAsync("В группе", "User1", group.Id);
    await service.SendMessageAsync("Вне группы", "User2", null);

    // Act
    var groupMessages = await service.GetMessagesAsync(group.Id);
    var allMessages = await service.GetMessagesAsync(null);

    // Assert
    Assert.Single(groupMessages);
    Assert.Equal(2, allMessages.Count);
}</code></pre>
                </div>
            </section>

            <section class="mb-5">
                <h3>6. Запуск тестов</h3>
                <div class="code-block">
                    <pre><code>// В терминале:
dotnet test

// Или в Visual Studio:
// Test Explorer -> Run All Tests</code></pre>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var triggerTabList = [].slice.call(document.querySelectorAll('#chapterTabs button'))
        triggerTabList.forEach(function (triggerEl) {
            var tabTrigger = new bootstrap.Tab(triggerEl)
        })

        const API_URL = '/api/Chat';

        // Загрузка сообщений
        async function loadMessages() {
            try {
                const response = await fetch(`${API_URL}/messages`);
                const messages = await response.json();
                displayMessages(messages);
            } catch (error) {
                console.error('Ошибка загрузки сообщений:', error);
            }
        }

        // Отображение сообщений
        function displayMessages(messages) {
            const messagesArea = document.getElementById('chatMessages');
            if (messages.length === 0) {
                messagesArea.innerHTML = '<p class="text-muted text-center small">Нет сообщений</p>';
                return;
            }

            messagesArea.innerHTML = messages.map(m => `
                <div class="mb-2 p-2 border-bottom">
                    <strong>${m.sender}</strong>${m.groupName ? ` [${m.groupName}]` : ''}<br>
                    <small>${m.text}</small><br>
                    <small class="text-muted">${new Date(m.timestamp).toLocaleString()}</small>
                </div>
            `).join('');
            messagesArea.scrollTop = messagesArea.scrollHeight;
        }

        // Отправка сообщения
        document.getElementById('sendMessageBtn').addEventListener('click', async () => {
            const sender = document.getElementById('senderName').value.trim();
            const text = document.getElementById('messageText').value.trim();
            const groupName = document.getElementById('groupName').value.trim();

            if (!sender || !text) {
                alert('Заполните имя и сообщение');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/send`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sender: sender,
                        text: text,
                        groupId: groupName ? await getGroupId(groupName) : null
                    })
                });

                if (response.ok) {
                    document.getElementById('messageText').value = '';
                    loadMessages();
                } else {
                    const error = await response.json();
                    alert('Ошибка: ' + (error.message || 'Неизвестная ошибка'));
                }
            } catch (error) {
                alert('Ошибка: ' + error.message);
            }
        });

        // Создание группы
        document.getElementById('createGroupBtn').addEventListener('click', async () => {
            const groupName = document.getElementById('newGroupName').value.trim();
            if (!groupName) {
                alert('Введите название группы');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/groups`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: groupName })
                });

                if (response.ok) {
                    const group = await response.json();
                    document.getElementById('newGroupName').value = '';
                    alert(`Группа "${group.name}" создана!`);
                    loadMessages();
                } else {
                    const error = await response.json();
                    alert('Ошибка: ' + (error.message || 'Неизвестная ошибка'));
                }
            } catch (error) {
                alert('Ошибка: ' + error.message);
            }
        });

        // Получение ID группы по имени
        async function getGroupId(groupName) {
            try {
                const response = await fetch(`${API_URL}/groups`);
                const groups = await response.json();
                const group = groups.find(g => g.name === groupName);
                return group ? group.id : null;
            } catch (error) {
                return null;
            }
        }

        // Загрузка сообщений при открытии страницы
        loadMessages();
        setInterval(loadMessages, 3000); // Обновление каждые 3 секунды
    </script>
}
